raw `
BattleFrontier_Lounge2_MapScripts::
	.byte 0

@ This NPC gives hints about a random facility or battle mode.
@ For battle modes he gives generic advice
@ For facilities, depending on how far the player has progressed he will say either
@    The name of the Frontier Brain there
@    The type and description of the 3 pokemon they use in their silver battle
@    The type and description of the 3 pokemon they use in their gold battle
BattleFrontier_Lounge2_EventScript_FrontierManiac::
	lock
	faceplayer
	goto_if_set FLAG_MET_BATTLE_FRONTIER_MANIAC, BattleFrontier_Lounge2_EventScript_AlreadyMetManiac
	setflag FLAG_MET_BATTLE_FRONTIER_MANIAC
	msgbox BattleFrontier_Lounge2_Text_FrontierManiacIntro, MSGBOX_DEFAULT
	goto BattleFrontier_Lounge2_EventScript_GiveAdvice
	end

BattleFrontier_Lounge2_EventScript_AlreadyMetManiac::
	msgbox BattleFrontier_Lounge2_Text_SwingByForTheLatestWord, MSGBOX_DEFAULT
	goto BattleFrontier_Lounge2_EventScript_GiveAdvice
	end

BattleFrontier_Lounge2_EventScript_GiveAdvice::
	call_if_eq VAR_FRONTIER_MANIAC_FACILITY, FRONTIER_MANIAC_TOWER_SINGLES, BattleFrontier_Lounge2_EventScript_BufferSingle
	call_if_eq VAR_FRONTIER_MANIAC_FACILITY, FRONTIER_MANIAC_TOWER_DOUBLES, BattleFrontier_Lounge2_EventScript_BufferDouble
	call_if_eq VAR_FRONTIER_MANIAC_FACILITY, FRONTIER_MANIAC_TOWER_MULTIS, BattleFrontier_Lounge2_EventScript_BufferMulti
	call_if_eq VAR_FRONTIER_MANIAC_FACILITY, FRONTIER_MANIAC_TOWER_LINK, BattleFrontier_Lounge2_EventScript_BufferMultiLink
	call_if_eq VAR_FRONTIER_MANIAC_FACILITY, FRONTIER_MANIAC_DOME, BattleFrontier_Lounge2_EventScript_BufferBattleDome
	call_if_eq VAR_FRONTIER_MANIAC_FACILITY, FRONTIER_MANIAC_FACTORY, BattleFrontier_Lounge2_EventScript_BufferBattleFactory
	call_if_eq VAR_FRONTIER_MANIAC_FACILITY, FRONTIER_MANIAC_PALACE, BattleFrontier_Lounge2_EventScript_BufferBattlePalace
	call_if_eq VAR_FRONTIER_MANIAC_FACILITY, FRONTIER_MANIAC_ARENA, BattleFrontier_Lounge2_EventScript_BufferBattleArena
	call_if_eq VAR_FRONTIER_MANIAC_FACILITY, FRONTIER_MANIAC_PIKE, BattleFrontier_Lounge2_EventScript_BufferBattlePike
	call_if_eq VAR_FRONTIER_MANIAC_FACILITY, FRONTIER_MANIAC_PYRAMID, BattleFrontier_Lounge2_EventScript_BufferBattlePyramid
@ <= FRONTIER_MANIAC_TOWER_LINK is any Battle Tower mode
	call_if_le VAR_FRONTIER_MANIAC_FACILITY, FRONTIER_MANIAC_TOWER_LINK, BattleFrontier_Lounge2_EventScript_BattleTowerNews
@ >= FRONTIER_MANIAC_DOME is any facility other than Battle Tower
	call_if_ge VAR_FRONTIER_MANIAC_FACILITY, FRONTIER_MANIAC_DOME, BattleFrontier_Lounge2_EventScript_FacilityNews
	special ShowFrontierManiacMessage
	waitmessage
	waitbuttonpress
	release
	end

BattleFrontier_Lounge2_EventScript_BattleTowerNews::
	msgbox BattleFrontier_Lounge2_Text_BattleTowerIsHottest, MSGBOX_DEFAULT
	return

BattleFrontier_Lounge2_EventScript_FacilityNews::
	msgbox BattleFrontier_Lounge2_Text_FacilityIsHottest, MSGBOX_DEFAULT
	return

BattleFrontier_Lounge2_EventScript_BufferSingle::
	bufferstdstring STR_VAR_1, STDSTRING_SINGLE
	return

BattleFrontier_Lounge2_EventScript_BufferDouble::
	bufferstdstring STR_VAR_1, STDSTRING_DOUBLE
	return

BattleFrontier_Lounge2_EventScript_BufferMulti::
	bufferstdstring STR_VAR_1, STDSTRING_MULTI
	return

BattleFrontier_Lounge2_EventScript_BufferMultiLink::
	bufferstdstring STR_VAR_1, STDSTRING_MULTI_LINK
	return

BattleFrontier_Lounge2_EventScript_BufferBattleDome::
	bufferstdstring STR_VAR_1, STDSTRING_BATTLE_DOME
	return

BattleFrontier_Lounge2_EventScript_BufferBattleFactory::
	bufferstdstring STR_VAR_1, STDSTRING_BATTLE_FACTORY
	return

BattleFrontier_Lounge2_EventScript_BufferBattlePalace::
	bufferstdstring STR_VAR_1, STDSTRING_BATTLE_PALACE
	return

BattleFrontier_Lounge2_EventScript_BufferBattleArena::
	bufferstdstring STR_VAR_1, STDSTRING_BATTLE_ARENA
	return

BattleFrontier_Lounge2_EventScript_BufferBattlePike::
	bufferstdstring STR_VAR_1, STDSTRING_BATTLE_PIKE
	return

BattleFrontier_Lounge2_EventScript_BufferBattlePyramid::
	bufferstdstring STR_VAR_1, STDSTRING_BATTLE_PYRAMID
	return

BattleFrontier_Lounge2_EventScript_Maniac1::
	lock
	msgbox BattleFrontier_Lounge2_Text_NewsGatheringPower, MSGBOX_DEFAULT
	release
	end

BattleFrontier_Lounge2_EventScript_Maniac2::
	lock
	msgbox BattleFrontier_Lounge2_Text_AmazingPowersOfObservation, MSGBOX_DEFAULT
	release
	end

BattleFrontier_Lounge2_EventScript_Maniac3::
	lock
	msgbox BattleFrontier_Lounge2_Text_AmazingPowerOfPersuasion, MSGBOX_DEFAULT
	release
	end

BattleFrontier_Lounge2_EventScript_TriathleteF::
	msgbox BattleFrontier_Lounge2_Text_ThisPlaceIsScaringMe, MSGBOX_NPC
	end

BattleFrontier_Lounge2_Text_FrontierManiacIntro::
	.string "你好！说到对战开拓区\n"
	.string "的消息，我是头号。\p"
	.string "你可以把我当成\n"
	.string "开拓区狂热者。\p"
	.string "先确认一下，你是训练家\n"
	.string "吧？\p"
	.string "我很乐意分享我收集到的\n"
	.string "对战开拓区最新消息。$"

BattleFrontier_Lounge2_Text_SwingByForTheLatestWord::
	.string "你好！你是来问我\n"
	.string "最新消息的吧？哦，好吧！$"

@ Unused
BattleFrontier_Lounge2_Text_MyInformationsBeenUsefulRight::
	.string "怎么样？怎么样？怎么样？\p"
	.string "我的情报对你一定\n"
	.string "很有用吧？$"

BattleFrontier_Lounge2_Text_FacilityIsHottest::
	.string "让我看看……\p"
	.string "听说{STR_VAR_1}是\n"
	.string "现在最热门的地方。$"

BattleFrontier_Lounge2_Text_BattleTowerIsHottest::
	.string "让我看看……\p"
	.string "听说对战塔{STR_VAR_1}\n"
	.string "是最热门的。$"

BattleFrontier_Lounge2_Text_SalonMaidenIsThere::
	.string "这个你一定不知道！\p"
	.string "史考特称为开拓区大脑的\n"
	.string "顶尖训练家之一就在那儿。\p"
	.string "就是那位管理那里的、\n"
	.string "叫沙龙大姐姐的神秘训练家。$"

BattleFrontier_Lounge2_Text_SalonMaidenSilverMons::
	.string "你和沙龙大姐姐对战过吗？\p"
	.string "她试探对手实力时，\n"
	.string "好像会用这些宝可梦：\p"
	.string "超能力属性的念力宝可梦、\n"
	.string "火属性的火山宝可梦，\l"
	.string "还有一般属性的贪睡宝可梦。$"

BattleFrontier_Lounge2_Text_SalonMaidenGoldMons::
	.string "你和她认真时对战过吗？\p"
	.string "她全力出战时，\n"
	.string "好像会用这些宝可梦：\p"
	.string "龙与超能力属性的无限宝可梦、\n"
	.string "电属性的天雷宝可梦，\l"
	.string "还有一般属性的贪睡宝可梦。$"

BattleFrontier_Lounge2_Text_DomeAceIsThere::
	.string "这个你一定不知道！\p"
	.string "史考特称为开拓区大脑的\n"
	.string "顶尖训练家之一就在那儿。\p"
	.string "就是那位管理那里的、\n"
	.string "华丽张扬的巨蛋之星。$"

BattleFrontier_Lounge2_Text_DomeAceSilverMons::
	.string "你和巨蛋之星对战过吗？\p"
	.string "他没太把对手当回事时，\n"
	.string "会用这三只宝可梦：\p"
	.string "龙与飞行属性的龙宝可梦、\n"
	.string "水与地面属性的泥鱼宝可梦，\l"
	.string "还有火与飞行属性的火焰宝可梦。$"

BattleFrontier_Lounge2_Text_DomeAceGoldMons::
	.string "你和认真时的巨蛋之星\n"
	.string "对战过吗？\p"
	.string "他展示自己战略时，\n"
	.string "会用这三只宝可梦：\p"
	.string "龙与飞行属性的无限宝可梦、\n"
	.string "水与地面属性的泥鱼宝可梦，\l"
	.string "还有钢与超能力属性的\l"
	.string "铁足宝可梦。$"

BattleFrontier_Lounge2_Text_FactoryHeadIsThere::
	.string "这个你一定不知道！\p"
	.string "史考特称为开拓区大脑的\n"
	.string "顶尖训练家之一就在那儿。\p"
	.string "就是那位管理那里的、\n"
	.string "怪得出奇的工厂头目。$"

BattleFrontier_Lounge2_Text_FactoryHeadSilverMons::
	.string "你对战工厂头目对战过了吗？\p"
	.string "我想想……他对战时，\n"
	.string "只拿三只租借宝可梦。\p"
	.string "他几乎和你处于同样的\n"
	.string "条件在对战。$"

BattleFrontier_Lounge2_Text_FactoryHeadGoldMons::
	.string "你和认真时的对战工厂头目\n"
	.string "对战过了吗？\p"
	.string "他认真去对战时，\n"
	.string "还是拿三只租借宝可梦。\p"
	.string "他几乎和你处于同样的\n"
	.string "条件在对战。$"

BattleFrontier_Lounge2_Text_PikeQueenIsThere::
	.string "这个你一定不知道！\p"
	.string "史考特称为开拓区大脑的\n"
	.string "顶尖训练家之一就在那儿。\p"
	.string "就是那位管理那里的、\n"
	.string "吓人的管道女王。$"

BattleFrontier_Lounge2_Text_PikeQueenSilverMons::
	.string "你和管道女王对战过吗？\p"
	.string "听说她心情好时，\n"
	.string "会用这三只宝可梦：\p"
	.string "毒属性的牙蛇宝可梦、\n"
	.string "虫与岩石属性的霉菌宝可梦，\l"
	.string "还有水属性的温柔宝可梦。$"

BattleFrontier_Lounge2_Text_PikeQueenGoldMons::
	.string "你和认真时的管道女王\n"
	.string "对战过吗？\p"
	.string "听说她真被惹恼时，\n"
	.string "会用这三只宝可梦：\p"
	.string "毒属性的牙蛇宝可梦、\n"
	.string "钢与地面属性的铁蛇宝可梦，\l"
	.string "还有水与飞行属性的\l"
	.string "凶恶宝可梦。$"

BattleFrontier_Lounge2_Text_ArenaTycoonIsThere::
	.string "这个你一定不知道！\p"
	.string "史考特称为开拓区大脑的\n"
	.string "顶尖训练家之一就在那儿。\p"
	.string "就是那位管理那里的、\n"
	.string "可爱的竞技场大君。$"

BattleFrontier_Lounge2_Text_ArenaTycoonSilverMons::
	.string "你和竞技场大君对战过吗？\p"
	.string "她试探对手实力时，\n"
	.string "据说会用这些宝可梦：\p"
	.string "虫与格斗属性的独角宝可梦、\n"
	.string "恶属性的月光宝可梦，\l"
	.string "还有虫与幽灵属性的脱壳宝可梦。$"

BattleFrontier_Lounge2_Text_ArenaTycoonGoldMons::
	.string "你和认真时的竞技场大君\n"
	.string "对战过吗？\p"
	.string "她认真对战时，\n"
	.string "据说会用这些宝可梦：\p"
	.string "恶属性的月光宝可梦、\n"
	.string "幽灵与毒属性的影子宝可梦，\l"
	.string "还有草与格斗属性的\l"
	.string "蘑菇宝可梦。$"

BattleFrontier_Lounge2_Text_PalaceMavenIsThere::
	.string "这个你一定不知道！\p"
	.string "史考特称为开拓区大脑的\n"
	.string "顶尖训练家之一就在那儿。\p"
	.string "就是那位管理那里的、\n"
	.string "阴森的宫殿大君。$"

BattleFrontier_Lounge2_Text_PalaceMavenSilverMons::
	.string "你和宫殿大君对战过吗？\p"
	.string "他试探对手心志时，\n"
	.string "据说会用这些宝可梦：\p"
	.string "毒与飞行属性的蝙蝠宝可梦、\n"
	.string "一般属性的懒惰宝可梦，\l"
	.string "还有水与冰属性的运输宝可梦。$"

BattleFrontier_Lounge2_Text_PalaceMavenGoldMons::
	.string "你和认真时的宫殿大君\n"
	.string "对战过吗？\p"
	.string "他把全部力量投入对战时，\n"
	.string "据说会用这些宝可梦：\p"
	.string "火属性的传说宝可梦、\n"
	.string "一般属性的懒惰宝可梦，\l"
	.string "还有水属性的极光宝可梦。$"

BattleFrontier_Lounge2_Text_PyramidKingIsThere::
	.string "这个你一定不知道！\p"
	.string "史考特称为开拓区大脑的\n"
	.string "顶尖训练家之一就在那儿。\p"
	.string "就是那位管理那里的、\n"
	.string "火热无比的金字塔之王。$"

BattleFrontier_Lounge2_Text_PyramidKingSilverMons::
	.string "你和金字塔之王对战过吗？\p"
	.string "他试探对手力量时，\n"
	.string "好像会用这些宝可梦：\p"
	.string "岩石属性的岩峰宝可梦、\n"
	.string "冰属性的冰山宝可梦，\l"
	.string "还有钢属性的铁宝可梦。$"

BattleFrontier_Lounge2_Text_PyramidKingGoldMons::
	.string "你和认真时的金字塔之王\n"
	.string "对战过吗？\p"
	.string "他热血沸腾时，\n"
	.string "好像会用这些宝可梦：\p"
	.string "冰与飞行属性的冰冻宝可梦、\n"
	.string "电与飞行属性的电气宝可梦，\l"
	.string "还有火与飞行属性的\l"
	.string "火焰宝可梦。$"

BattleFrontier_Lounge2_Text_DoubleBattleAdvice1::
	.string "当然，有好几个地方\n"
	.string "可以参加双打对战。\p"
	.string "但对战塔的双打对战房间\n"
	.string "算是基础！\p"
	.string "你该在那里学习对战开拓区\n"
	.string "的双打对战怎么打。$"

BattleFrontier_Lounge2_Text_DoubleBattleAdvice2::
	.string "在这儿对战时小心点。\p"
	.string "我听说有些训练家的战略\n"
	.string "是专门为双打对战\l"
	.string "开发的。$"

BattleFrontier_Lounge2_Text_DoubleBattleAdvice3::
	.string "等你对这里的双打对战\n"
	.string "有自信、也习惯了，\l"
	.string "就该考虑去挑战其他\l"
	.string "有双打对战的地方。$"

BattleFrontier_Lounge2_Text_MultiBattleAdvice::
	.string "各种训练家都会聚集在\n"
	.string "对战沙龙。\p"
	.string "想想看——你可能会碰上\n"
	.string "你的朋友或追随者！\l"
	.string "你该仔细看看！$"

BattleFrontier_Lounge2_Text_LinkMultiBattleAdvice::
	.string "要是你和朋友一起，\n"
	.string "就去联机多人对战房间。\p"
	.string "要是你和强朋友一起玩，\n"
	.string "可以想见会碰到强对手！$"

BattleFrontier_Lounge2_Text_NewsGatheringPower::
	.string "多么惊人的情报收集能力！\n"
	.string "我的师父无人能比！$"

BattleFrontier_Lounge2_Text_AmazingPowersOfObservation::
	.string "多么惊人的观察力！\n"
	.string "我的师父无人能比！$"

BattleFrontier_Lounge2_Text_AmazingPowerOfPersuasion::
	.string "多么惊人的说服力！\n"
	.string "我的师父无人能比！$"

BattleFrontier_Lounge2_Text_ThisPlaceIsScaringMe::
	.string "……这是什么地方？\n"
	.string "让我好害怕……$"

`
