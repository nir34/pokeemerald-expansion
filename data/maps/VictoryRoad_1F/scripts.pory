raw `
.set LOCALID_WALLY_ENTRANCE, 4

VictoryRoad_1F_MapScripts::
	map_script MAP_SCRIPT_ON_TRANSITION, VictoryRoad_1F_OnTransition
	.byte 0

VictoryRoad_1F_OnTransition:
	call_if_eq VAR_VICTORY_ROAD_1F_STATE, 1, VictoryRoad_1F_EventScript_SetEntranceWallyPos1
	call_if_eq VAR_VICTORY_ROAD_1F_STATE, 2, VictoryRoad_1F_EventScript_SetEntranceWallyPos2
	end

VictoryRoad_1F_EventScript_SetEntranceWallyPos1::
	setobjectxyperm LOCALID_WALLY_ENTRANCE, 2, 24
	setobjectmovementtype LOCALID_WALLY_ENTRANCE, MOVEMENT_TYPE_FACE_DOWN
	return

VictoryRoad_1F_EventScript_SetEntranceWallyPos2::
	setobjectxyperm LOCALID_WALLY_ENTRANCE, 3, 24
	setobjectmovementtype LOCALID_WALLY_ENTRANCE, MOVEMENT_TYPE_FACE_DOWN
	return

VictoryRoad_1F_EventScript_WallyBattleTrigger1::
	lockall
	playbgm MUS_ENCOUNTER_BRENDAN, FALSE
	setvar VAR_0x8008, 1
	addobject LOCALID_WALLY_ENTRANCE
	applymovement LOCALID_WALLY_ENTRANCE, VictoryRoad_1F_Movement_WallyApproachPlayer1
	waitmovement 0
	goto VictoryRoad_1F_EventScript_WallyEntranceBattle
	end

VictoryRoad_1F_EventScript_WallyBattleTrigger2::
	lockall
	playbgm MUS_ENCOUNTER_BRENDAN, FALSE
	setvar VAR_0x8008, 2
	addobject LOCALID_WALLY_ENTRANCE
	applymovement LOCALID_WALLY_ENTRANCE, VictoryRoad_1F_Movement_WallyApproachPlayer2
	waitmovement 0
	goto VictoryRoad_1F_EventScript_WallyEntranceBattle
	end

VictoryRoad_1F_EventScript_WallyEntranceBattle::
	applymovement OBJ_EVENT_ID_PLAYER, Common_Movement_WalkInPlaceFasterDown
	waitmovement 0
	msgbox VictoryRoad_1F_Text_WallyNotGoingToLoseAnymore, MSGBOX_DEFAULT
	trainerbattle_no_intro TRAINER_WALLY_VR_1, VictoryRoad_1F_Text_WallyEntranceDefeat
	msgbox VictoryRoad_1F_Text_WallyGiftFromDad, MSGBOX_DEFAULT
	giveitem ITEM_SLAKITE
	giveitem ITEM_TYRANITARITE
	giveitem ITEM_SALAMENCITE
	giveitem ITEM_GARCHOMPITE
	giveitem ITEM_METAGROSSITE
	msgbox VictoryRoad_1F_Text_WallyTicketsFromDad, MSGBOX_DEFAULT
	giveitem ITEM_EON_TICKET
	giveitem ITEM_AURORA_TICKET
	setflag FLAG_ENABLE_SHIP_BIRTH_ISLAND
	setflag FLAG_ENABLE_SHIP_SOUTHERN_ISLAND
	msgbox VictoryRoad_1F_Text_WallyPostEntranceBattle, MSGBOX_DEFAULT
	closemessage
	clearflag FLAG_HIDE_VICTORY_ROAD_ENTRANCE_WALLY
	copyobjectxytoperm LOCALID_WALLY_ENTRANCE
	setflag FLAG_DEFEATED_WALLY_VICTORY_ROAD
	clearflag FLAG_HIDE_LILYCOVE_HARBOR_SSTIDAL
	copyvar VAR_VICTORY_ROAD_1F_STATE, VAR_0x8008
	delay 30
	playfanfare MUS_LEVEL_UP
	specialvar VAR_0x8006, GetLevelCapForText
	buffernumberstring STR_VAR_3, VAR_0x8006
	msgbox LevelCapIncreasedTo, MSGBOX_DEFAULT
	waitfanfare
	closemessage
	delay 30
	releaseall
	end

VictoryRoad_1F_Movement_WallyApproachPlayer1:
	walk_left
	walk_left
	walk_left
	walk_left
	walk_left
	walk_left
	walk_left
	walk_left
	walk_left
	walk_left
	walk_up
	step_end

VictoryRoad_1F_Movement_WallyApproachPlayer2:
	walk_left
	walk_left
	walk_left
	walk_left
	walk_left
	walk_left
	walk_left
	walk_left
	walk_left
	walk_up
	step_end

@ This Wally appears near the entrance once his battle is triggered and remains there until the Hall of Fame is entered
VictoryRoad_1F_EventScript_EntranceWally::
	msgbox VictoryRoad_1F_Text_WallyPostEntranceBattle, MSGBOX_NPC
	end

@ This Wally appears and remains at the exit after the Hall of Fame is entered
VictoryRoad_1F_EventScript_ExitWally::
	trainerbattle_single TRAINER_WALLY_VR_2, VictoryRoad_1F_Text_WallyIntro, VictoryRoad_1F_Text_WallyDefeat
	specialvar VAR_RESULT, ShouldTryRematchBattle
	goto_if_eq VAR_RESULT, TRUE, VictoryRoad_1F_EventScript_RematchWally
	msgbox VictoryRoad_1F_Text_WallyPostBattle, MSGBOX_AUTOCLOSE
	end

VictoryRoad_1F_EventScript_RematchWally::
	trainerbattle_rematch TRAINER_WALLY_VR_2, VictoryRoad_1F_Text_WallyIntro, VictoryRoad_1F_Text_WallyDefeat
	msgbox VictoryRoad_1F_Text_WallyPostBattle, MSGBOX_AUTOCLOSE
	end

VictoryRoad_1F_EventScript_Edgar::
	trainerbattle_single TRAINER_EDGAR, VictoryRoad_1F_Text_EdgarIntro, VictoryRoad_1F_Text_EdgarDefeat
	msgbox VictoryRoad_1F_Text_EdgarPostBattle, MSGBOX_AUTOCLOSE
	end

VictoryRoad_1F_EventScript_Albert::
	trainerbattle_single TRAINER_ALBERT, VictoryRoad_1F_Text_AlbertIntro, VictoryRoad_1F_Text_AlbertDefeat
	msgbox VictoryRoad_1F_Text_AlbertPostBattle, MSGBOX_AUTOCLOSE
	end

VictoryRoad_1F_EventScript_Hope::
	trainerbattle_single TRAINER_HOPE, VictoryRoad_1F_Text_HopeIntro, VictoryRoad_1F_Text_HopeDefeat
	msgbox VictoryRoad_1F_Text_HopePostBattle, MSGBOX_AUTOCLOSE
	end

VictoryRoad_1F_EventScript_Quincy::
	trainerbattle_single TRAINER_QUINCY, VictoryRoad_1F_Text_QuincyIntro, VictoryRoad_1F_Text_QuincyDefeat
	msgbox VictoryRoad_1F_Text_QuincyPostBattle, MSGBOX_AUTOCLOSE
	end

VictoryRoad_1F_EventScript_Katelynn::
	trainerbattle_single TRAINER_KATELYNN, VictoryRoad_1F_Text_KatelynnIntro, VictoryRoad_1F_Text_KatelynnDefeat
	msgbox VictoryRoad_1F_Text_KatelynnPostBattle, MSGBOX_AUTOCLOSE
	end

VictoryRoad_1F_Text_WallyNotGoingToLoseAnymore:
	.string "{PLAYER}！你来了！我一直\n"
	.string "在这儿四处转着多训练，\l"
	.string "就知道你早晚\l"
	.string "会出现。\p"
	.string "在紫堇和110号道路\n"
	.string "被你打败后，我才\l"
	.string "明白自己多弱，\l"
	.string "对宝可梦了解\l"
	.string "多浅……\p"
	.string "从那以后，我变得强了\n"
	.string "好多。\p"
	.string "我拼命训练，希望有一天\n"
	.string "打败你，甚至把丰缘\l"
	.string "所有道馆馆主都\l"
	.string "打赢了！\p"
	.string "可是，去宝可梦联盟\n"
	.string "之前，我还有一个\l"
	.string "目标……\p"
	.string "我必须打败你！\n"
	.string "{PLAYER}！\p"
	.string "是你激励我变强的，\n"
	.string "现在就让你看看\l"
	.string "我努力的结果！$"

VictoryRoad_1F_Text_WallyEntranceDefeat:
	.string "我练了这么久，还是\n"
	.string "不够……可我\l"
	.string "不会放弃！我会\l"
	.string "一直练到能打赢你！$"

VictoryRoad_1F_Text_WallyPostEntranceBattle:
	.string "这次我也没能\n"
	.string "打赢你……\p"
	.string "可总有一天，{PLAYER}，\n"
	.string "我会追上你。\p"
	.string "然后去挑战宝可梦\n"
	.string "联盟！$"

VictoryRoad_1F_Text_WallyGiftFromDad:
	.string "这一战真棒，不过我还\n"
	.string "明显有很多要学……\p"
	.string "哦！我刚想起来，你爸爸\n"
	.string "托我带了个包裹，\l"
	.string "里面有些东西给你，\l"
	.string "{PLAYER}。\p"
	.string "他说很抱歉在你打败他\n"
	.string "的时候没准备好那颗\l"
	.string "超级石，所以加了\l"
	.string "几样东西补偿。\p"
	.string "给你，{PLAYER}。$"

VictoryRoad_1F_Text_WallyTicketsFromDad:
	.string "哦我差点忘了，他还\n"
	.string "让我把这个也给你。\p"
	.string "我不确定这些票会带你\n"
	.string "去哪儿，不过你爸说\l"
	.string "你可以去水静市的港口\l"
	.string "用这些票。$"

VictoryRoad_1F_Text_WallyIntro:
	.string "嗨！{PLAYER}！\p"
	.string "上次之后我变强了！\n"
	.string "我想让你看看，\l"
	.string "{PLAYER}！\p"
	.string "好……我来了！$"

VictoryRoad_1F_Text_WallyDefeat:
	.string "哇！\n"
	.string "{PLAYER}，你果然很强！$"

VictoryRoad_1F_Text_WallyPostBattle:
	.string "这次我也没能\n"
	.string "打赢你……可总有一天，\l"
	.string "{PLAYER}，我会追上你……\p"
	.string "然后去挑战宝可梦\n"
	.string "联盟！$"

VictoryRoad_1F_Text_EdgarIntro:
	.string "我到这里已经两次了，\n"
	.string "可最后那段路\l"
	.string "太长了……$"

VictoryRoad_1F_Text_EdgarDefeat:
	.string "我的梦想又在这里\n"
	.string "结束了……$"

VictoryRoad_1F_Text_EdgarPostBattle:
	.string "你都走到这儿了。保持\n"
	.string "这股劲，成为\l"
	.string "冠军吧！要是有人\l"
	.string "行，那就是你！$"

VictoryRoad_1F_Text_AlbertIntro:
	.string "我大老远来，可不是\n"
	.string "为了现在输。那种\l"
	.string "可能不存在！$"

VictoryRoad_1F_Text_AlbertDefeat:
	.string "不可能……\n"
	.string "我输了？$"

VictoryRoad_1F_Text_AlbertPostBattle:
	.string "我在这里输了……\p"
	.string "这说明我缺少成为\n"
	.string "冠军的资格……$"

VictoryRoad_1F_Text_HopeIntro:
	.string "这条看起来无尽又艰辛\n"
	.string "的路，真配得上\l"
	.string "“胜利”之名。$"

VictoryRoad_1F_Text_HopeDefeat:
	.string "你的战斗方式\n"
	.string "真了不起……$"

VictoryRoad_1F_Text_HopePostBattle:
	.string "你好像有成为\n"
	.string "冠军的潜力。$"

VictoryRoad_1F_Text_QuincyIntro:
	.string "冠军之路是什么？\n"
	.string "你赢了我就告诉你！$"

VictoryRoad_1F_Text_QuincyDefeat:
	.string "好！\n"
	.string "干得好！$"

VictoryRoad_1F_Text_QuincyPostBattle:
	.string "平安通过这里——\n"
	.string "这就是对所有想成为\l"
	.string "宝可梦冠军的训练家\l"
	.string "的最后考验。\p"
	.string "所以它才叫\n"
	.string "冠军之路。$"

VictoryRoad_1F_Text_KatelynnIntro:
	.string "对走到这里的人，\n"
	.string "我没什么好说的。\l"
	.string "来吧！$"

VictoryRoad_1F_Text_KatelynnDefeat:
	.string "真丢脸……$"

VictoryRoad_1F_Text_KatelynnPostBattle:
	.string "哼，你尽管往前走吧。\n"
	.string "我才不在乎。$"
`


script VictoryRoad_1F_EventScript_PowerfulMonSummoner {
	lock
	faceplayer
	if(flag(FLAG_TEMP_1))
	{
		msgbox(VictoryRoad_1F_Text_SummonerIntroQuick, MSGBOX_YESNO)	
	}
	else
	{
		msgbox(VictoryRoad_1F_Text_SummonerIntro, MSGBOX_YESNO)
	}

	setflag(FLAG_TEMP_1)

	if(var(VAR_RESULT) == NO)
	{
		goto(VictoryRoad_1F_EventScript_SummonWomanManNo)
	}

	goto(VictoryRoad_1F_EventScript_ChooseRoom)
	release
	end
}

script VictoryRoad_1F_EventScript_ChooseRoom {
	msgbox(VictoryRoad_1F_Text_WhichRoom, MSGBOX_DEFAULT)

	dynmultipush("入口房间", 0)
	dynmultipush("内部房间", 1)
	dynmultipush("楼梯房间", 2)
    dynmultipush("取消", MULTI_B_PRESSED)

	//.macro dynmultistack left:req, top:req, ignoreBPress:req, maxBeforeScroll:req, shouldSort:req, initialSelected:req, callbacks:req
    // // setting initial selected to a non-existant ID will always have it point to the first option
	dynmultistack(0, 0, FALSE, 6, FALSE, 0, DYN_MULTICHOICE_CB_NONE)

	if (var(VAR_RESULT) == MULTI_B_PRESSED)
	{
		goto(VictoryRoad_1F_EventScript_SummonWomanManNo)
	}

	if (var(VAR_RESULT) == 0)
	{
		goto(VictoryRoad_1F_EventScript_EntranceRoom)
	}
	if (var(VAR_RESULT) == 1)
	{
		goto(VictoryRoad_1F_EventScript_InnerRoom)
	}
	if (var(VAR_RESULT) == 2)
	{
		goto(VictoryRoad_1F_EventScript_StairsRoom)
	}

	release
	end
}

script VictoryRoad_1F_EventScript_EntranceRoom {
	msgbox(VictoryRoad_1F_Text_WhichPokemon, MSGBOX_DEFAULT)

	dynmultipush("雄伟牙",   SPECIES_GREAT_TUSK)
	dynmultipush("吼叫尾",  SPECIES_SCREAM_TAIL)
	dynmultipush("猛恶菇", SPECIES_BRUTE_BONNET)
	dynmultipush("振翼发", SPECIES_FLUTTER_MANE)
	dynmultipush("爬地翅", SPECIES_SLITHER_WING)
	dynmultipush("沙铁皮", SPECIES_SANDY_SHOCKS)
	dynmultipush("轰鸣月", SPECIES_ROARING_MOON)
	dynmultipush("波荡水", SPECIES_WALKING_WAKE)
	dynmultipush("破空焰", SPECIES_GOUGING_FIRE)
	dynmultipush("猛雷鼓",  SPECIES_RAGING_BOLT)
    dynmultipush("返回", MULTI_B_PRESSED)

	//.macro dynmultistack left:req, top:req, ignoreBPress:req, maxBeforeScroll:req, shouldSort:req, initialSelected:req, callbacks:req
    // // setting initial selected to a non-existant ID will always have it point to the first option
	dynmultistack(0, 0, FALSE, 6, FALSE, SPECIES_GREAT_TUSK, DYN_MULTICHOICE_CB_NONE)

	if (var(VAR_RESULT) == MULTI_B_PRESSED) 
	{
		goto(VictoryRoad_1F_EventScript_ChooseRoom)
	}

	goto(VictoryRoad_1F_EventScript_ConfirmAndUseSummon)

	release
	end

}

script VictoryRoad_1F_EventScript_InnerRoom {
	msgbox(VictoryRoad_1F_Text_WhichPokemon, MSGBOX_DEFAULT)

	dynmultipush("铁辙迹",   SPECIES_IRON_TREADS)
	dynmultipush("铁包袱",   SPECIES_IRON_BUNDLE)
	dynmultipush("铁臂膀",    SPECIES_IRON_HANDS)
	dynmultipush("铁脖颈",  SPECIES_IRON_JUGULIS)
	dynmultipush("铁毒蛾",     SPECIES_IRON_MOTH)
	dynmultipush("铁荆棘",   SPECIES_IRON_THORNS)
	dynmultipush("铁武者",  SPECIES_IRON_VALIANT)
	dynmultipush("铁叶",   SPECIES_IRON_LEAVES)
	dynmultipush("铁磐岩",  SPECIES_IRON_BOULDER)
	dynmultipush("铁头壳",    SPECIES_IRON_CROWN)
    dynmultipush("返回", MULTI_B_PRESSED)

	//.macro dynmultistack left:req, top:req, ignoreBPress:req, maxBeforeScroll:req, shouldSort:req, initialSelected:req, callbacks:req
    // // setting initial selected to a non-existant ID will always have it point to the first option
	dynmultistack(0, 0, FALSE, 6, FALSE, SPECIES_IRON_TREADS, DYN_MULTICHOICE_CB_NONE)

	if (var(VAR_RESULT) == MULTI_B_PRESSED) 
	{
		goto(VictoryRoad_1F_EventScript_ChooseRoom)
	}

	goto(VictoryRoad_1F_EventScript_ConfirmAndUseSummon)

	release
	end

}

script VictoryRoad_1F_EventScript_StairsRoom {
	msgbox(VictoryRoad_1F_Text_WhichPokemon, MSGBOX_DEFAULT)

	dynmultipush("虚吾伊德",    SPECIES_NIHILEGO)
	dynmultipush("恶食大王",    SPECIES_GUZZLORD)
	dynmultipush("电束木",   SPECIES_XURKITREE)
	dynmultipush("爆肌蚊",    SPECIES_BUZZWOLE)
	dynmultipush("砰头小丑", SPECIES_BLACEPHALON)
	dynmultipush("垒磊石",   SPECIES_STAKATAKA)
	dynmultipush("毒贝比",     SPECIES_POIPOLE)
	dynmultipush("费洛美螂",   SPECIES_PHEROMOSA)
	dynmultipush("铁火辉夜",  SPECIES_CELESTEELA)
	dynmultipush("纸御剑",     SPECIES_KARTANA)
    dynmultipush("返回", MULTI_B_PRESSED)

	//.macro dynmultistack left:req, top:req, ignoreBPress:req, maxBeforeScroll:req, shouldSort:req, initialSelected:req, callbacks:req
    // // setting initial selected to a non-existant ID will always have it point to the first option
	dynmultistack(0, 0, FALSE, 6, FALSE, SPECIES_NIHILEGO, DYN_MULTICHOICE_CB_NONE)

	if (var(VAR_RESULT) == MULTI_B_PRESSED) 
	{
		goto(VictoryRoad_1F_EventScript_ChooseRoom)
	}

	goto(VictoryRoad_1F_EventScript_ConfirmAndUseSummon)

	release
	end

}


script VictoryRoad_1F_EventScript_ConfirmAndUseSummon {
	copyvar(VAR_0x8005, VAR_RESULT)
	bufferspeciesname(STR_VAR_1, VAR_0x8005)
	msgbox(VictoryRoad_1F_Text_ConfirmSummon, MSGBOX_YESNO)

	if(var(VAR_RESULT) == NO)
	{
		goto(VictoryRoad_1F_EventScript_SummonWomanManNo)
	}

	msgbox(VictoryRoad_1F_Text_VeryWell, MSGBOX_DEFAULT)
	delay(30)

	setwildbattle(VAR_0x8005, 50)
	waitse
	playmoncry(VAR_0x8005, CRY_MODE_ENCOUNTER)
	delay(40)
	waitmoncry
	dowildbattle
	release
	end
}

script VictoryRoad_1F_EventScript_SummonWomanManNo
{
    msgbox(VictoryRoad_1F_SummonWomanDeclined, MSGBOX_DEFAULT)
    release
    end
}

 
text VictoryRoad_1F_Text_SummonerIntro {
	"你好，年轻的训练家。\p"
	"我来到这个偏僻的地方，\n"
	"是因为学会了一门强力的\l"
	"技艺，能从这洞穴里几乎\l"
	"遥远之处的宝可梦。\p"
	"要我把一只宝可梦召唤\n"
	"到这儿来和你对战吗？"
}

text VictoryRoad_1F_Text_SummonerIntroQuick {
	"要我把一只宝可梦召唤\n"
	"到这儿来和你对战吗？"
}

text VictoryRoad_1F_Text_WhichRoom {
	"你想让我从哪个房间\n"
	"召唤宝可梦？"
}

text VictoryRoad_1F_Text_WhichPokemon {
	"你想让我召唤哪只\n"
	"宝可梦和你对战？"
}

text VictoryRoad_1F_Text_ConfirmSummon {
	"那么，你想让我召唤一只\n"
	"{STR_VAR_1}来和你对战吗？"
}

text VictoryRoad_1F_Text_VeryWell {
	"很好，做好对战的准备吧。"
}

text VictoryRoad_1F_SummonWomanDeclined
{
	"我明白了。若你改变主意，\n"
	"就告诉我。"
}