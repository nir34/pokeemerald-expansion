	end
}

script SootopolisCity_ChampHouse_EventScript_BattleBefools{
	msgbox(Befools_YoureOn, MSGBOX_DEFAULT)
	trainerbattle_no_intro(TRAINER_BEFOOLS, Befools_Outro)
