script Route111_Trigger_BlockTrainerHillEntrance{
	lockall
	msgbox(TrainerHillDev)
	applymovement(OBJ_EVENT_ID_PLAYER, StopPlayer)
	waitmovement(0)
	releaseall
	end
}

text TrainerHillDev{
	"训练家之丘\n"
	"建设中"
}



script Route111_EventScript_Daisuke{
	lockall
	applymovement(30, Common_Movement_FacePlayer)
	goto_if_defeated(TRAINER_DAISUKE, Route111_EventScript_DaisukeDefeated)
	goto_if_set(FLAG_TEMP_1, Route111_EventScript_DaisukeRequestBattleAgain)
	msgbox(Daisuke_Greeting, MSGBOX_YESNO)
	goto(Route111_EventScript_BattleDaisukePrompt)
	end
}

script Route111_EventScript_DaisukeRequestBattleAgain{
	msgbox(Daisuke_ReadyYet, MSGBOX_YESNO)
	goto(Route111_EventScript_BattleDaisukePrompt)
	end
}

script Route111_EventScript_BattleDaisukePrompt{
	call_if_eq(VAR_RESULT, YES, Route111_EventScript_BattleDaisuke)
	goto_if_eq(VAR_RESULT, NO, Route111_EventScript_DeclineDaisukeBattle)
	closemessage
	end
}

script Route111_EventScript_DeclineDaisukeBattle {
	setflag(FLAG_TEMP_1)
	msgbox(Daisuke_ComeBackWhenReady, MSGBOX_DEFAULT)
	release
	end
}

script Route111_EventScript_BattleDaisuke{
	msgbox("来吧！", MSGBOX_DEFAULT)
	trainerbattle_no_intro(TRAINER_DAISUKE, Daisuke_Outro)
	giveitem(ITEM_PROTECTIVE_PADS)
	giveitem(ITEM_PUNCHING_GLOVE)
	giveitem(ITEM_KICKING_SHOES)
	giveitem(ITEM_LOADED_DICE)
	msgbox(Daisuke_ExplainItems, MSGBOX_DEFAULT)
	release
	end
}
	

script Route111_EventScript_DaisukeDefeated{
	msgbox(PostBattle_Daisuke, MSGBOX_DEFAULT)
	releaseall
	end
}

text Daisuke_Greeting{
	"哟！我正朝着成为这个地区\n"
	"空手道大师的目标努力。你若肯\l"
	"陪我练练，我就把我训练时\l"
	"用在宝可梦身上的道具\l"
	"给宝可梦用了不少。\p"
	"你觉得如何？"
}

text Daisuke_ReadyYet{
	"现在愿意帮我成为\n"
	"空手道大师了吗？"
}

text Daisuke_ComeBackWhenReady{
	"没关系，我就自己\n"
	"在这儿继续练。"
}

text Daisuke_ExplainItems{
	"那些道具我在训练时\n"
	"给宝可梦用了不少。\p"
	"它们能增强某些招式的威力，\n"
	"比如拳类或踢类招式。\p"
	"虽然用途挺专一的，但\n"
	"真的需要时超级好用！"
}
	
text Daisuke_Outro{
	"打得真好！把这些道具交给你，\n"
	"我很放心。"
}


text PostBattle_Daisuke{
	"看来我还差得远。\n"
	"希望你好好\l"
	"用那些道具！"
}