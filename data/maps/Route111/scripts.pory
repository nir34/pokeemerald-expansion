Route111_EventScript_TrainerHillSign::
	msgbox Route111_Text_TrainerHillSign, MSGBOX_SIGN
	end

Route111_Text_WhereTheHellAmI:
	.string "我到底在\n"
	.string "什么地方啊？！$"

Route111_Text_BattleOurFamily:
	.string "你好！看来你是个\n"
	.string "旅行者。\p"
	.string "怎么样？要不要和我们\n"
	.string "一家四口来几场\l"
	.string "宝可梦对战？$"

Route111_Text_IsThatSo:
	.string "这样啊？\n"
	.string "要是改主意了，就来吧！$"

Route111_Text_ShouldGetStronger:
	.string "嗯……在挑战我们一家\n"
	.string "之前，你也许该\l"
	.string "再变强一点。\p"
	.string "你要是能拿出烈焰徽章，\n"
	.string "我就知道你已经够强了。$"

Route111_Text_VictorIntro:
	.string "这才对！我喜欢你！$"

Route111_Text_VictorDefeat:
	.string "哎呀！\n"
	.string "你比我预想的强多了！$"

Route111_Text_VictorPostBattle:
	.string "喂，大家！\n"
	.string "我找到一个很强的训练家！$"

Route111_Text_VictoriaIntro:
	.string "哎呀！你还这么年轻？\p"
	.string "不过能打赢我丈夫，\n"
	.string "你一定很厉害。\p"
	.string "现在轮到我了！$"

Route111_Text_VictoriaDefeat:
	.string "天哪！\n"
	.string "你的强大真让我惊叹！$"

Route111_Text_VictoriaPostBattle:
	.string "这里有个很强的训练家！\n"
	.string "这个真的很强！$"

Route111_Text_ViviIntro:
	.string "你比妈妈还强？哇！\p"
	.string "不过我也很强！\n"
	.string "真的！真的哦！$"

Route111_Text_ViviDefeat:
	.string "咦？我刚刚输了吗？$"

Route111_Text_ViviPostBattle:
	.string "真讨厌……\p"
	.string "……呜……奶奶！$"

Route111_Text_VickyIntro:
	.string "你竟敢把我孙女\n"
	.string "弄哭！\p"
	.string "看招，我可要揍你！\n"
	.string "准备输吧！$"

Route111_Text_VickyDefeat:
	.string "哇！你真强……\n"
	.string "我孙女说得没错……$"

Route111_Text_VickyPostBattle:
	.string "你要是不急着走，\n"
	.string "就陪我们聊一会儿。$"

Route111_Text_ToughToKeepWinningUpTheRanks:
	.string "如果不好好培养宝可梦，\n"
	.string "想一路赢上去\l"
	.string "可不容易。\p"
	.string "我听说宝可梦联盟的四天王\n"
	.string "比任何道馆馆主都强得多。$"

Route111_Text_WinstrateFamilyDestroyedMe:
	.string "我挑战了温斯特一家，\n"
	.string "可连打四场太吃力了……\l"
	.string "他们把我都打垮了。$"

Route111_Text_RouteSignMauville:
	.string "111号道路\n"
	.string "{DOWN_ARROW} 紫堇市$"

Route111_Text_WinstrateHouseSign:
	.string "“全家的心合而为一！”\n"
	.string "温斯特之家$"

Route111_Text_RouteSign112:
	.string "111号道路\n"
	.string "{LEFT_ARROW} 112号道路$"

Route111_Text_RouteSign113:
	.string "111号道路\n"
	.string "{LEFT_ARROW} 113号道路$"

Route111_Text_OldLadysRestStopSign:
	.string "这里有护士$"

Route111_Text_TrainerTipsSpAtkSpDef:
	.string "训练家入门\p"
	.string "在查看宝可梦能力时，\n"
	.string "按“A”键就能\l"
	.string "看到它的努力值\l"
	.string "和个体值数据。$"

Route111_Text_ShouldBeMirageTowerAroundHere:
	.string "这附近应该有一座\n"
	.string "沙子做的塔。\p"
	.string "可不知为什么，它有时\n"
	.string "看得见，有时看不见。\p"
	.string "所以我叫它幻影塔。$"

Route111_Text_MirageTowerClearlyVisible:
	.string "我看见了！\n"
	.string "那座沙塔！\p"
	.string "大家称作幻影的沙塔，\n"
	.string "清清楚楚看得见！\p"
	.string "可它看起来很脆弱……\n"
	.string "随时都可能塌掉……\p"
	.string "我想进去看看，可就是\n"
	.string "提不起勇气……$"

Route111_Text_ThatWasShockingSandRainedDown:
	.string "哇……\n"
	.string "真吓人。\p"
	.string "沙子突然一块一块地\n"
	.string "往下掉。\p"
	.string "里面是什么样子？\n"
	.string "有沙子做的鬼吗？$"

Route111_Text_MirageTowerHasntBeenSeenSince:
	.string "自从和你说话以后，\n"
	.string "那座沙塔就不见了。\p"
	.string "也许它真的是\n"
	.string "幻影塔……$"

Route111_Text_ClawFossilDisappeared:
	.string "爪之化石\n"
	.string "消失在了沙子里……$"

Route111_Text_RootFossilDisappeared:
	.string "根之化石\n"
	.string "消失在了沙子里……$"

Route111_Text_MauvilleUncleToldMeToTakeRockSmash:
	.string "糟了！\p"
	.string "我在紫堇市的叔叔说，\n"
	.string "要去111号道路\l"
	.string "就得带上碎岩！\p"
	.string "我叔叔？他住在紫堇市\n"
	.string "自行车店对面。$"

Route111_Text_TrainerHillSign:
	.string "训练家之丘\n"
	.string "正在开发中$"

`

script Route111_EventScript_DawnTrigger1{
	setvar(VAR_0x8008, 1)
	goto(Route111_EventScript_DawnScene)
	end
}
	

script Route111_EventScript_DawnTrigger2{
	setvar(VAR_0x8008, 2)
	goto(Route111_EventScript_DawnScene)
	end
}

script Route111_EventScript_DawnTrigger3{
	setvar(VAR_0x8008, 3)
	goto(Route111_EventScript_DawnScene)
	end
}
	

script Route111_EventScript_DawnTrigger4{
	setvar(VAR_0x8008, 4)
	goto(Route111_EventScript_DawnScene)
	end
}


script Route111_EventScript_DawnScene{
	lockall
	call(Route104_EventScript_PlayDawnMusic)
	applymovement(LOCALID_DAWN, Common_Movement_WalkInPlaceFasterDown)
	waitmovement(0)
	applymovement(LOCALID_DAWN, Common_Movement_ExclamationMark)
	waitmovement(0)
	applymovement(LOCALID_DAWN, Common_Movement_Delay48)
	waitmovement(0)
	delay(30)
	call_if_eq(VAR_0x8008, 1, Route111_EventScript_DawnApproachPlayer1)
	call_if_eq(VAR_0x8008, 2, Route111_EventScript_DawnApproachPlayer2)
	call_if_eq(VAR_0x8008, 3, Route111_EventScript_DawnApproachPlayer3)
	call_if_eq(VAR_0x8008, 4, Route111_EventScript_DawnApproachPlayer4)
	goto(Route111_EventScript_DawnRivalBattle)
	releaseall
	end
}

script Route111_EventScript_DawnRivalBattle{
	msgbox(Route111_Text_Dawn_Greeting)
	trainerbattle_no_intro(TRAINER_DAWN_ROUTE_111, Route111_Text_Dawn_Defeated)
	goto(Route111_EventScript_DawnDefeated)
	end
}

script Route111_EventScript_DawnDefeated{
	msgbox(Route111_Text_Dawn_MagmaAndAqua)
	giveitem(ITEM_TM_ROOST)
	giveitem(ITEM_TM_SCALD)
	giveitem(ITEM_TM_FLASH_CANNON)
	giveitem(ITEM_ABILITY_PATCH, 999)
	msgbox(Route111_Text_DawnGoodbye)
	goto(Route111_EventScript_DawnExit)
	end
}
	


script Route111_EventScript_DawnApproachPlayer1{
	applymovement(LOCALID_DAWN, Route111_Movement_DawnApproachPlayer1)
	waitmovement(0)
	applymovement(OBJ_EVENT_ID_PLAYER, Route111_Movement_FaceDawn1)
	waitmovement(0)
	return
}

script Route111_Movement_FaceDawn1{
	walk_in_place_faster_right
	step_end
}

script Route111_Movement_FaceDawn2{
	walk_in_place_faster_left
	step_end
}
	
script Route111_Movement_DawnApproachPlayer1{
	walk_down
	walk_down
	walk_left
	step_end
}

script Route111_EventScript_DawnApproachPlayer2{
	applymovement(LOCALID_DAWN, Route111_Movement_DawnApproachPlayer2)
	waitmovement(0)
	applymovement(OBJ_EVENT_ID_PLAYER, Route111_Movement_FaceDawn1)
	waitmovement(0)
	return
}

script Route111_Movement_DawnApproachPlayer2{
	walk_down
	walk_down
	walk_in_place_faster_left
	step_end
}

script Route111_EventScript_DawnApproachPlayer3{
	applymovement(LOCALID_DAWN, Route111_Movement_DawnApproachPlayer3)
	waitmovement(0)
	return
}

script Route111_Movement_DawnApproachPlayer3{
	walk_down
	step_end
}

script Route111_EventScript_DawnApproachPlayer4{
	applymovement(LOCALID_DAWN, Route111_Movement_DawnApproachPlayer4)
	waitmovement(0)
	applymovement(OBJ_EVENT_ID_PLAYER, Route111_Movement_FaceDawn2)
	waitmovement(0)
	return
}

script Route111_Movement_DawnApproachPlayer4{
	walk_down
	walk_down
	walk_in_place_faster_right
	step_end
}

script Route111_EventScript_DawnExit{
	closemessage
	delay(45)
	call_if_eq(VAR_0x8008, 1, Route111_EventScript_ApplyMovementDawn1)
	call_if_eq(VAR_0x8008, 2, Route111_EventScript_ApplyMovementDawn2)
	call_if_eq(VAR_0x8008, 3, Route111_EventScript_ApplyMovementDawn3)
	call_if_eq(VAR_0x8008, 4, Route111_EventScript_ApplyMovementDawn4)
	removeobject(LOCALID_DAWN)
	setflag(FLAG_DAWN_111)
	setvar(VAR_FOUGHT_DAWN_111, 1)
	savebgm(MUS_DUMMY)
	fadedefaultbgm
	releaseall
	end
}

text Route111_Text_Dawn_Greeting{
	"嘿，{PLAYER}！好久不见！哇，\n"
	"看来你已经从铁旋那儿拿到了\l"
	"电力徽章，真厉害！\p" 
	"我好不容易才走到釜炎镇\n"
	"去挑战亚莎，所以我想\l"
	"还是原路返回，先练一练\l"
	"再说……\p"
	"看来这还挺\n"
	"巧的，准备好吧！"
}

text Route111_Text_Dawn_Defeated{
	"要是我又输给你，那可\n"
	"真得多练练了！"
}

text Route111_Text_Dawn_MagmaAndAqua{
	"对了，我在前面那座山\n"
	"附近转的时候，听到\l"
	"有水舰队在和另一个叫\l"
	"熔岩队的组织\l"
	"打架。\p"
	"我不太清楚发生了什么，\n"
	"但你往前要小心。\p"
	"对了，我有些多余的\n"
	"道具，给你吧，希望有用！"
}

text Route111_Text_DawnGoodbye{
	"我回去训练了，回头见！"
}

