	waitmoncry
	release
	end

PetalburgCity_Gym_Text_DadYoureHereWithYourPokemon:
	.string "爸爸：嗯？\p"
	.string "哎呀，这不是{PLAYER}吗！\n"
	.string "搬家都收拾好了？\p"
	.string "我真没想到你能\n"
	.string "自己走到这里来。\p"
	.string "哦，原来如此。\n"
	.string "你和宝可梦在一起。\p"
	.string "嗯……那你大概也要\n"
	.string "像我一样当训练家，\l"
	.string "{PLAYER}。\p"
	.string "太好了！\n"
	.string "我很期待！$"

PetalburgCity_Gym_Text_WallyIdLikeAPokemon:
	.string "那个……我……\n"
	.string "我想要一只宝可梦……$"

PetalburgCity_Gym_Text_DadOhYoureWallyRight:
	.string "爸爸：嗯？你是……\n"
	.string "呃……哦，对了。\l"
	.string "你是小胜吧？$"

PetalburgCity_Gym_Text_WallyIveNeverCaughtAPokemon:
	.string "小胜：我要去绿荫镇\n"
	.string "和亲戚一起住。\p"
	.string "我怕自己一个人会寂寞，\n"
	.string "所以想带一只宝可梦去。\p"
	.string "可是我从来没抓过宝可梦。\n"
	.string "我不知道该怎么做……$"

PetalburgCity_Gym_Text_DadHmISee:
	.string "爸爸：嗯。我明白了。$"

PetalburgCity_Gym_Text_DadPlayerGoWithWally:
	.string "爸爸：{PLAYER}，\n"
	.string "你听到了吧？\p"
	.string "和小胜一起去，\n"
	.string "确保他能平安抓到宝可梦。$"

PetalburgCity_Gym_Text_IllLoanYouMyZigzagoon:
	.string "小胜，来，我把我的\n"
	.string "宝可梦借给你。\p"
	.string "小胜得到了蛇纹熊！$"

PetalburgCity_Gym_Text_WallyThankYouAndDadGivesPokeBall:
	.string "小胜：哦，哇！\n"
	.string "是宝可梦！\p"
	.string "爸爸：嗯。我再给你一个\n"
	.string "精灵球。去吧！\p"
	.string "小胜得到了精灵球！$"

PetalburgCity_Gym_Text_WallyOhWowThankYou:
	.string "小胜：哦，哇！\n"
	.string "谢谢你！$"

PetalburgCity_Gym_Text_WouldYouReallyComeWithMe:
	.string "{PLAYER}……你真的\n"
	.string "愿意和我一起去吗？$"

PetalburgCity_Gym_Text_DadSoDidItWorkOut:
	.string "爸爸：怎么样，顺利吗？$"

PetalburgCity_Gym_Text_WallyThankYouBye:
	.string "小胜：谢谢你，很顺利。\n"
	.string "你的宝可梦还给你。\p"
	.string "{PLAYER}，谢谢你来陪我。\p"
	.string "因为有你们俩，我才能\n"
	.string "抓到自己的宝可梦。\p"
	.string "我保证会好好照顾它。\p"
	.string "哦！我妈妈在等我，\n"
	.string "我得走了！\p"
	.string "再见，{PLAYER}！$"

PetalburgCity_Gym_Text_DadGoCollectBadges:
	.string "爸爸：呼。他要学的东西\n"
	.string "还很多，不过刚才\l"
	.string "他打开背包时，\l"
	.string "我好像看到了什么超级石。\p"
	.string "不知道他从哪儿弄来的？\n" 
	.string "总之……\p"
	.string "{PLAYER}，想成为强大的\n"
	.string "训练家，我给你个建议。\p"
	.string "先去这座城镇前方的\n"
	.string "卡那兹市。\p"
	.string "到那里，先挑战\n"
	.string "道馆馆主杜娟。\p"
	.string "之后再去其他宝可梦道馆，\n"
	.string "打赢各位馆主。\p"
	.string "从他们那里收集徽章，\n"
	.string "明白了吗？\p"
	.string "当然，我也是个道馆馆主。\n"
	.string "总有一天我们会打一场，{PLAYER}。\p"
	.string "不过那要等你变得\n"
	.string "更强之后。$"

PetalburgCity_Gym_Text_NormanGoToRustboro:
	.string "爸爸：嗯？你不是要去\n"
	.string "卡那兹市的宝可梦道馆吗？\p"
	.string "跟一个新手训练家对战，\n"
	.string "对我来说没什么意思。\p"
	.string "{PLAYER}，等你变得\n"
	.string "更强了再来挑战我。\p"
	.string "等你拿得出四枚道馆徽章，\n"
	.string "我就和你对战，好吗？$"

PetalburgCity_Gym_Text_NormanGoToDewford:
	.string "爸爸：原来如此……你打赢了\n"
	.string "卡那兹市道馆的馆主。\p"
	.string "可是还有很多训练家\n"
	.string "比你更强，{PLAYER}。\p"
	.string "海那边的武斗镇有位\n"
	.string "叫藤树的道馆馆主。\p"
	.string "你该去挑战他。$"

PetalburgCity_Gym_Text_YouHaveGottenStronger:
	.string "爸爸：嗯……{PLAYER}，你\n"
	.string "变强了。\p"
	.string "看你拿到的徽章数量\n"
	.string "我就知道。$"

PetalburgCity_Gym_Text_NormanGoToTrickHouse:
	.string "嘿，{PLAYER}，见到你真好。\n"
	.string "我看你已经拿到了\l"
	.string "和我正式对战的四枚徽章，\l"
	.string "不过在对战之前，\l"
	.string "我觉得你还该去做一件事。\p"
	.string "{COLOR GREEN}{SHADOW LIGHT_GREEN}你该去110号道路的\n"
	.string "机关屋看看，\l"
	.string "我觉得完成三个机关\l"
	.string "正好能试试你的新超级环。{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}\p"
	.string "还有，先跟你说一声。\n"
	.string "小胜不久前从这里经过，\l"
	.string "我给了他一个超级环和\l"
	.string "同样的建议。\p"
	.string "谁知道呢，也许你会在\n"
	.string "机关屋碰见他？$"

PetalburgCity_Gym_Text_NormanIntro:
	.string "好！！！\p"
	.string "看来你不但拿到了\n"
	.string "前四枚徽章，\l"
	.string "还通过了机关屋\l"
	.string "前几个机关！\p"
	.string "就像说好的，我们终于\n"
	.string "能正式对战了！\p"
	.string "{PLAYER}……\p"
	.string "能和我自己的孩子真正\n"
	.string "打一场，我太高兴了。\p"
	.string "不过，对战就是对战！\p"
	.string "我会作为道馆馆主\n"
	.string "全力争取胜利。\p"
	.string "{PLAYER}，你也拿出\n"
	.string "全部本事来吧！$"

PetalburgCity_Gym_Text_NormanDefeat:
	.string "……\p"
	.string "我……我不行了……\p"
	.string "真不敢相信，{PLAYER}……\p"
	.string "你成长了这么多……\p"
	.string "不过，规矩就是规矩！\n"
	.string "来，拿去吧！$"

PetalburgCity_Gym_Text_ReceivedBalanceBadge:
	.string "{PLAYER}从爸爸那里\n"
	.string "得到了平衡徽章！$"

PetalburgCity_Gym_Text_ExplainBalanceBadgeTakeThis:
	.string "有了这枚平衡徽章，\n"
	.string "学会秘传招式冲浪的\l"
	.string "宝可梦就能在水上行走。\p"
	.string "这是给你的礼物。{PLAYER}，\n"
	.string "我相信你能用好它们。$"

PetalburgCity_Gym_Text_ExplainFacade:
	.string "很遗憾，目前世界上\n"
	.string "仅存的那块懒惰石\l"
	.string "只有我有。\p"
	.string "我得留着它镇守道馆，\n"
	.string "不过我保证，一旦拿到\l"
	.string "第二块，我就让\l"
	.string "你的朋友给你送去。$"

PetalburgCity_Gym_Text_DadHappyAndSad:
	.string "作为道馆馆主，我\n"
	.string "说不出有多懊丧……\p"
	.string "可作为父亲，我又高兴\n"
	.string "又有点难过。真奇怪……$"

PetalburgCity_Gym_Text_PleaseComeWithMe:
	.string "啊，你在这儿，{PLAYER}！\p"
	.string "请跟我来。\n"
	.string "我有样东西想给你。$"

PetalburgCity_Gym_Text_LetMeBorrowPlayer:
	.string "千里，你不介意吧？\p"
	.string "把你的{PLAYER}借我\n"
	.string "一两分钟。$"

PetalburgCity_Gym_Text_DadGoingToKeepTraining:
	.string "爸爸：{PLAYER}，你该时不时\n"
	.string "回去看看你妈妈。\p"
	.string "我要留在这里，加倍\n"
	.string "努力训练。\p"
	.string "作为训练家，要是不报\n"
	.string "输给你的仇，我心里\l"
	.string "总不痛快，{PLAYER}！$"

PetalburgCity_Gym_Text_DadNoAmountOfTrainingIsEnough:
	.string "爸爸：{PLAYER}，最近\n"
	.string "怎么样？\p"
	.string "宝可梦的世界很深奥。\p"
	.string "说实话，我觉得再怎么\n"
	.string "训练也不够。$"

PetalburgCity_Gym_Text_GymGuideAdvice:
	.string "嘿，冠军候补的{PLAYER}，\n"
	.string "最近怎么样？\p"
	.string "打败在等你的训练家，\n"
	.string "这个道馆的门就会打开。\p"
	.string "哎呀！这个房间的门\n"
	.string "本来就开着，别打我！\p"
	.string "橙华道馆的训练家\n"
	.string "会用各种道具。\p"
	.string "左边的门通往\n"
	.string "速度房间。\p"
	.string "右边的门通往\n"
	.string "命中房间。\p"
	.string "门上写着房间的名字，\n"
	.string "仔细选吧。\p"
	.string "既然选好了门……\n"
	.string "那就，去吧！$"

PetalburgCity_Gym_Text_GymGuidePostVictory:
	.string "{PLAYER}！哇！你连自己\n"
	.string "的爸爸都打败了！\p"
	.string "真是的！\n"
	.string "这转折也太惊人了！$"

PetalburgCity_Gym_Text_RandallIntro:
	.string "能比对手先出手的\n"
	.string "能力……\p"
	.string "光这一点就让我占了\n"
	.string "很大优势，你不觉得吗？$"

PetalburgCity_Gym_Text_RandallDefeat:
	.string "好一场精彩的对战！$"

PetalburgCity_Gym_Text_RandallPostBattle:
	.string "去下一个房间吧，\n"
	.string "新的挑战在等着你。\p"
	.string "左边是混乱房间。\p"
	.string "右边的门通往\n"
	.string "防御房间。$"

PetalburgCity_Gym_Text_RandallPostBadge:
	.string "不管赢了谁，还是输给谁，\n"
	.string "你从不逃避磨练\l"
	.string "自己和宝可梦。\p"
	.string "我觉得这才是一个\n"
	.string "道馆馆主的本色。$"

PetalburgCity_Gym_Text_ParkerIntro:
	.string "这里是混乱房间。\p"
	.string "让我看看你和宝可梦\n"
	.string "的羁绊有多深！$"

PetalburgCity_Gym_Text_ParkerDefeat:
	.string "我没能让你的队伍混乱……\n"
	.string "你们的羁绊非常牢固。$"

PetalburgCity_Gym_Text_ParkerPostBattle:
	.string "下一个房间是力量房间。\n"
	.string "你挡得住蛮力吗？$"

PetalburgCity_Gym_Text_ParkerPostBadge:
	.string "你打赢我们馆主之后，\n"
	.string "训练变得难多了。$"

PetalburgCity_Gym_Text_MaryIntro:
	.string "嘻嘻……\n"
	.string "这里是命中房间。\p"
	.string "每次攻击都必定命中，\n"
	.string "可不好对付哦。$"

PetalburgCity_Gym_Text_MaryDefeat:
	.string "你比我高出一筹……$"

PetalburgCity_Gym_Text_MaryPostBattle:
	.string "还有更强的训练家\n"
	.string "在等着你。\p"
	.string "左边是防御房间，\n"
	.string "右边是回复房间。\p"
	.string "不管走哪边，你的宝可梦\n"
	.string "的攻击力都会受考验。$"

PetalburgCity_Gym_Text_MaryPostBadge:
	.string "你知道我们当训练家\n"
	.string "想追求什么吗？\p"
	.string "我们想和宝可梦成为\n"
	.string "灵魂相通的伙伴。$"

PetalburgCity_Gym_Text_AlexiaIntro:
	.string "防御越高，我进攻时\n"
	.string "就能越无所顾忌。$"

PetalburgCity_Gym_Text_AlexiaDefeat:
	.string "我们的防御还不够……$"

PetalburgCity_Gym_Text_AlexiaPostBattle:
	.string "我觉得你在这里\n"
	.string "教了我宝贵的一面。\p"
	.string "那么，去吧！左边的门\n"
	.string "通往力量房间。\p"
	.string "右边的门通往\n"
	.string "一击必杀房间。\p"
	.string "两边的训练家\n"
	.string "都很擅长攻击。$"

PetalburgCity_Gym_Text_AlexiaPostBadge:
	.string "嗨！你试过用冲浪吗？$"

PetalburgCity_Gym_Text_JodyIntro:
	.string "我们馆主说，要全力\n"
	.string "把你打败。\p"
	.string "就算你是馆主的\n"
	.string "孩子也一样！$"

PetalburgCity_Gym_Text_JodyDefeat:
	.string "可是……我明明\n"
	.string "已经全力了！$"

PetalburgCity_Gym_Text_JodyPostBattle:
	.string "你使用宝可梦的方式……\n"
	.string "就像你爸爸的风格。\p"
	.string "过去吧！馆主，也就是\n"
	.string "你爸爸，正在等着你！$"

PetalburgCity_Gym_Text_JodyPostBadge:
	.string "让宝可梦变强当然好。\p"
	.string "可决定胜负的是什么呢？\p"
	.string "是训练家对宝可梦的\n"
	.string "感情啊。$"

PetalburgCity_Gym_Text_DoorAppearsLocked:
	.string "这扇门现在\n"
	.string "好像锁着……$"

PetalburgCity_Gym_Text_EnterSpeedRoom:
	.string "“速度房间”，\n"
	.string "牌子上写着。\p"
	.string "要进去吗？$"

@ Unused
PetalburgCity_Gym_Text_DoorAppearsLocked2:
	.string "这扇门现在\n"
	.string "好像锁着……$"

PetalburgCity_Gym_Text_EnterAccuracyRoom:
	.string "“命中房间”，\n"
	.string "牌子上写着。\p"
	.string "要进去吗？$"

PetalburgCity_Gym_Text_EnterConfusionRoom:
	.string "“混乱房间”，\n"
	.string "牌子上写着。\p"
	.string "要进去吗？$"

PetalburgCity_Gym_Text_EnterDefenseRoom:
	.string "“防御房间”，\n"
	.string "牌子上写着。\p"
	.string "要进去吗？$"

PetalburgCity_Gym_Text_EnterRecoveryRoom:
	.string "“回复房间”，\n"
	.string "牌子上写着。\p"
	.string "要进去吗？$"

PetalburgCity_Gym_Text_EnterStrengthRoom:
	.string "“力量房间”，\n"
	.string "牌子上写着。\p"
	.string "要进去吗？$"

PetalburgCity_Gym_Text_EnterOHKORoom:
	.string "“一击必杀房间”，\n"
	.string "牌子上写着。\p"
	.string "要进去吗？$"

PetalburgCity_Gym_Text_EnterGymLeadersRoom:
	.string "“馆主房间\p"
	.string "“亲自看看有什么宝可梦\n"
	.string "在等你吧！”\l"
	.string "牌子上写着。\p"
	.string "要进去吗？$"

PetalburgCity_Gym_Text_GymStatue:
	.string "橙华市宝可梦道馆$"

PetalburgCity_Gym_Text_GymStatueCertified:
	.string "橙华市宝可梦道馆\p"
	.string "千里认定的训练家：\n"
	.string "{PLAYER}$"

PetalburgCity_Gym_Text_NormanPreRematch:
	.string "爸爸：{PLAYER}……\n"
	.string "我感觉你会来。\p"
	.string "我绝不会拒绝\n"
	.string "你的挑战。\p"
	.string "你明白吧？\p"
	.string "在道馆里，我们是\n"
	.string "父子这一点并不重要。\p"
	.string "……不，正因为是父子，\n"
	.string "我们才该彼此全力\l"
	.string "以赴。对吧，{PLAYER}？$"

PetalburgCity_Gym_Text_NormanRematchDefeat:
	.string "呃……哈哈……\n"
	.string "也许是我太用力了……$"

PetalburgCity_Gym_Text_NormanPostRematch:
	.string "爸爸：{PLAYER}……\n"
	.string "你的梦想是什么？\p"
	.string "我的梦想……\n"
	.string "哈哈哈……\l"
	.string "其实，它早就实现了。$"

PetalburgCity_Gym_Text_NormanRematchNeedTwoMons:
	.string "爸爸：{PLAYER}……\n"
	.string "我感觉你会来。\p"
	.string "我绝不会拒绝\n"
	.string "你的挑战。\p"
	.string "你明白吧？\p"
	.string "在道馆里，我们是\n"
	.string "父子这一点并不重要。\p"
	.string "嗯？等等，{PLAYER}。\p"
	.string "你能参加对战的宝可梦\n"
	.string "只有一只吗？\p"
	.string "抱歉，请你至少带两只\n"
	.string "宝可梦再来。$"

PetalburgCity_Gym_Text_Slaking:
	.string "请假王：呜啊啊啊啊！$"


PetalburgCity_Gym_Text_PlayerHelpedWally:
	.string "{PLAYER}帮小胜\n"
	.string "抓到了拉鲁拉丝！$"
`
