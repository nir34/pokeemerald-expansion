SootopolisCity_EventScript_BlackBeltRayquaza::
	applymovement LOCALID_BLACK_BELT, Common_Movement_FacePlayer
	waitmovement 0
	msgbox SootopolisCity_Text_GreenOneSettlesThings, MSGBOX_DEFAULT
	releaseall
	end

SootopolisCity_EventScript_Girl::
	lockall
	applymovement LOCALID_GIRL, Common_Movement_FacePlayer
	waitmovement 0
	goto_if_eq VAR_SOOTOPOLIS_CITY_STATE, 5, SootopolisCity_EventScript_GirlRayquaza
	msgbox SootopolisCity_Text_SootopolisWillBeWrecked, MSGBOX_DEFAULT
	closemessage
	applymovement LOCALID_GIRL, Common_Movement_FaceOriginalDirection
	waitmovement 0
	releaseall
	end

SootopolisCity_EventScript_GirlRayquaza::
	msgbox SootopolisCity_Text_SootopolisDidntGetWrecked, MSGBOX_DEFAULT
	closemessage
	releaseall
	end

SootopolisCity_EventScript_Maniac::
	lockall
	applymovement LOCALID_MANIAC, Common_Movement_FacePlayer
	waitmovement 0
	goto_if_eq VAR_SOOTOPOLIS_CITY_STATE, 5, SootopolisCity_EventScript_ManiacRayquaza
	msgbox SootopolisCity_Text_SeeingLegendWithOwnEyes, MSGBOX_DEFAULT
	closemessage
	applymovement LOCALID_MANIAC, Common_Movement_FaceOriginalDirection
	waitmovement 0
	releaseall
	end

SootopolisCity_EventScript_ManiacRayquaza::
	msgbox SootopolisCity_Text_SawLegendWithOwnEyes, MSGBOX_DEFAULT
	releaseall
	end

SootopolisCity_EventScript_Wallace::
	lock
	faceplayer
	goto_if_eq VAR_SOOTOPOLIS_CITY_STATE, 4, SootopolisCity_EventScript_GoToSkyPillar
	goto_if_set FLAG_RECEIVED_HM_WATERFALL, SootopolisCity_EventScript_GoToGym
	goto_if_set FLAG_SOOTOPOLIS_ARCHIE_MAXIE_LEAVE, SootopolisCity_EventScript_GiveWaterfall
	msgbox SootopolisCity_Text_AquaMagmaDidntMeanHarm, MSGBOX_DEFAULT
	release
	end

SootopolisCity_EventScript_GiveWaterfall::
	msgbox SootopolisCity_Text_ThankYouForHelpAcceptThis, MSGBOX_DEFAULT
	giveitem ITEM_HM_WATERFALL
	setflag FLAG_RECEIVED_HM_WATERFALL
	msgbox SootopolisCity_Text_ExplainWaterfallGoToGym, MSGBOX_DEFAULT
	closemessage
	call_if_eq VAR_FACING, DIR_NORTH, SootopolisCity_EventScript_WallaceMoveFromGym
	call_if_eq VAR_FACING, DIR_EAST, SootopolisCity_EventScript_WallaceMoveFromGym
	call_if_eq VAR_FACING, DIR_WEST, SootopolisCity_EventScript_WallaceMoveFromGymWest
	release
	end

SootopolisCity_EventScript_WallaceMoveFromGym::
	applymovement LOCALID_WALLACE, SootopolisCity_Movement_WallaceMoveFromGym
	waitmovement 0
	copyobjectxytoperm LOCALID_WALLACE
	setvar VAR_SOOTOPOLIS_WALLACE_STATE, 1
	return

SootopolisCity_EventScript_WallaceMoveFromGymWest::
	applymovement LOCALID_WALLACE, SootopolisCity_Movement_WallaceMoveFromGymWest
	waitmovement 0
	copyobjectxytoperm LOCALID_WALLACE
	setvar VAR_SOOTOPOLIS_WALLACE_STATE, 2
	return

SootopolisCity_EventScript_GoToSkyPillar::
	msgbox SootopolisCity_Text_HaventYouScaledSkyPillar, MSGBOX_DEFAULT
	release
	end

SootopolisCity_EventScript_GoToGym::
	msgbox SootopolisCity_Text_DazzledByMentor, MSGBOX_DEFAULT
	release
	end

SootopolisCity_Movement_WallaceMoveFromGym:
	walk_right
	walk_in_place_faster_down
	step_end

SootopolisCity_Movement_WallaceMoveFromGymWest:
	walk_left
	walk_in_place_faster_down
	step_end

SootopolisCity_EventScript_Maxie::
	lockall
	goto_if_eq VAR_SOOTOPOLIS_CITY_STATE, 5, SootopolisCity_EventScript_MaxieRayquaza
	msgbox SootopolisCity_Text_GroudonPleaseStop, MSGBOX_DEFAULT
	closemessage
	releaseall
	end

SootopolisCity_EventScript_MaxieRayquaza::
	msgbox SootopolisCity_Text_AfterAllOurScheming, MSGBOX_NPC
	setflag FLAG_MET_MAXIE_SOOTOPOLIS
	goto_if_set FLAG_MET_ARCHIE_SOOTOPOLIS, SootopolisCity_EventScript_MaxieArchieLeave
	releaseall
	end

SootopolisCity_EventScript_Archie::
	lockall
	goto_if_eq VAR_SOOTOPOLIS_CITY_STATE, 5, SootopolisCity_EventScript_ArchieRayquaza
	msgbox SootopolisCity_Text_KyogreCalmDown, MSGBOX_DEFAULT
	closemessage
	releaseall
	end

SootopolisCity_EventScript_ArchieRayquaza::
	msgbox SootopolisCity_Text_TryingMeaninglessToPokemon, MSGBOX_NPC
	setflag FLAG_MET_ARCHIE_SOOTOPOLIS
	goto_if_set FLAG_MET_MAXIE_SOOTOPOLIS, SootopolisCity_EventScript_MaxieArchieLeave
	releaseall
	end

SootopolisCity_EventScript_MaxieArchieLeave::
	setflag FLAG_HIDE_SOOTOPOLIS_CITY_MAXIE
	setflag FLAG_HIDE_SOOTOPOLIS_CITY_ARCHIE
	setflag FLAG_SOOTOPOLIS_ARCHIE_MAXIE_LEAVE
	clearflag FLAG_HIDE_MT_PYRE_SUMMIT_ARCHIE
	clearflag FLAG_HIDE_MT_PYRE_SUMMIT_MAXIE
	setvar VAR_MT_PYRE_STATE, 2
	warpsilent MAP_SOOTOPOLIS_CITY, 31, 34
	waitstate
	releaseall
	end

@ Unused
SootopolisCity_Movement_Levitate::
	levitate
	step_end

@ Unused
SootopolisCity_Movement_DestroyTask::
	destroy_extra_task
	step_end

SootopolisCity_Text_GymSign:
	.string "琉璃市宝可梦道馆\n"
	.string "馆主：阿丹\p"
	.string "“拥有纯水之美的\n"
	.string "道馆馆主！”$"

SootopolisCity_Text_CitySign:
	.string "琉璃市\p"
	.string "“历史沉睡的\n"
	.string "神秘之城。”$"

SootopolisCity_Text_DoorIsClosed:
	.string "门关着。$"

SootopolisCity_Text_PhysicallyFitLivingHere:
	.string "在海里潜水。天天上下\n"
	.string "爬楼梯……\p"
	.string "住在这个镇上的人，\n"
	.string "身体都会变壮。$"

SootopolisCity_Text_GiantPokemonSuddenlyAppeared:
	.string "这些巨大的宝可梦突然\n"
	.string "出现在城市正中央！\p"
	.string "而且我从没见过\n"
	.string "它们！\p"
	.string "它们为什么那样\n"
	.string "互相撞来撞去？\p"
	.string "为什么不能好好\n"
	.string "做朋友呢，那些宝可梦？$"

SootopolisCity_Text_WhatIsThatGreenPokemon:
	.string "什么？什么？什么？\n"
	.string "那只绿色的宝可梦是什么？！$"

SootopolisCity_Text_WhereDidLegendariesGo:
	.string "固拉多和盖欧卡……\n"
	.string "它们去哪儿了？\p"
	.string "它们会不会在别的地方\n"
	.string "引发干旱或暴雨？$"

SootopolisCity_Text_TwoPokemonArentAngry:
	.string "我不知怎么就感觉，\n"
	.string "那两只宝可梦并不愤怒。\p"
	.string "我想……它们大概是\n"
	.string "控制不住自己的力量……$"

SootopolisCity_Text_FlyingMonStoppedRampage:
	.string "那只飞行宝可梦从天而降，\n"
	.string "阻止了暴走的\l"
	.string "宝可梦……$"

SootopolisCity_Text_GreatWork:
	.string "太了不起了，{PLAYER}。我\n"
	.string "从没见过那么强大的宝可梦\l"
	.string "那样相互交锋。\p"
	.string "总之，你也很了不起！\n"
	.string "真不敢相信源治一直\l"
	.string "藏着那样的邪恶计划……\p"
	.string "幸好有你在阻止他！\p"
	.string "我想我在神奥地区的那位\n"
	.string "朋友，也许是接替他\l"
	.string "进入四天王的\l"
	.string "合适人选……$"
	.string "四天王暂时。\p" 
	.string "我得和大吾还有米可利\n"
	.string "商量一下。$"

SootopolisCity_Text_ThisIsCrazy:
	.string "{PLAYER}！你走后不久，\n"
	.string "我在绿岭碰到大吾，\l"
	.string "他让我在你追熔岩队、\l"
	.string "源治追水舰队的时候\l"
	.string "先来琉璃市。\p"
	.string "我到这儿的时候，固拉多\n"
	.string "和盖欧卡已经对上了！\p"
	.string "我们该怎么办？希望我\n"
	.string "从神奥叫来的人\l"
	.string "能及时赶到……$"

SootopolisCity_Text_WonderWhatWorldIsLike:
	.string "我……我从没离开过\n"
	.string "这座城市。\p"
	.string "不知道这些圆墙之外的\n"
	.string "世界是什么样子？\p"
	.string "哦，我说墙？我是说\n"
	.string "悬崖……抱歉，那些\l"
	.string "巨人一样的宝可梦\l"
	.string "真把我吓坏了。$"

SootopolisCity_Text_ThisIsWicked:
	.string "哇！\n"
	.string "这太酷了！$"

SootopolisCity_Text_ThatWasWicked:
	.string "哇！\n"
	.string "那太酷了！$"

SootopolisCity_Text_GoRedAndBlueMon:
	.string "加油，红色的宝可梦！\n"
	.string "别退，蓝色的宝可梦！$"

SootopolisCity_Text_DoYouKnowMonNames:
	.string "… … … … … …\p"
	.string "嗨，你知道那边打架的\n"
	.string "宝可梦叫什么吗？$"

SootopolisCity_Text_GreenOneSettlesThings:
	.string "我还在猜红色和蓝色\n"
	.string "哪个会赢，结果，哎呀，\l"
	.string "是绿色来收场！\p"
	.string "真是天大的转折！$"

SootopolisCity_Text_SeeingLegendWithOwnEyes:
	.string "有古老传说说，大地和\n"
	.string "海洋是一场宝可梦\l"
	.string "巨战塑造的。\p"
	.string "我现在正亲眼看着\n"
	.string "它发生！\p"
	.string "哇！我从没想过能亲眼\n"
	.string "见到这么宏大的场面！$"

SootopolisCity_Text_SawLegendWithOwnEyes:
	.string "有古老传说说，大地和\n"
	.string "海洋是一场宝可梦\l"
	.string "巨战塑造的。\p"
	.string "我亲眼看到了\n"
	.string "那一切发生！\p"
	.string "哇！我从没想过能亲眼\n"
	.string "见到这么宏大的场面！$"

SootopolisCity_Text_BigPokemonFighting:
	.string "一只大宝可梦正和\n"
	.string "另一只大宝可梦打架！\p"
	.string "求求谁让它们\n"
	.string "停下来！$"

SootopolisCity_Text_PrettyMonCameFromSky:
	.string "一只漂亮的宝可梦\n"
	.string "从天而降……$"

SootopolisCity_Text_SootopolisWillBeWrecked:
	.string "哦，不！\n"
	.string "琉璃市要毁了！$"

SootopolisCity_Text_SootopolisDidntGetWrecked:
	.string "琉璃市没有毁掉！$"

SootopolisCity_Text_NoOrdinaryTourist:
	.string "嗯！\n"
	.string "你特地跑到琉璃市来？\l"
	.string "你不是普通游客。\p"
	.string "不过我想，这也不代表\n"
	.string "你就是特别的游客。$"

SootopolisCity_Text_CityRegainedCalm:
	.string "城市又恢复了平静……$"

SootopolisCity_Text_CaveOfOriginPleaseLeave:
	.string "你是谁？\p"
	.string "这是觉醒祠堂。\p"
	.string "据说在送神火山被安抚的\n"
	.string "宝可梦灵魂会在这里复苏。\p"
	.string "请离开。$"

SootopolisCity_Text_LeadSuperiorTrainerToCave:
	.string "意志坚强、才能出众\n"
	.string "的人……\p"
	.string "对各种宝可梦都有知识\n"
	.string "和经验的训练家……\p"
	.string "要是出现这样的人，\n"
	.string "阿丹吩咐过我，\l"
	.string "要带那位训练家来这个祠堂。$"

SootopolisCity_Text_AwakenedPokemonClash:
	.string "哦，天啊……\p"
	.string "两只觉醒宝可梦的冲突，\n"
	.string "被第三只宝可梦的\l"
	.string "觉醒平息了……$"

SootopolisCity_Text_CaveOfOriginSleepsToo:
	.string "这是觉醒祠堂……\p"
	.string "危机过去，这个祠堂\n"
	.string "也要沉睡了……$"

SootopolisCity_Text_CaveOfOriginOpen:
	.string "这是觉醒祠堂……\p"
	.string "既然你已经是冠军，\n"
	.string "随时都可以进去。$"

SootopolisCity_Text_SootopolisSkyBeautiful:
	.string "琉璃市是在火山口里\n"
	.string "发展起来的城镇。\p"
	.string "抬头看天，能看到\n"
	.string "火山口的边缘。\l"
	.string "所以你看到的天是个圆。\p"
	.string "可正因为这样，琉璃市\n"
	.string "上方的天空才最美。$"

SootopolisCity_Text_GiganticPokemonFight:
	.string "那么巨大的两只宝可梦\n"
	.string "那么凶猛地打，\l"
	.string "我们也没什么能做的。$"

SootopolisCity_Text_FearedWorstWhenPokemonFlewDown:
	.string "第三只宝可梦飞下来\n"
	.string "的时候，我做了\l"
	.string "最坏的打算。$"

SootopolisCity_Text_NightSkyFavoriteScenery:
	.string "火山口框出的一圈夜空……\p"
	.string "那一圈里，星星像活着\n"
	.string "一样闪烁明灭……\l"
	.string "这是我最喜欢的景色。$"

SootopolisCity_Text_WeatherWentWild:
	.string "今天早上天气还是晴的，\n"
	.string "可……\p"
	.string "突然乌云密布，雨下得\n"
	.string "像水帘，还有雷电。\p"
	.string "天气完全疯了一样！\p"
	.string "这一切都是那些\n"
	.string "宝可梦造成的吗？$"

SootopolisCity_Text_YouBroughtFlyingMon:
	.string "哦？\p"
	.string "把那只飞行宝可梦\n"
	.string "带来的人是你？\p"
	.string "你还真了不起！$"

SootopolisCity_Text_GroudonPleaseStop:
	.string "固……固拉多……\n"
	.string "求你！住手！\p"
	.string "我现在知道你的力量\n"
	.string "有多大了！\p"
	.string "再这样下去，不只是\n"
	.string "琉璃市，整个丰缘都会\l"
	.string "彻底毁掉！$"

SootopolisCity_Text_AfterAllOurScheming:
	.string "原来超古代宝可梦\n"
	.string "不只有固拉多和盖欧卡……\p"
	.string "我们白白策划、慌忙\n"
	.string "折腾了那么久，结果\l"
	.string "那一只宝可梦随便一动，\l"
	.string "一切就像没发生过一样\l"
	.string "恢复了……\p"
	.string "嗯，我想不只是烈空坐，\n"
	.string "还有你，{PLAYER}。\p"
	.string "参与了这场失控的计划，\n"
	.string "我觉得自己像个傻瓜……$"

SootopolisCity_Text_KyogreCalmDown:
	.string "盖欧卡！怎么了？！\n"
	.string "冷静下来！盖欧卡！\p"
	.string "… … … … … …\n"
	.string "… … … … … …\p"
	.string "不行！\n"
	.string "它完全没反应！$"

SootopolisCity_Text_TryingMeaninglessToPokemon:
	.string "盖欧卡和固拉多都\n"
	.string "飞到不知道哪儿去了。\p"
	.string "丰缘的天气也回到了\n"
	.string "正常状态……\p"
	.string "{PLAYER}，我被野心\n"
	.string "蒙住了眼。\p"
	.string "我太沉迷于扩张海洋的\n"
	.string "梦想，没想过会给\l"
	.string "世界带来这么大的混乱……\p"
	.string "我知道我们短时间内\n"
	.string "有很多分歧，可我\l"
	.string "真心为我的行为道歉，\l"
	.string "也很感激你能阻止我，\l"
	.string "{PLAYER}。$"

SootopolisCity_Text_InvolvedWithCrisisComeWithMe:
	.string "那些打架的宝可梦……\n"
	.string "固拉多……还有盖欧卡……\p"
	.string "两只超古代宝可梦从\n"
	.string "长眠中苏醒了……\p"
	.string "现在它们正用失控的\n"
	.string "力量互相冲撞……\p"
	.string "……{PLAYER}。\p"
	.string "你此刻来到这里，我就\n"
	.string "当作你准备好更深地\l"
	.string "卷入这场危机。\p"
	.string "那么，有个人我想让\n"
	.string "你见一见。\p"
	.string "请跟我来。$"

SootopolisCity_Text_DoesThisMakeYourFearPokemon:
	.string "听我说，{PLAYER}。\p"
	.string "看到固拉多和盖欧卡，\n"
	.string "你会觉得宝可梦\l"
	.string "很可怕吗？\p"
	.string "可那不是真的。\n"
	.string "宝可梦其实更……\p"
	.string "……我为什么问你这些？\n"
	.string "你已经知道了。$"

SootopolisCity_Text_HereWereAreHelpWallace:
	.string "好，我们到了！\p"
	.string "里面有个叫亚当的人。\p"
	.string "我觉得你有帮助他的\n"
	.string "能力……$"

SootopolisCity_Text_KnowWhatsNeededToHelpHim:
	.string "我觉得你有帮助他的\n"
	.string "能力……$"

SootopolisCity_Text_NeverBeenToSkyPillar:
	.string "天空之柱……\p"
	.string "我从没去过那里。\n"
	.string "不知道它在哪儿？$"

SootopolisCity_Text_SoThatsRayquaza:
	.string "{PLAYER}……\p"
	.string "真不敢相信，源治像你\n"
	.string "说的那样，一直\l"
	.string "在利用我们。\p"
	.string "很抱歉我没看出这一点，\n"
	.string "而且他捕获并利用\l"
	.string "超级烈空坐时，我\l"
	.string "甚至没能来帮你……\p"
	.string "你独自就打败了他，\n"
	.string "真是了不起。\p"
	.string "就像亚当说的，你是\n"
	.string "丰缘人民的英雄……\l"
	.string "不，是全世界的英雄！\p"
	.string "要不是你阻止了源治，\n"
	.string "把烈空坐带到这里，\l"
	.string "不知道会造成多大\l"
	.string "的破坏？\p"
	.string "{PLAYER}，你真是个\n"
	.string "特别的训练家，\l"
	.string "我真心感谢你。$"

SootopolisCity_Text_MaxieArchieLeft:
	.string "看来马克西和阿库亚\n"
	.string "都去了什么地方。\p"
	.string "也许他们去送神火山\n"
	.string "归还宝珠了……\p"
	.string "总之！现在四天王得\n"
	.string "找人接替源治，\l"
	.string "看来你的朋友小光\l"
	.string "心里有人选可以帮我们。$"

SootopolisCity_Text_DawnMaxieArchieLeft:
	.string "祝你在阿丹那里\n"
	.string "顺利，{PLAYER}！\p"
	.string "希望我在神奥的朋友\n"
	.string "能在你打赢他、\l"
	.string "一路冲进四天王之前\l"
	.string "赶到！$"

SootopolisCity_Text_HaventYouScaledSkyPillar:
	.string "哦？\n"
	.string "{PLAYER}？\p"
	.string "你还没爬上\n"
	.string "天空之柱吗？\p"
	.string "我相信你一定能到达\n"
	.string "天空之柱的顶端……$"

SootopolisCity_Text_AquaMagmaDidntMeanHarm:
	.string "熔岩队和水舰队的\n"
	.string "老大，我觉得他们\l"
	.string "本来没有恶意。\p"
	.string "听听他们自己怎么说，\n"
	.string "也无妨。$"

SootopolisCity_Text_ThankYouForHelpAcceptThis:
	.string "{PLAYER}……\n"
	.string "我的眼睛没骗我。\p"
	.string "多亏你的帮助，琉璃市……\n"
	.string "不，整个丰缘都得救了。\p"
	.string "我代表所有人\n"
	.string "谢谢你。\p"
	.string "这是我的心意。\n"
	.string "请收下。$"

SootopolisCity_Text_ExplainWaterfallGoToGym:
	.string "那个秘传学习器里是\n"
	.string "攀瀑。\p"
	.string "有了雨滴徽章，学会那个\n"
	.string "秘传招式的宝可梦\l"
	.string "就能硬冲上瀑布。\p"
	.string "雨滴徽章在哪儿拿？\n"
	.string "你知道吧？\p"
	.string "没错！你得打败\n"
	.string "琉璃道馆的馆主。\p"
	.string "准备好了，就从\n"
	.string "那扇门进去。\p"
	.string "不过提醒你，我的师父\n"
	.string "最近换了风格……\p"
	.string "他教会我关于水属性\n"
	.string "宝可梦的一切，可现在\l"
	.string "他成了妖精属性的\l"
	.string "高手！$"

SootopolisCity_Text_DazzledByMentor:
	.string "我相信你一定会被\n"
	.string "我师父那美得惊人的\l"
	.string "战斗方式迷住。\p"
	.string "他的妖精属性宝可梦\n"
	.string "已经比他以前的水属性\l"
	.string "更强了！$"

	SootopolisCity_Text_WelcomeBack:
	.string "米可利：{PLAYER}！你平安\n"
	.string "回来了，我太放心了。\p"
	.string "你到天空之柱\n"
	.string "顶端时发生了什么？$"


SootopolisCity_Text_PlayerAnswers:
	.string "… … … … … …\n"
	.string "… … … … … …$"

SootopolisCity_Text_WallaceCantBelieve:
	.string "阿丹：哦，天啊……\p"
	.string "这场危机我没有像你们\n"
	.string "那样参与，不过\l"
	.string "我和源治认识很久了。\p"
	.string "真不敢相信他会做\n"
	.string "那种事，也不敢相信\l"
	.string "我没能来帮你，{PLAYER}。\p"
	.string "不过看来你不需要我帮，\n"
	.string "你一个人就挫败了\l"
	.string "他的计划！\p"
	.string "为了阻止源治，并把\n"
	.string "烈空坐带来平息其他\l"
	.string "超古代宝可梦的怒火，\l"
	.string "{PLAYER}，我衷心\l"
	.string "感谢你！$"

SootopolisCity_Text_YouAreAHero:
	.string "对整个丰缘地区来说，\n"
	.string "你简直就是英雄！$"


SootopolisCity_TextRambled:
	.string "阿丹：我说得太久了，\n"
	.string "你一定想听听这里的\l"
	.string "其他人怎么说！$"

`

script SootopolisCity_EventScript_SetExpertBlockCaveEntrance {
	if(!flag(FLAG_IS_CHAMPION))
	{
		setobjectxyperm(LOCALID_EXPERT, 31, 18)
	}
	else
	{
		setobjectxyperm(LOCALID_EXPERT, 30, 18)
		setobjectmovementtype(LOCALID_EXPERT, MOVEMENT_TYPE_FACE_RIGHT)
	}
	return
}
