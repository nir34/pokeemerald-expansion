raw `
.set LOCALID_NURSE, 1

OldaleTown_PokemonCenter_1F_MapScripts::
	map_script MAP_SCRIPT_ON_TRANSITION, OldaleTown_PokemonCenter_1F_OnTransition
	map_script MAP_SCRIPT_ON_RESUME, CableClub_OnResume
	.byte 0

OldaleTown_PokemonCenter_1F_OnTransition:
	setrespawn HEAL_LOCATION_OLDALE_TOWN
	call Common_EventScript_UpdateBrineyLocation
	end

OldaleTown_PokemonCenter_1F_EventScript_Nurse::
	setvar VAR_0x800B, LOCALID_NURSE
	call Common_EventScript_PkmnCenterNurse
	waitmessage
	waitbuttonpress
	release
	end

OldaleTown_PokemonCenter_1F_EventScript_Gentleman::
	msgbox OldaleTown_PokemonCenter_1F_Text_TrainersCanUsePC, MSGBOX_NPC
	end

OldaleTown_PokemonCenter_1F_EventScript_Boy::
	msgbox OldaleTown_PokemonCenter_1F_Text_PokemonCentersAreGreat, MSGBOX_NPC
	end

OldaleTown_PokemonCenter_1F_EventScript_Girl::
	lock
	faceplayer
	goto_if_set FLAG_SYS_POKEDEX_GET, OldaleTown_PokemonCenter_1F_EventScript_WirelessClubAvailable
	msgbox OldaleTown_PokemonCenter_1F_Text_WirelessClubNotAvailable, MSGBOX_DEFAULT
	release
	end

OldaleTown_PokemonCenter_1F_EventScript_WirelessClubAvailable::
	msgbox OldaleTown_PokemonCenter_1F_Text_TradedInWirelessClub, MSGBOX_DEFAULT
	release
	end

OldaleTown_PokemonCenter_1F_EventScript_EggMan::
	lock
	faceplayer
	goto_if_unset FLAG_SYS_DEXNAV_GET, OldaleTown_PokemonCenter_1F_EventScript_NotReadyForEggYet
	goto_if_set FLAG_RECEIVED_OLDALE_EGG, OldaleTown_PokemonCenter_1F_EventScript_ReceivedEgg
	msgbox OldaleTown_PokemonCenter_1F_Text_HaveEggWillYouTakeIt, MSGBOX_YESNO
	goto_if_eq VAR_RESULT, NO, OldaleTown_PokemonCenter_1F_EventScript_DeclineEgg
	getpartysize
	goto_if_eq VAR_RESULT, PARTY_SIZE, OldaleTown_PokemonCenter_1F_EventScript_NoRoomForEgg
	msgbox OldaleTown_PokemonCenter_1F_Text_HopeYoullWalkPlentyWithEgg, MSGBOX_DEFAULT
	setflag FLAG_RECEIVED_OLDALE_EGG
	playfanfare MUS_OBTAIN_ITEM
	message OldaleTown_PokemonCenter_1F_Text_ReceivedTheEgg
	waitfanfare
	giveegg SPECIES_SENTRET
	release
	end

OldaleTown_PokemonCenter_1F_EventScript_NotReadyForEggYet::
	msgbox OldaleTown_PokemonCenter_1F_Text_NotReadyForEggYet, MSGBOX_DEFAULT
	release
	end

OldaleTown_PokemonCenter_1F_EventScript_ReceivedEgg::
	msgbox OldaleTown_PokemonCenter_1F_Text_EverySoOftenEggFoundAtDayCare, MSGBOX_DEFAULT
	release
	end

OldaleTown_PokemonCenter_1F_EventScript_DeclineEgg::
	msgbox OldaleTown_PokemonCenter_1F_Text_AsYouWishThen, MSGBOX_DEFAULT
	release
	end

OldaleTown_PokemonCenter_1F_EventScript_NoRoomForEgg::
	msgbox OldaleTown_PokemonCenter_1F_Text_NoRoomForThisEgg, MSGBOX_DEFAULT
	release
	end

OldaleTown_PokemonCenter_1F_Text_NotReadyForEggYet:
	.string "我这里有个蛋，想找个\n"
	.string "够有经验的训练家\l"
	.string "拿去孵化。\p"
	.string "你好像经验还不够；\n"
	.string "等你拿到宝可梦图鉴\l"
	.string "再来吧。$"

OldaleTown_PokemonCenter_1F_Text_EverySoOftenEggFoundAtDayCare:
	.string "我真不知道那个蛋里\n"
	.string "面是什么。$"

OldaleTown_PokemonCenter_1F_Text_HaveEggWillYouTakeIt:
	.string "我这里有个蛋，可我年纪\n"
	.string "太大了，没法跑那么久\l"
	.string "把它孵出来。\p"
	.string "我看你有宝可梦图鉴，\n"
	.string "一定是个值得信任的\l"
	.string "训练家。\p"
	.string "你愿意把这个蛋\n"
	.string "拿走吗？$"

OldaleTown_PokemonCenter_1F_Text_AsYouWishThen:
	.string "那就随你吧……\p"
	.string "要是你回心转意想孵\n"
	.string "这个蛋，我一直在这儿。$"

OldaleTown_PokemonCenter_1F_Text_NoRoomForThisEgg:
	.string "哦？你的宝可梦太多了。\n"
	.string "没地方放这个蛋……$"

OldaleTown_PokemonCenter_1F_Text_HopeYoullWalkPlentyWithEgg:
	.string "好！希望你带着那个蛋\n"
	.string "多走走！$"

OldaleTown_PokemonCenter_1F_Text_ReceivedTheEgg:
	.string "{PLAYER}得到了蛋。$"

OldaleTown_PokemonCenter_1F_Text_TrainersCanUsePC:
	.string "角落那台电脑，任何\n"
	.string "宝可梦训练家都能用。\p"
	.string "当然，这也意味着\n"
	.string "你也随时可以用。$"

OldaleTown_PokemonCenter_1F_Text_PokemonCentersAreGreat:
	.string "宝可梦中心真棒！\p"
	.string "服务想用多少次都行，\n"
	.string "而且全都免费。\l"
	.string "你完全不用操心！$"

OldaleTown_PokemonCenter_1F_Text_WirelessClubNotAvailable:
	.string "二楼新开了个\n"
	.string "宝可梦无线俱乐部。\p"
	.string "不过他们说还在\n"
	.string "调整中。$"

OldaleTown_PokemonCenter_1F_Text_TradedInWirelessClub:
	.string "二楼新开了个\n"
	.string "宝可梦无线俱乐部。\p"
	.string "我马上就交换了宝可梦。$"

`

script OldDaleTown_PokemonCenter_EventScript_SecondNurse {
    lock
    faceplayer
	msgbox(HelloHowCanIHelp)
	dynmultipush("性格更改", 0)
	dynmultipush("性别互换", 1)
	if(!flag(FLAG_MET_REGULAR_MOVE_TUTOR)){
		dynmultipush("{COLOR WHITE}{SHADOW LIGHT_GRAY}把宝可梦设为上限等级{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}", 2)
	}
	else{
		dynmultipush("把宝可梦设为上限等级", 2)
	}

	if(!flag(FLAG_MET_REGULAR_MOVE_TUTOR)){
		dynmultipush("{COLOR WHITE}{SHADOW LIGHT_GRAY}把盒子设为上限等级{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}", 3)
	}
	else{
		dynmultipush("把盒子设为上限等级", 3)
	}
	
	dynmultipush("全员倒下计数", 4)
	dynmultipush("模式信息", 5)
    dynmultipush("取消", MULTI_B_PRESSED)
    // setting initial selected to a non-existant ID will always have it point to the first option
	//.macro dynmultistack left:req, top:req, ignoreBPress:req, maxBeforeScroll:req, shouldSort:req, initialSelected:req, callbacks:req
	dynmultistack(0, 0, FALSE, 6, FALSE, 0, DYN_MULTICHOICE_CB_NONE)

    if (var(VAR_RESULT) == MULTI_B_PRESSED) 
	{
		goto(OldDaleTown_PokemonCenter_EventScript_SecondNurseNo)
	}

	if (var(VAR_RESULT) == 0)
	{
		goto(OldDaleTown_PokemonCenter_EventScript_SecondNurse_ChangeNature)
	}

	if (var(VAR_RESULT) == 1)
	{
		goto(OldDaleTown_PokemonCenter_EventScript_SecondNurse_SwapGender)
	}

	if (var(VAR_RESULT) == 2)
	{
		goto(OldDaleTown_PokemonCenter_EventScript_SecondNurse_SetToLevelCap)	
	}

	if (var(VAR_RESULT) == 3)
	{
		goto(OldDaleTown_PokemonCenter_EventScript_SecondNurse_SetBoxToLevelCap)	
	}

	if (var(VAR_RESULT) == 4)
	{
		goto(OldDaleTown_PokemonCenter_EventScript_SecondNurse_GetWhiteOutCount)	
	}

	if (var(VAR_RESULT) == 5)
	{
		goto(OldDaleTown_PokemonCenter_EventScript_SecondNurse_ModeInfo)	
	}
}

script OldDaleTown_PokemonCenter_EventScript_SecondNurse_ChangeNature{
	msgbox("哪只宝可梦？")
	special(ChoosePartyMon)
	waitstate
	if(var(VAR_0x8004) == PARTY_NOTHING_CHOSEN)
	{
		goto(OldDaleTown_PokemonCenter_EventScript_SecondNurseNo)
	}
	specialvar(VAR_RESULT, ScriptGetPartyMonSpecies)
	if(var(VAR_RESULT) == SPECIES_EGG) {
		msgbox("蛋的性格\n我改不了。")
		release
		end
	}
	special(BufferMonNickname)
	msgbox("{STR_VAR_1}适合哪种\n性格？")
	if (var(VAR_NATURE_ORDER) == 1) {
	// Attack boosting natures (+Atk -Atk, +Atk -Def, +Atk -Speed, +Atk -SpAtk, +Atk -SpDef)
	dynmultipush("孤僻         {COLOR RED}{SHADOW LIGHT_RED}+攻击{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}/{COLOR BLUE}{SHADOW LIGHT_BLUE}-防御     ", NATURE_LONELY)
	dynmultipush("勇敢           {COLOR RED}{SHADOW LIGHT_RED}+攻击{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}/{COLOR BLUE}{SHADOW LIGHT_BLUE}-速度     ", NATURE_BRAVE)
	dynmultipush("固执       {COLOR RED}{SHADOW LIGHT_RED}+攻击{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}/{COLOR BLUE}{SHADOW LIGHT_BLUE}-特攻", NATURE_ADAMANT)
	dynmultipush("调皮      {COLOR RED}{SHADOW LIGHT_RED}+攻击{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}/{COLOR BLUE}{SHADOW LIGHT_BLUE}-特防   ", NATURE_NAUGHTY)

	// Defense boosting natures (+Def -Atk, +Def -Def, +Def -Speed, +Def -SpAtk, +Def -SpDef)
	dynmultipush("大胆             {COLOR RED}{SHADOW LIGHT_RED}+防御{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}/{COLOR BLUE}{SHADOW LIGHT_BLUE}-攻击       ", NATURE_BOLD)
	dynmultipush("悠闲       {COLOR RED}{SHADOW LIGHT_RED}+防御{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}/{COLOR BLUE}{SHADOW LIGHT_BLUE}-速度   ", NATURE_RELAXED)
	dynmultipush("顽皮         {COLOR RED}{SHADOW LIGHT_RED}+防御{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}/{COLOR BLUE}{SHADOW LIGHT_BLUE}-特攻   ", NATURE_IMPISH)
	dynmultipush("乐天              {COLOR RED}{SHADOW LIGHT_RED}+防御{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}/{COLOR BLUE}{SHADOW LIGHT_BLUE}-特防   ", NATURE_LAX)

	// Speed boosting natures (+Speed -Atk, +Speed -Def, +Speed -Speed, +Speed -SpAtk, +Speed -SpDef)
	dynmultipush("胆小           {COLOR RED}{SHADOW LIGHT_RED}+速度{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}/{COLOR BLUE}{SHADOW LIGHT_BLUE}-攻击   ", NATURE_TIMID)
	dynmultipush("急躁          {COLOR RED}{SHADOW LIGHT_RED}+速度{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}/{COLOR BLUE}{SHADOW LIGHT_BLUE}-防御     ", NATURE_HASTY)
	dynmultipush("爽朗           {COLOR RED}{SHADOW LIGHT_RED}+速度{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}/{COLOR BLUE}{SHADOW LIGHT_BLUE}-特攻   ", NATURE_JOLLY)
	dynmultipush("天真          {COLOR RED}{SHADOW LIGHT_RED}+速度{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}/{COLOR BLUE}{SHADOW LIGHT_BLUE}-特防 ", NATURE_NAIVE)

	// Special Attack boosting natures (+SpAtk -Atk, +SpAtk -Def, +SpAtk -Speed, +SpAtk -SpAtk, +SpAtk -SpDef)
	dynmultipush("内敛        {COLOR RED}{SHADOW LIGHT_RED}+特攻{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}/{COLOR BLUE}{SHADOW LIGHT_BLUE}-攻击   ", NATURE_MODEST)
	dynmultipush("慢吞吞             {COLOR RED}{SHADOW LIGHT_RED}+特攻{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}/{COLOR BLUE}{SHADOW LIGHT_BLUE}-防御   ", NATURE_MILD)
	dynmultipush("冷静          {COLOR RED}{SHADOW LIGHT_RED}+特攻{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}/{COLOR BLUE}{SHADOW LIGHT_BLUE}-速度 ", NATURE_QUIET)
	dynmultipush("马虎            {COLOR RED}{SHADOW LIGHT_RED}+特攻{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}/{COLOR BLUE}{SHADOW LIGHT_BLUE}-特防 ", NATURE_RASH)

	// Special Defense boosting natures (+SpDef -Atk, +SpDef -Def, +SpDef -Speed, +SpDef -SpAtk, +SpDef -SpDef)
	dynmultipush("温和             {COLOR RED}{SHADOW LIGHT_RED}+特防{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}/{COLOR BLUE}{SHADOW LIGHT_BLUE}-攻击     ", NATURE_CALM)
	dynmultipush("温柔         {COLOR RED}{SHADOW LIGHT_RED}+特防{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}/{COLOR BLUE}{SHADOW LIGHT_BLUE}-防御     ", NATURE_GENTLE)
	dynmultipush("狂妄          {COLOR RED}{SHADOW LIGHT_RED}+特防{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}/{COLOR BLUE}{SHADOW LIGHT_BLUE}-速度 ", NATURE_SASSY)
	dynmultipush("慎重       {COLOR RED}{SHADOW LIGHT_RED}+特防{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}/{COLOR BLUE}{SHADOW LIGHT_BLUE}-特攻   ", NATURE_CAREFUL)

	// Neutral natures
	dynmultipush("害羞            中性            ", NATURE_BASHFUL)
	dynmultipush("坦率            中性            ", NATURE_DOCILE)
	dynmultipush("勤奋            中性            ", NATURE_HARDY)
	dynmultipush("浮躁            中性            ", NATURE_QUIRKY)
	dynmultipush("认真            中性            ", NATURE_SERIOUS)	

	} 
	elif(var(VAR_NATURE_ORDER) == 2)
	{
    dynmultipush("固执       {COLOR RED}{SHADOW LIGHT_RED}+攻击{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}/{COLOR BLUE}{SHADOW LIGHT_BLUE}-特攻", NATURE_ADAMANT)
    dynmultipush("内敛        {COLOR RED}{SHADOW LIGHT_RED}+特攻{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}/{COLOR BLUE}{SHADOW LIGHT_BLUE}-攻击   ", NATURE_MODEST)
    dynmultipush("胆小           {COLOR RED}{SHADOW LIGHT_RED}+速度{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}/{COLOR BLUE}{SHADOW LIGHT_BLUE}-攻击   ", NATURE_TIMID)
    dynmultipush("爽朗           {COLOR RED}{SHADOW LIGHT_RED}+速度{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}/{COLOR BLUE}{SHADOW LIGHT_BLUE}-特攻   ", NATURE_JOLLY)
    dynmultipush("急躁          {COLOR RED}{SHADOW LIGHT_RED}+速度{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}/{COLOR BLUE}{SHADOW LIGHT_BLUE}-防御     ", NATURE_HASTY)
    dynmultipush("天真          {COLOR RED}{SHADOW LIGHT_RED}+速度{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}/{COLOR BLUE}{SHADOW LIGHT_BLUE}-特防 ", NATURE_NAIVE)
    dynmultipush("慢吞吞             {COLOR RED}{SHADOW LIGHT_RED}+特攻{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}/{COLOR BLUE}{SHADOW LIGHT_BLUE}-防御   ", NATURE_MILD)
    dynmultipush("调皮      {COLOR RED}{SHADOW LIGHT_RED}+攻击{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}/{COLOR BLUE}{SHADOW LIGHT_BLUE}-特防   ", NATURE_NAUGHTY)
    dynmultipush("马虎            {COLOR RED}{SHADOW LIGHT_RED}+特攻{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}/{COLOR BLUE}{SHADOW LIGHT_BLUE}-特防 ", NATURE_RASH)
    dynmultipush("孤僻         {COLOR RED}{SHADOW LIGHT_RED}+攻击{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}/{COLOR BLUE}{SHADOW LIGHT_BLUE}-防御     ", NATURE_LONELY)
    dynmultipush("勇敢           {COLOR RED}{SHADOW LIGHT_RED}+攻击{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}/{COLOR BLUE}{SHADOW LIGHT_BLUE}-速度     ", NATURE_BRAVE)
    dynmultipush("冷静          {COLOR RED}{SHADOW LIGHT_RED}+特攻{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}/{COLOR BLUE}{SHADOW LIGHT_BLUE}-速度 ", NATURE_QUIET)
    dynmultipush("温和             {COLOR RED}{SHADOW LIGHT_RED}+特防{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}/{COLOR BLUE}{SHADOW LIGHT_BLUE}-攻击     ", NATURE_CALM)
    dynmultipush("顽皮         {COLOR RED}{SHADOW LIGHT_RED}+防御{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}/{COLOR BLUE}{SHADOW LIGHT_BLUE}-特攻   ", NATURE_IMPISH)
    dynmultipush("狂妄          {COLOR RED}{SHADOW LIGHT_RED}+特防{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}/{COLOR BLUE}{SHADOW LIGHT_BLUE}-速度 ", NATURE_SASSY)
    dynmultipush("慎重       {COLOR RED}{SHADOW LIGHT_RED}+特防{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}/{COLOR BLUE}{SHADOW LIGHT_BLUE}-特攻   ", NATURE_CAREFUL)
    dynmultipush("悠闲       {COLOR RED}{SHADOW LIGHT_RED}+防御{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}/{COLOR BLUE}{SHADOW LIGHT_BLUE}-速度   ", NATURE_RELAXED)
    dynmultipush("大胆             {COLOR RED}{SHADOW LIGHT_RED}+防御{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}/{COLOR BLUE}{SHADOW LIGHT_BLUE}-攻击       ", NATURE_BOLD)
    dynmultipush("害羞            中性            ", NATURE_BASHFUL)
    dynmultipush("乐天              {COLOR RED}{SHADOW LIGHT_RED}+防御{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}/{COLOR BLUE}{SHADOW LIGHT_BLUE}-特防   ", NATURE_LAX)
    dynmultipush("温柔         {COLOR RED}{SHADOW LIGHT_RED}+特防{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}/{COLOR BLUE}{SHADOW LIGHT_BLUE}-防御     ", NATURE_GENTLE)
    dynmultipush("坦率            中性            ", NATURE_DOCILE)
    dynmultipush("勤奋            中性            ", NATURE_HARDY)
    dynmultipush("浮躁            中性            ", NATURE_QUIRKY)
    dynmultipush("认真            中性            ", NATURE_SERIOUS)
	} else {

	dynmultipush("固执       {COLOR RED}{SHADOW LIGHT_RED}+攻击{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}/{COLOR BLUE}{SHADOW LIGHT_BLUE}-特攻", NATURE_ADAMANT)
	dynmultipush("害羞            中性            ", NATURE_BASHFUL)
	dynmultipush("大胆             {COLOR RED}{SHADOW LIGHT_RED}+防御{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}/{COLOR BLUE}{SHADOW LIGHT_BLUE}-攻击       ", NATURE_BOLD)
	dynmultipush("勇敢           {COLOR RED}{SHADOW LIGHT_RED}+攻击{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}/{COLOR BLUE}{SHADOW LIGHT_BLUE}-速度     ", NATURE_BRAVE)
	dynmultipush("温和             {COLOR RED}{SHADOW LIGHT_RED}+特防{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}/{COLOR BLUE}{SHADOW LIGHT_BLUE}-攻击     ", NATURE_CALM)
	dynmultipush("慎重       {COLOR RED}{SHADOW LIGHT_RED}+特防{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}/{COLOR BLUE}{SHADOW LIGHT_BLUE}-特攻   ", NATURE_CAREFUL)
	dynmultipush("坦率            中性            ", NATURE_DOCILE)
	dynmultipush("温柔         {COLOR RED}{SHADOW LIGHT_RED}+特防{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}/{COLOR BLUE}{SHADOW LIGHT_BLUE}-防御     ", NATURE_GENTLE)
	dynmultipush("勤奋            中性            ", NATURE_HARDY)
	dynmultipush("急躁          {COLOR RED}{SHADOW LIGHT_RED}+速度{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}/{COLOR BLUE}{SHADOW LIGHT_BLUE}-防御     ", NATURE_HASTY)
	dynmultipush("顽皮         {COLOR RED}{SHADOW LIGHT_RED}+防御{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}/{COLOR BLUE}{SHADOW LIGHT_BLUE}-特攻   ", NATURE_IMPISH)
	dynmultipush("爽朗           {COLOR RED}{SHADOW LIGHT_RED}+速度{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}/{COLOR BLUE}{SHADOW LIGHT_BLUE}-特攻   ", NATURE_JOLLY)
	dynmultipush("乐天              {COLOR RED}{SHADOW LIGHT_RED}+防御{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}/{COLOR BLUE}{SHADOW LIGHT_BLUE}-特防   ", NATURE_LAX)
	dynmultipush("孤僻         {COLOR RED}{SHADOW LIGHT_RED}+攻击{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}/{COLOR BLUE}{SHADOW LIGHT_BLUE}-防御     ", NATURE_LONELY)
	dynmultipush("慢吞吞             {COLOR RED}{SHADOW LIGHT_RED}+特攻{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}/{COLOR BLUE}{SHADOW LIGHT_BLUE}-防御   ", NATURE_MILD)
	dynmultipush("内敛        {COLOR RED}{SHADOW LIGHT_RED}+特攻{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}/{COLOR BLUE}{SHADOW LIGHT_BLUE}-攻击   ", NATURE_MODEST)
	dynmultipush("天真          {COLOR RED}{SHADOW LIGHT_RED}+速度{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}/{COLOR BLUE}{SHADOW LIGHT_BLUE}-特防 ", NATURE_NAIVE)
	dynmultipush("调皮      {COLOR RED}{SHADOW LIGHT_RED}+攻击{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}/{COLOR BLUE}{SHADOW LIGHT_BLUE}-特防   ", NATURE_NAUGHTY)
	dynmultipush("冷静          {COLOR RED}{SHADOW LIGHT_RED}+特攻{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}/{COLOR BLUE}{SHADOW LIGHT_BLUE}-速度 ", NATURE_QUIET)
	dynmultipush("浮躁            中性            ", NATURE_QUIRKY)
	dynmultipush("马虎            {COLOR RED}{SHADOW LIGHT_RED}+特攻{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}/{COLOR BLUE}{SHADOW LIGHT_BLUE}-特防 ", NATURE_RASH)
	dynmultipush("悠闲       {COLOR RED}{SHADOW LIGHT_RED}+防御{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}/{COLOR BLUE}{SHADOW LIGHT_BLUE}-速度   ", NATURE_RELAXED)
	dynmultipush("狂妄          {COLOR RED}{SHADOW LIGHT_RED}+特防{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}/{COLOR BLUE}{SHADOW LIGHT_BLUE}-速度 ", NATURE_SASSY)
	dynmultipush("认真            中性            ", NATURE_SERIOUS)
	dynmultipush("胆小           {COLOR RED}{SHADOW LIGHT_RED}+速度{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}/{COLOR BLUE}{SHADOW LIGHT_BLUE}-攻击   ", NATURE_TIMID)
	}
	dynmultipush("取消", MULTI_B_PRESSED)
	// // setting initial selected to a non-existant ID will always have it point to the first option
	dynmultistack(0, 0, FALSE, 6, FALSE, 25, DYN_MULTICHOICE_CB_NONE)

	if (var(VAR_RESULT) == MULTI_B_PRESSED) 
	{
		goto(OldDaleTown_PokemonCenter_EventScript_SecondNurseNo)
	}

	copyvar(VAR_0x8005, VAR_RESULT)
	buffernaturename(STR_VAR_2, VAR_RESULT)
	msgbox(AreYouSureNatureChange, MSGBOX_YESNO)

	if(var(VAR_RESULT) == NO) 
	{
		goto(OldDaleTown_PokemonCenter_EventScript_SecondNurseNo)
	}

	msgbox("很好。我这就开始！")
	fadescreen(FADE_TO_BLACK)
	special(ChangeMonNature)
	playfanfare(MUS_OBTAIN_ITEM)
	waitfanfare
	closemessage
	fadescreen(FADE_FROM_BLACK)
	msgbox("{STR_VAR_1}的性格\n已经改变。若还需要别的，\l请再来。")
	release
	end
}


script OldDaleTown_PokemonCenter_EventScript_SecondNurse_SwapGender{
	msgbox(GenderSwapInfo)
	special(ChoosePartyMon)
	waitstate
	if(var(VAR_0x8004) == PARTY_NOTHING_CHOSEN)
	{
		goto(OldDaleTown_PokemonCenter_EventScript_SecondNurseNo)
	}
	specialvar(VAR_RESULT, ScriptGetPartyMonSpecies)
	switch (var(VAR_RESULT)) {
        case SPECIES_SNORUNT:
		case SPECIES_RALTS:
        case SPECIES_KIRLIA:
		case SPECIES_SALANDIT:
        case SPECIES_BURMY_PLANT:
		case SPECIES_BURMY_SANDY:
		case SPECIES_BURMY_TRASH:
		case SPECIES_COMBEE:
        case SPECIES_ESPURR:
		case SPECIES_BASCULIN_RED_STRIPED:
		case SPECIES_BASCULIN_BLUE_STRIPED:
		case SPECIES_BASCULIN_WHITE_STRIPED:
        case SPECIES_LECHONK:
			special(BufferMonNickname)
			msgbox(AreYouSureGenderSwap, MSGBOX_YESNO)
			if(var(VAR_RESULT) == NO) 
			{
				goto(OldDaleTown_PokemonCenter_EventScript_SecondNurseNo)
			}
            msgbox("很好。我这就开始！")
			fadescreen(FADE_TO_BLACK)
			special(ChangeMonGender)
			playfanfare(MUS_OBTAIN_ITEM)
			waitfanfare
			closemessage
			fadescreen(FADE_FROM_BLACK)
			msgbox("{STR_VAR_1}的性别\n已经互换。若还需要别的，\l请再来。")

		case SPECIES_EGG:
			msgbox("蛋的性别\n我换不了。")

        default:
            msgbox("抱歉，那只宝可梦的\n性别我换不了。")
    }
	release
	end
}

script OldDaleTown_PokemonCenter_EventScript_SecondNurseNo {
    msgbox("我明白了。若还需要别的，\n请再来。")
    release
    end
}

script OldDaleTown_PokemonCenter_EventScript_SecondNurse_SetToLevelCap{
	if(!flag(FLAG_MET_REGULAR_MOVE_TUTOR))
	{
		msgbox(FeatureAvailableAfterMoveTutor)
		release
		end
	}
	specialvar(VAR_0x8006, GetLevelCapForText)
	buffernumberstring(STR_VAR_3, VAR_0x8006)
	msgbox(TellLevelCapAndAsk, MSGBOX_YESNO)
	if(var(VAR_RESULT) == NO) 
	{
		goto(OldDaleTown_PokemonCenter_EventScript_SecondNurseNo)
	}
	msgbox("哪只宝可梦？")
	special(ChoosePartyMon)
	waitstate
	if(var(VAR_0x8004) == PARTY_NOTHING_CHOSEN)
	{
		goto(OldDaleTown_PokemonCenter_EventScript_SecondNurseNo)
	}
	specialvar(VAR_RESULT, ScriptGetPartyMonSpecies)
	if(var(VAR_RESULT) == SPECIES_EGG) {
		msgbox("蛋不能升级。")
		release
		end
	}
	specialvar(VAR_0x8007, ScriptGetPartyMonLevel)
	compare(VAR_0x8007, VAR_0x8006)
	goto_if_eq(OldDaleTown_PokemonCenter_EventScript_SecondNurse_MonAlreadyAtCap)
	special(BufferMonNickname)
	msgbox(AreYouSureLevelCap, MSGBOX_YESNO)
	if(var(VAR_RESULT) == NO) 
	{
		goto(OldDaleTown_PokemonCenter_EventScript_SecondNurseNo)
	}
	msgbox("很好。我这就开始！")
	fadescreen(FADE_TO_BLACK)
	special(SetMonToLevelCap)
	playfanfare(MUS_OBTAIN_ITEM)
	waitfanfare
	closemessage
	fadescreen(FADE_FROM_BLACK)
	msgbox(MonHasBeenSetToLevelCap)
	release
	end
}

script OldDaleTown_PokemonCenter_EventScript_SecondNurse_SetBoxToLevelCap{
	if(!flag(FLAG_MET_REGULAR_MOVE_TUTOR))
	{
		msgbox(FeatureAvailableAfterMoveTutor)
		release
		end
	}
	specialvar(VAR_0x8006, GetLevelCapForText)
	buffernumberstring(STR_VAR_3, VAR_0x8006)
	msgbox(TellLevelCapAndAskBox, MSGBOX_YESNO)
	if(var(VAR_RESULT) == NO) 
	{
		goto(OldDaleTown_PokemonCenter_EventScript_SecondNurseNo)
	}
	msgbox(AreYouSureLevelCapBox, MSGBOX_YESNO)
	if(var(VAR_RESULT) == NO) 
	{
		goto(OldDaleTown_PokemonCenter_EventScript_SecondNurseNo)
	}
	msgbox("很好。我这就开始！")
	fadescreen(FADE_TO_BLACK)
	special(LevelBoxesToCap)
	playfanfare(MUS_OBTAIN_ITEM)
	waitfanfare
	closemessage
	fadescreen(FADE_FROM_BLACK)
	msgbox(BoxHasBeenSetToLevelCap)
	release
	end
}

script OldDaleTown_PokemonCenter_EventScript_SecondNurse_MonAlreadyAtCap{
	msgbox("那只宝可梦已经是{STR_VAR_3}级了。")
	release
	end
}

script OldDaleTown_PokemonCenter_EventScript_SecondNurse_GetWhiteOutCount{
	specialvar(VAR_RESULT, GetWhiteOutCountForText)
	if (var(VAR_RESULT) == 0)
	{
		msgbox("当前全员倒下次数：0")
	}
	else
	{
		buffernumberstring(STR_VAR_1, VAR_RESULT)
		msgbox("当前全员倒下次数：{STR_VAR_1}")
	}
	release
	end
}

script OldDaleTown_PokemonCenter_EventScript_SecondNurse_ModeInfo{
	msgbox(VersionNumber)

	if(flag(FLAG_MIN_GRINDING_MODE))
	{
		if(var(VAR_GAME_SETTING_DIFFICULTY_MODE) == GAME_SETTING_DIFFICULTY_EASY_MODE)
		{
			msgbox(EasyModeWithMgm)
		}
		else
		{
			msgbox(NormalModeWithMgm)
		}
	}
	else
	{
		if(var(VAR_GAME_SETTING_DIFFICULTY_MODE) == GAME_SETTING_DIFFICULTY_EASY_MODE)
		{
			msgbox(EasyMode)
		}
		else
		{
			msgbox(NormalMode)
		}
	}
	msgbox("随机化选项：")
	if(flag(FLAG_RANDOMIZER_ENABLED))
	{
		switch(var(VAR_RANDOMIZER_MODE))
		{
			case MON_RANDOM:
				msgbox("{COLOR GREEN}{SHADOW LIGHT_GREEN}普通种族")
			case MON_RANDOM_BST:
				msgbox("{COLOR GREEN}{SHADOW LIGHT_GREEN}强度缩放种族")
			case MON_RANDOM_LEGEND_AWARE:
				msgbox("{COLOR GREEN}{SHADOW LIGHT_GREEN}考虑传说的种族")
			default:
				msgbox("种族未随机化")
		}
	}
	if(flag(FLAG_RANDOM_ABILITIES_ENABLED))
	{
		msgbox("{COLOR GREEN}{SHADOW LIGHT_GREEN}特性")
	}
	if(flag(FLAG_RANDOM_LEARNSETS_ENABLED))
	{
		msgbox("{COLOR GREEN}{SHADOW LIGHT_GREEN}招式表")
	}
	if(!flag(FLAG_RANDOMIZER_ENABLED) && !flag(FLAG_RANDOM_ABILITIES_ENABLED) && !flag(FLAG_RANDOM_LEARNSETS_ENABLED))
	{
		msgbox("{COLOR RED}{SHADOW LIGHT_RED}无")
	}
	release
	end
}

