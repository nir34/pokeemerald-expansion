script NicknamePartyMon{
    msgbox("要起个昵称吗？", MSGBOX_YESNO)
    hidemonpic
    if(var(VAR_RESULT) == YES){
        call(Common_EventScript_GetGiftMonPartySlot)
        call(Common_EventScript_NameReceivedPartyMon)
    }
 
 
}
 
script NicknameBoxMon{
    msgbox("要起个昵称吗？", MSGBOX_YESNO)
    hidemonpic
    if(var(VAR_RESULT) == YES){
        call(Common_EventScript_NameReceivedBoxMon)
    }
    msgbox("已传送到电脑。")
}
 
text NewBirchsLab_NotChosen{
    "你没有选择这只宝可梦。"
}

text NewBirchsLab_NotYet{
    "还是先别碰这些！\p"
    "也许你该去和{RIVAL}谈谈。"
}

text NewBirchsLab_WelcomePlayerMale{
    "你好！我是小田卷博士，你\n"
    "就是{PLAYER}吧。你刚错过\l"
    "{RIVAL}，她刚才来过，拿了\l"
    "一只初始宝可梦就\l"
    "冲出去了。\p" 
    "我让她留意一位\n"
    "叫{PLAYER}的训练家，他刚\l"
    "搬到隔壁！\p"
    "希望你们俩能成为朋友，\n"
    "一起踏上新的宝可梦\l"
    "旅程。\p"
    "这样吧，我给你一只\n"
    "初始宝可梦，然后你若能用\l"
    "你的宝可梦打赢{RIVAL}，\l"
    "回来我就送你宝可梦图鉴！\p"
    "你选完我再告诉你她选了\n"
    "哪只，在你选之前就说\l"
    "可就不公平了！\p"
    "我可以让你从任意\n"
    "世代的初始宝可梦里选，\l"
    "想换的话就找我。"
}

