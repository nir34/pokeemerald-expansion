MauvilleCity_GameCorner_EventScript_NoCoinCase::
	msgbox MauvilleCity_GameCorner_Text_CantPlayWithNoCoinCase, MSGBOX_DEFAULT
	releaseall
	end

MauvilleCity_TMSales_EventScript_Saleswoman::
	lock
	faceplayer
	message gText_HowMayIServeYou
	waitmessage
	tmshop MauvilleCity_TMSales
	msgbox gText_PleaseComeAgain, MSGBOX_DEFAULT
	release
	end

	.align 2
MauvilleCity_TMSales:
	.2byte ITEM_TM_TOXIC
	.2byte ITEM_TM_TAUNT
	.2byte ITEM_TM_LIGHT_SCREEN
	.2byte ITEM_TM_PROTECT
	.2byte ITEM_TM_GIGA_DRAIN
	.2byte ITEM_TM_REFLECT
	.2byte ITEM_TM_REST
	.2byte ITEM_TM_LEECH_LIFE
	.2byte ITEM_TM_SILVER_WIND
	.2byte ITEM_TM_VENOSHOCK
	.2byte ITEM_TM_EXPLOSION
	.2byte ITEM_TM_SHADOW_CLAW
	.2byte ITEM_TM_DAZZLING_GLEAM
	.2byte ITEM_TM_PSYSHOCK
	.2byte ITEM_TM_GYRO_BALL
	.2byte ITEM_TM_ROCK_SLIDE
	.2byte ITEM_TM_SLEEP_TALK
	.2byte ITEM_TM_POISON_JAB
	.2byte ITEM_TM_DRAGON_TAIL
	.2byte ITEM_TM_SCORCHING_SANDS
	.2byte ITEM_TM_ICE_SPINNER
	.2byte ITEM_TM_SPIKES
	.2byte ITEM_TM_GRAVITY
	.2byte ITEM_NONE
	release
	end

MauvilleCity_GameCorner_Text_ThisIsMauvilleGameCorner:
	.string "这里是紫堇游戏城。$"

MauvilleCity_GameCorner_Text_NeedCoinCaseForCoins:
	.string "好，你是想要代币\n"
	.string "玩游戏？\p"
	.string "可你没有装代币的\n"
	.string "代币盒。$"

MauvilleCity_GameCorner_Text_WereYouLookingForCoins:
	.string "你在找代币？\p"
	.string "1000元换50枚代币。\n"
	.string "要换吗？$"

MauvilleCity_GameCorner_Text_ThankYouHereAreYourCoins:
	.string "非常感谢！\n"
	.string "这是你的代币！$"

MauvilleCity_GameCorner_Text_DontHaveEnoughMoney:
	.string "嗯……你好像没有\n"
	.string "足够的钱……$"

MauvilleCity_GameCorner_Text_CoinCaseIsFull:
	.string "哦？\n"
	.string "你的代币盒满了。$"

MauvilleCity_GameCorner_Text_DontNeedCoinsThen:
	.string "哦……那你不需要\n"
	.string "代币？祝冒险顺利！$"

MauvilleCity_GameCorner_Text_ExchangeCoinsForPrizes:
	.string "欢迎。\p"
	.string "你可以在这里用代币\n"
	.string "兑换奖品。$"

MauvilleCity_GameCorner_Text_WhichPrize:
	.string "你想要哪个奖品？$"

MauvilleCity_GameCorner_Text_SoYourChoiceIsTheTMX:
	.string "你的选择是\n"
	.string "{STR_VAR_1}{STR_VAR_2}？$"

MauvilleCity_GameCorner_Text_SendToYourHomePC:
	.string "谢谢！\n"
	.string "我们会送到你家里的电脑。$"

MauvilleCity_GameCorner_Text_NotEnoughCoins:
	.string "你的代币不够。$"

@ Unused
MauvilleCity_GameCorner_Text_NoRoomForPlacingDecor:
	.string "没有空位放置\n"
	.string "{STR_VAR_1}。$"

MauvilleCity_GameCorner_Text_OhIsThatSo:
	.string "哦，是这样吗？\n"
	.string "你得先攒点代币，\l"
	.string "再来这里。$"

MauvilleCity_GameCorner_Text_SoYourChoiceIsX:
	.string "你的选择是{STR_VAR_1}？$"

MauvilleCity_GameCorner_Text_HereYouGo:
	.string "给你！$"

@ Unused
MauvilleCity_GameCorner_Text_CantCarryAnyMore:
	.string "哦，你带不了\n"
	.string "更多了。$"

MauvilleCity_GameCorner_Text_GotTwoOfSameDollWantOne:
	.string "我弄错了，多拿了一个\n"
	.string "同样的玩偶。\p"
	.string "你要不要一个？$"

MauvilleCity_GameCorner_Text_HereYouGo2:
	.string "给你！$"

MauvilleCity_GameCorner_Text_YouWantItButNotNow:
	.string "嗯？\n"
	.string "你想要，可现在不方便？$"

MauvilleCity_GameCorner_Text_DontBeNegative:
	.string "哦，别这么消极！\n"
	.string "这个给你！$"

MauvilleCity_GameCorner_Text_CantWinJackpot:
	.string "有我想要的头奖，\n"
	.string "可我抽不中。$"

MauvilleCity_GameCorner_Text_NeedCoinCaseGoNextDoor:
	.string "嘿，孩子，想在这儿玩，\n"
	.string "你需要一个代币盒。\p"
	.string "我想隔壁那位小姐\n"
	.string "有一个。去找她吧！$"

MauvilleCity_GameCorner_Text_LuckOnlyLastSoLongTakeCoins:
	.string "我的运气持续不了多久。\n"
	.string "这对我来说太多了。\l"
	.string "来，拿些代币去吧！$"

MauvilleCity_GameCorner_Text_MauvilleSomethingForEveryone:
	.string "紫堇市什么都有。\p"
	.string "对我来说，就是\n"
	.string "游戏城。$"

MauvilleCity_GameCorner_Text_RouletteTablesDifferentRates:
	.string "轮盘桌的赔率\n"
	.string "各不相同。\p"
	.string "要选桌子，先看看\n"
	.string "你的代币。$"

MauvilleCity_GameCorner_Text_EasyToLoseTrackOfTime:
	.string "在这里很容易忘了\n"
	.string "时间。我该回去工作了。$"

MauvilleCity_GameCorner_Text_CoinsAreNeededToPlay:
	.string "在这里的游戏城玩，\n"
	.string "需要代币。$"

MauvilleCity_GameCorner_Text_RouletteOnlyLuck:
	.string "这个轮盘……\n"
	.string "要求还挺高。\p"
	.string "赢也好输也好，\n"
	.string "全靠运气。$"

MauvilleCity_GameCorner_Text_UpTo3CoinsCanBeUsed:
	.string "最多可以用三枚代币\n"
	.string "来玩老虎机。$"

MauvilleCity_GameCorner_Text_DifficultToStopOn7:
	.string "要让转轮刚好停在\n"
	.string "“7”上非常难。\p"
	.string "如果它在转轮时间\n"
	.string "奖励游戏中停在“7”，\l"
	.string "就能拿到额外代币。$"

MauvilleCity_GameCorner_Text_HeresSomeSlotsInfo:
	.string "给你讲讲老虎机的\n"
	.string "一些知识。\p"
	.string "存的闪电标记越多，\n"
	.string "得到的转轮时间机会\l"
	.string "就越多。\p"
	.string "在一局有最多五次转轮\n"
	.string "时间机会的游戏里……\p"
	.string "有可能拿到四次普通\n"
	.string "奖励，再拿一次大奖励。\p"
	.string "那总共是660枚代币，\n"
	.string "不过非常难拿到。$"

MauvilleCity_GameCorner_Text_CantPlayWithNoCoinCase:
	.string "没有代币盒就\n"
	.string "不能玩。$"

