RustboroCity_EventScript_Boy1::
	msgbox RustboroCity_Text_YouCanHave2On2Battle, MSGBOX_NPC
	end

RustboroCity_MiniMarket_EventScript_Saleswoman::
	lock
	faceplayer
	message gText_HowMayIServeYou
	waitmessage
	pokemart RustboroCity_MiniMart
	msgbox gText_PleaseComeAgain, MSGBOX_DEFAULT
	release
	end

	.align 2
RustboroCity_MiniMart:
	.2byte ITEM_POMEG_BERRY
	.2byte ITEM_NONE
	release
	end

RustboroCity_Text_WeShortenItToDevon:
	.string "得文公司……\n"
	.string "我们都简称它得文。\p"
	.string "这家公司制造各种\n"
	.string "方便的产品。$"

RustboroCity_Text_SneakyLookingManWentAroundCorner:
	.string "嗯？鬼鬼祟祟的人？\p"
	.string "说起来确实有，一个形迹\n"
	.string "可疑的家伙转过了街角。$"

RustboroCity_Text_HaveYouChallengedGym:
	.string "你挑战过宝可梦道馆了吗？\p"
	.string "等你拿到了闪闪发亮的徽章，\n"
	.string "训练家大概就会明白\l"
	.string "自己该做些什么了。$"

RustboroCity_Text_HeyThatsRustborosGymBadge:
	.string "嘿，那是卡那兹道馆的徽章！\p"
	.string "要说所有道馆徽章里，\n"
	.string "卡那兹的最帅了。$"

RustboroCity_Text_YoureNewAroundHere:
	.string "哦？你是哪位？\n"
	.string "在这附近没见过你。\p"
	.string "你是刚转学来\n"
	.string "宝可梦训练家学校的吗？$"

RustboroCity_Text_GymLeaderIsntEasyWithFire:
	.string "我挑战了道馆馆主，可是……\p"
	.string "用我的火属性宝可梦\n"
	.string "想赢可不容易……\p"
	.string "火属性对岩石属性\n"
	.string "可不占优势……$"

RustboroCity_Text_MrBrineyWalksInTheTunnel:
	.string "老船员布林尼先生住在\n"
	.string "海边的屋子里。\p"
	.string "他时不时会到隧道里\n"
	.string "散散步。$"

RustboroCity_Text_MrBrineyLovesPeeko:
	.string "老船员布林尼先生住在\n"
	.string "海边的屋子里。\p"
	.string "他说要去凯那市\n"
	.string "给他的皮皮买点东西。\p"
	.string "这个老水手，一定\n"
	.string "很喜欢那只皮皮。$"

RustboroCity_Text_WowYouHavePokemon:
	.string "哇，你也带着宝可梦啊。\p"
	.string "等我长大了，也要\n"
	.string "和宝可梦一起去旅行。$"

RustboroCity_Text_CatchRarePokemonIfIGoToSchool:
	.string "宝可梦训练家学校！\p"
	.string "我要是上了这所学校，\n"
	.string "是不是就能轻松抓到\l"
	.string "稀有的宝可梦了？$"

RustboroCity_Text_PokemonCanChangeLookFromExp:
	.string "宝可梦在对战中积累经验，\n"
	.string "有时候外形也会\l"
	.string "发生变化。$"

RustboroCity_Text_PokemonChangeShape:
	.string "宝可梦会改变外形？\n"
	.string "要是真那样，\l"
	.string "我会吓一跳的！$"

RustboroCity_Text_TradePokemonGrowFast:
	.string "从别人那里交换来的\n"
	.string "宝可梦长得很快。\p"
	.string "但如果没有特定的\l"
	.string "道馆徽章，它可能\l"
	.string "不会听你的话……$"

RustboroCity_Text_OutOfTheWay:
	.string "让开！\n"
	.string "别挡道！$"

RustboroCity_Text_WaitDontTakeMyGoods:
	.string "等等！求求你了！\p"
	.string "别抢走我的货！$"

RustboroCity_Text_HelpMeIWasRobbed:
	.string "哦，是你！\p"
	.string "你就是那位在橙华森林\n"
	.string "帮了我的训练家！\p"
	.string "救命！我被水舰队抢了！\n"
	.string "我得把得文的货物拿回来！\p"
	.string "要是拿不回来……\n"
	.string "我可就闯大祸了。$"

RustboroCity_Text_ShadyCharacterTookOffTowardsTunnel:
	.string "那个形迹可疑的家伙，\n"
	.string "好像是往那边的隧道\l"
	.string "跑掉了。$"

RustboroCity_Text_YouGotItThankYou:
	.string "哦！怎么样了？\n"
	.string "得文的货物呢？\p"
	.string "你拿到了！\n"
	.string "你把它拿回来了！\p"
	.string "你真是位了不起的训练家！\p"
	.string "对了！作为谢礼，\n"
	.string "再送你一个超级球！$"

RustboroCity_Text_YoureLoadedWithItems:
	.string "你身上带的东西太多了。\n"
	.string "这个超级球没法给你。$"

RustboroCity_Text_PleaseComeWithMe:
	.string "打扰一下，请！\n"
	.string "请跟我来！$"

RustboroCity_Text_MayHiLetsRegister:
	.string "小遥：哦，你好，{PLAYER}！\p"
	.string "你的导航装了\n"
	.string "宝可梦对话功能！\p"
	.string "我们互相登录一下，\n"
	.string "随时都能联系！\p"
	.string "… … … … … …$"

RustboroCity_Text_RegisteredMay:
	.string "在宝可梦导航里\n"
	.string "登录了小遥。$"

RustboroCity_Text_MayPassedBrineyWantToBattle:
	.string "小遥：对了，\n"
	.string "我刚才在橙华森林\l"
	.string "碰见了布林尼先生。\p"
	.string "他大概是要回海边的\n"
	.string "小屋去吧。\p"
	.string "{PLAYER}，你的图鉴\n"
	.string "进展怎么样？\l"
	.string "我的看起来还不错哦！\p"
	.string "那么……\n"
	.string "要不要来对战一场？$"

RustboroCity_Text_MayOhHaventRaisedPokemonEnough:
	.string "小遥：哦，怎么了？\p"
	.string "你还没怎么抓过\n"
	.string "或培养过宝可梦吗？\p"
	.string "这样可不像个训练家哦！$"

RustboroCity_Text_MayWantToBattle:
	.string "小遥：怎么样？\n"
	.string "要不要在这里对战一场？$"

RustboroCity_Text_MayImNotGoingToLose:
	.string "小遥：你才刚当上训练家，\n"
	.string "{PLAYER}。我可不会输！$"

RustboroCity_Text_TooBad:
	.string "真可惜！$"

RustboroCity_Text_MayDefeat:
	.string "哎呀！\n"
	.string "你比我想的厉害多了！$"

RustboroCity_Text_MayMrBrineyHint:
	.string "小遥：对了，刚才\n"
	.string "我碰到的布林尼先生……\p"
	.string "{PLAYER}，你刚搬来，可能\n"
	.string "不知道，布林尼先生以前\l"
	.string "可是位受人尊敬的老船员。$"

RustboroCity_Text_BrendanHiLetsRegister:
	.string "佑树：哦，嘿，{PLAYER}！\p"
	.string "你的导航装了\n"
	.string "宝可梦对话功能！真不错！\p"
	.string "我们互相登录一下，\n"
	.string "随时都能联系！\p"
	.string "… … … … … …$"

RustboroCity_Text_RegisteredBrendan:
	.string "在宝可梦导航里\n"
	.string "登录了佑树。$"

RustboroCity_Text_BrendanPassedBrineyWantToBattle:
	.string "佑树：对了，{PLAYER}，\n"
	.string "我在橙华森林\l"
	.string "路过布林尼先生身边。\p"
	.string "他一定是回海边的\n"
	.string "小屋去了。\p"
	.string "{PLAYER}，你的图鉴呢？\n"
	.string "填上新的页数了吗？\p"
	.string "我的可厉害了。\p"
	.string "想不想对战一场，\n"
	.string "看看你进步了多少？$"

RustboroCity_Text_BrendanNoConfidenceInPokemon:
	.string "佑树：怎么了？\n"
	.string "对自己的宝可梦没信心吗？$"

RustboroCity_Text_BrendanWantToBattle:
	.string "佑树：怎么了？\n"
	.string "要和我对战一场吗？$"

RustboroCity_Text_BrendanIWontGoEasy:
	.string "佑树：我知道你才刚当上\n"
	.string "训练家，但我不会放水！$"

RustboroCity_Text_BrendanDefeat:
	.string "嗯……\n"
	.string "你还挺厉害的。$"

RustboroCity_Text_BrendanMrBrineyHint:
	.string "佑树：对了，你知道\n"
	.string "刚才我路过的布林尼先生吗？\p"
	.string "你刚搬来，{PLAYER}，\n"
	.string "大概不知道吧，\l"
	.string "布林尼先生以前是\l"
	.string "位了不起的老船员。$"

RustboroCity_Text_RivalExplainFlyFromPokeNav:
	.string "对了，{PLAYER}，你看看\n"
	.string "你的导航能加的新功能。\l"
	.string "借我用一下。\p"
	.string "… … … … … …\n"
	.string "… … … … … …\p"
	.string "好了！这是得文公司的\n"
	.string "开发员教我的。\p"
	.string "我刚在你的导航里装了\n"
	.string "新功能，只要看着地图，\l"
	.string "就能飞到以前去过的地方！\p"
	.string "{COLOR GREEN}{SHADOW LIGHT_GREEN}在导航地图上把光标移\n"
	.string "到你去过的城镇，\l"
	.string "就会看到按“R”键\l"
	.string "飞过去的选项。{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}\n"
	.string "很酷吧？$"

RustboroCity_Text_TunnelNearingCompletion:
	.string "“省时隧道即将\n"
	.string "完工！”\p"
	.string "……牌子上这么写着，\n"
	.string "不过上面还被人用红漆\l"
	.string "画了个大大的“X”……$"

RustboroCity_Text_DevonCorpSign:
	.string "得文公司\p"
	.string "“为了生活所需，\n"
	.string "我们什么都制造。”$"

RustboroCity_Text_GymSign:
	.string "卡那兹市宝可梦道馆\n"
	.string "馆主：杜娟\p"
	.string "“热爱岩石的优等生！”$"

RustboroCity_Text_DevonCorpBranchOfficeSign:
	.string "得文公司分公司\p"
	.string "“仅限得文员工\n"
	.string "及相关人员进入。”$"

RustboroCity_Text_CitySign:
	.string "卡那兹市\p"
	.string "“探寻自然与科学\n"
	.string "融合之道的城市。”$"

RustboroCity_Text_TrainersSchoolSign:
	.string "宝可梦训练家学校\p"
	.string "“宝可梦的事，\n"
	.string "我们什么都教！”$"

RustboroCity_Text_CuttersHouse:
	.string "樵夫之家$"

RustboroCity_Text_DevelopedNewPokenavFeature:
	.string "我一直在给宝可梦导航\n"
	.string "开发新功能……\p"
	.string "结果做得非常成功！\p"
	.string "{PLAYER}，能让我看看\n"
	.string "你的导航吗？\l"
	.string "就是社长给你的那台。$"

RustboroCity_Text_AddedMatchCallPleaseCallMrStone:
	.string "好了，{PLAYER}！\p"
	.string "我在你的导航里加了个\n"
	.string "叫宝可梦对话的新功能。\p"
	.string "用宝可梦对话，\n"
	.string "就能和在导航里登录过的人\l"
	.string "聊天。\p"
	.string "好，我该回去工作了。\n"
	.string "你多保重，{PLAYER}！$"

RustboroCity_Text_PleaseSelectPokenav:
	.string "请选择宝可梦导航。$"

RustboroCity_Text_YouCanHave2On2Battle:
	.string "你知道吗？\p"
	.string "就算没有别的训练家，\n"
	.string "也能进行二对二的战斗。\p"
	.string "带着两只以上宝可梦时，\n"
	.string "如果被两个训练家看见，\l"
	.string "他们就会一起挑战你。\p"
	.string "一个人打赢两个训练家，\n"
	.string "不觉得很酷吗？$"
`

script RustboroCity_Trigger_BlockGymEntrance{
	lockall
	msgbox(GoBeatRoark, MSGBOX_SIGN)
	waitmessage
	applymovement(OBJ_EVENT_ID_PLAYER, StopPlayer)
	waitmovement(0)
	releaseall
	end
}

text GoBeatRoark{
	"你该去看看还有没有\n"
	"其他强手可以打，\l"
	"也许116号道路最东边有。"
}

movement StopPlayer {
	walk_down
}
