raw `
SootopolisCity_Gym_1F_MapScripts::
	map_script MAP_SCRIPT_ON_FRAME_TABLE, SootopolisCity_Gym_1F_OnFrame
	map_script MAP_SCRIPT_ON_RESUME, SootopolisCity_Gym_1F_OnResume
	map_script MAP_SCRIPT_ON_LOAD, SootopolisCity_Gym_1F_OnLoad
	map_script MAP_SCRIPT_ON_TRANSITION, SootopolisCity_Gym_1F_OnTransition
	.byte 0

SootopolisCity_Gym_1F_OnTransition:
	setvar VAR_ICE_STEP_COUNT, 1
	end

SootopolisCity_Gym_1F_OnResume:
	setstepcallback STEP_CB_SOOTOPOLIS_ICE
	end

SootopolisCity_Gym_1F_OnLoad:
	call SootopolisCity_Gym_1F_EventScript_CheckSetStairMetatiles
	special SetSootopolisGymCrackedIceMetatiles
	end

SootopolisCity_Gym_1F_EventScript_CheckSetStairMetatiles::
	goto_if_lt VAR_ICE_STEP_COUNT, 8, SootopolisCity_Gym_1F_EventScript_StopCheckingStairs  @ All stairs ice
	goto_if_lt VAR_ICE_STEP_COUNT, 28, SootopolisCity_Gym_1F_EventScript_OpenFirstStairs
	goto_if_lt VAR_ICE_STEP_COUNT, 67, SootopolisCity_Gym_1F_EventScript_OpenFirstAndSecondStairs
	setmetatile 8, 4, METATILE_SootopolisGym_Stairs, FALSE
	setmetatile 8, 5, METATILE_SootopolisGym_Stairs, FALSE
SootopolisCity_Gym_1F_EventScript_OpenFirstAndSecondStairs::
	setmetatile 8, 10, METATILE_SootopolisGym_Stairs, FALSE
	setmetatile 8, 11, METATILE_SootopolisGym_Stairs, FALSE
SootopolisCity_Gym_1F_EventScript_OpenFirstStairs::
	setmetatile 8, 15, METATILE_SootopolisGym_Stairs, FALSE
	setmetatile 8, 16, METATILE_SootopolisGym_Stairs, FALSE
SootopolisCity_Gym_1F_EventScript_StopCheckingStairs::
	return

SootopolisCity_Gym_1F_OnFrame:
	map_script_2 VAR_ICE_STEP_COUNT, 8, SootopolisCity_Gym_1F_EventScript_UnlockFirstStairs
	map_script_2 VAR_ICE_STEP_COUNT, 28, SootopolisCity_Gym_1F_EventScript_UnlockSecondStairs
	map_script_2 VAR_ICE_STEP_COUNT, 67, SootopolisCity_Gym_1F_EventScript_UnlockThirdStairs
	map_script_2 VAR_ICE_STEP_COUNT, 0, SootopolisCity_Gym_1F_EventScript_FallThroughIce
	.2byte 0

SootopolisCity_Gym_1F_EventScript_UnlockFirstStairs::
	addvar VAR_ICE_STEP_COUNT, 1
	delay 40
	playse SE_ICE_STAIRS
	call SootopolisCity_Gym_1F_EventScript_CheckSetStairMetatiles
	special DrawWholeMapView
	end

SootopolisCity_Gym_1F_EventScript_UnlockSecondStairs::
	addvar VAR_ICE_STEP_COUNT, 1
	delay 40
	playse SE_ICE_STAIRS
	call SootopolisCity_Gym_1F_EventScript_CheckSetStairMetatiles
	special DrawWholeMapView
	end

SootopolisCity_Gym_1F_EventScript_UnlockThirdStairs::
	addvar VAR_ICE_STEP_COUNT, 1
	delay 40
	playse SE_ICE_STAIRS
	call SootopolisCity_Gym_1F_EventScript_CheckSetStairMetatiles
	special DrawWholeMapView
	end

SootopolisCity_Gym_1F_EventScript_FallThroughIce::
	lockall
	delay 20
	applymovement OBJ_EVENT_ID_PLAYER, SootopolisCity_Gym_1F_Movement_FallThroughIce
	waitmovement 0
	playse SE_FALL
	delay 60
	warphole MAP_SOOTOPOLIS_CITY_GYM_B1F
	waitstate
	end

SootopolisCity_Gym_1F_Movement_FallThroughIce:
	set_invisible
	step_end

SootopolisCity_Gym_1F_EventScript_Juan::
	trainerbattle_single TRAINER_JUAN_1, SootopolisCity_Gym_1F_Text_JuanIntro, SootopolisCity_Gym_1F_Text_JuanDefeat, SootopolisCity_Gym_1F_EventScript_JuanDefeated, NO_MUSIC
	specialvar VAR_RESULT, ShouldTryRematchBattle
	goto_if_eq VAR_RESULT, TRUE, SootopolisCity_Gym_1F_EventScript_JuanRematch
	goto_if_unset FLAG_RECEIVED_TM_MOONBLAST, SootopolisCity_Gym_1F_EventScript_GiveWaterPulse2
	goto_if_unset FLAG_BADGE06_GET, SootopolisCity_Gym_1F_EventScript_GoGetFortreeBadge
	msgbox SootopolisCity_Gym_1F_Text_JuanPostBattle, MSGBOX_DEFAULT
	release
	end

SootopolisCity_Gym_1F_EventScript_JuanDefeated::
	message SootopolisCity_Gym_1F_Text_ReceivedRainBadge
	waitmessage
	call Common_EventScript_PlayGymBadgeFanfare
	msgbox SootopolisCity_Gym_1F_Text_ExplainRainBadgeTakeThis, MSGBOX_DEFAULT
	setflag FLAG_DEFEATED_SOOTOPOLIS_GYM
	setflag FLAG_BADGE08_GET
	setflag FLAG_HIDE_SOOTOPOLIS_CITY_RESIDENTS
	setflag FLAG_HIDE_SOOTOPOLIS_CITY_STEVEN
	setflag FLAG_HIDE_SOOTOPOLIS_CITY_WALLACE
	setvar VAR_SOOTOPOLIS_CITY_STATE, 6
	clearflag FLAG_HIDE_SOOTOPOLIS_CITY_MAN_1
	setvar VAR_0x8008, 8
	call Common_EventScript_SetGymTrainers
	call SootopolisCity_Gym_1F_EventScript_GiveWaterPulse
	closemessage
	delay 30
	playfanfare MUS_REGISTER_MATCH_CALL
	msgbox SootopolisCity_Gym_1F_Text_RegisteredJuan, MSGBOX_DEFAULT
	waitfanfare
	closemessage
	delay 30
	setflag FLAG_ENABLE_JUAN_MATCH_CALL
	playfanfare MUS_LEVEL_UP
	specialvar VAR_0x8006, GetLevelCapForText
	buffernumberstring STR_VAR_3, VAR_0x8006
	msgbox LevelCapIncreasedTo, MSGBOX_DEFAULT
	waitfanfare
	closemessage
	delay 30
	release
	end

SootopolisCity_Gym_1F_EventScript_GiveWaterPulse::
	giveitem ITEM_GRIMMITE
	giveitem ITEM_TM_MOONBLAST
	giveitem ITEM_TM_MISTY_EXPLOSION
	msgbox SootopolisCity_Gym_1F_Text_ExplainWaterPulse, MSGBOX_DEFAULT
	setflag FLAG_RECEIVED_TM_MOONBLAST
	return

SootopolisCity_Gym_1F_EventScript_GiveWaterPulse2::
	giveitem ITEM_GRIMMITE
	giveitem ITEM_TM_MOONBLAST
	giveitem ITEM_TM_MISTY_EXPLOSION
	msgbox SootopolisCity_Gym_1F_Text_ExplainWaterPulse, MSGBOX_DEFAULT
	setflag FLAG_RECEIVED_TM_MOONBLAST
	release
	end

SootopolisCity_Gym_1F_EventScript_GoGetFortreeBadge::
	msgbox SootopolisCity_Gym_1F_Text_GoGetFortreeBadge, MSGBOX_DEFAULT
	release
	end

SootopolisCity_Gym_1F_EventScript_JuanRematch::
	trainerbattle_rematch_double TRAINER_JUAN_1, SootopolisCity_Gym_1F_Text_JuanPreRematch, SootopolisCity_Gym_1F_Text_JuanRematchDefeat, SootopolisCity_Gym_1F_Text_JuanRematchNeedTwoMons
	msgbox SootopolisCity_Gym_1F_Text_JuanPostRematch, MSGBOX_AUTOCLOSE
	end

SootopolisCity_Gym_1F_EventScript_GymGuide::
	lock
	faceplayer
	goto_if_set FLAG_DEFEATED_SOOTOPOLIS_GYM, SootopolisCity_Gym_1F_EventScript_GymGuidePostVictory
	msgbox SootopolisCity_Gym_1F_Text_GymGuideAdvice, MSGBOX_DEFAULT
	release
	end

SootopolisCity_Gym_1F_EventScript_GymGuidePostVictory::
	msgbox SootopolisCity_Gym_1F_Text_GymGuidePostVictory, MSGBOX_DEFAULT
	release
	end

SootopolisCity_Gym_1F_EventScript_LeftGymStatue::
	lockall
	goto_if_set FLAG_BADGE08_GET, SootopolisCity_Gym_1F_EventScript_GymStatueCertified
	goto SootopolisCity_Gym_1F_EventScript_GymStatue
	end

SootopolisCity_Gym_1F_EventScript_RightGymStatue::
	lockall
	goto_if_set FLAG_BADGE08_GET, SootopolisCity_Gym_1F_EventScript_GymStatueCertified
	goto SootopolisCity_Gym_1F_EventScript_GymStatue
	end

SootopolisCity_Gym_1F_EventScript_GymStatueCertified::
	msgbox SootopolisCity_Gym_1F_Text_GymStatueCertified, MSGBOX_DEFAULT
	releaseall
	end

SootopolisCity_Gym_1F_EventScript_GymStatue::
	msgbox SootopolisCity_Gym_1F_Text_GymStatue, MSGBOX_DEFAULT
	releaseall
	end

SootopolisCity_Gym_EventScript_Diancie::
	lock
	faceplayer
	waitse
	playmoncry SPECIES_DIANCIE, CRY_MODE_NORMAL
	msgbox SootopolisCity_Gym_Text_Diancie, MSGBOX_DEFAULT
	waitmoncry
	release
	end

SootopolisCity_Gym_1F_Text_GymGuideAdvice:
	.string "哟！冠军候补{PLAYER}，\n"
	.string "近况如何？\p"
	.string "琉璃市的馆主阿丹是\n"
	.string "妖精属性宝可梦的高手。\p"
	.string "而且，要到阿丹那儿，\n"
	.string "还得过一片冰面……\p"
	.string "听好，抱歉，我能给的\n"
	.string "建议就这些。\p"
	.string "剩下的路，你得\n"
	.string "自己去闯！$"

SootopolisCity_Gym_1F_Text_GymGuidePostVictory:
	.string "哇！你连号称全丰缘\n"
	.string "最强的阿丹都打赢了！\p"
	.string "好！看看你的\n"
	.string "训练家卡。\p"
	.string "要是集齐了所有徽章，\n"
	.string "就可以去挑战\l"
	.string "宝可梦联盟了！$"

SootopolisCity_Gym_1F_Text_JuanIntro:
	.string "我问你。\n"
	.string "你知道吗？\l"
	.string "啊，我不该这么绕弯。\p"
	.string "正是我教会了亚当关于\n"
	.string "宝可梦的一切。\p"
	.string "我曾经放弃了道馆\n"
	.string "馆主的位子。\p"
	.string "我把道馆托付给了\n"
	.string "亚当。\p"
	.string "可是，有个必须让我\n"
	.string "复出的理由。\p"
	.string "可我不能以从前那个\n"
	.string "身份回来！\p"
	.string "我只能重塑自己的\n"
	.string "风格！而现在，\l"
	.string "带着这些华丽优雅的\l"
	.string "妖精属性宝可梦……\p"
	.string "啊，话说得够多了。\n"
	.string "我们开始对战吧？\p"
	.string "请见证我的\n"
	.string "新艺术！$"

@ NOTE: This defeat text actually causes a buffer overflow. It's about 50 bytes too long for
@ the gDisplayedStringBattle buffer that it's put into, and it stomps all over the gBattleTextBuffs
@ after, as well as the otherwise unused array after that. One wonders if that's the reason for
@ the existence of that unused array of ints.
SootopolisCity_Gym_1F_Text_JuanDefeat:
	.string "啊哈哈哈，太棒了！\n"
	.string "很好，你是胜者。\p"
	.string "我从你身上看到了能\n"
	.string "超越一切的才华之光。\p"
	.string "不过，和我，甚至和\n"
	.string "亚当相比，你还\l"
	.string "缺少优雅。\p"
	.string "也许我该把我的\n"
	.string "衣服借给你？\p"
	.string "… … … … … …\n"
	.string "… … … … … …\p"
	.string "哈哈哈，我只是开个\n"
	.string "玩笑！\p"
	.string "比起我的衣服，我更该\n"
	.string "给你这个——雨滴徽章！$"

SootopolisCity_Gym_1F_Text_ReceivedRainBadge:
	.string "从阿丹那里\n"
	.string "得到了雨滴徽章。$"

SootopolisCity_Gym_1F_Text_ExplainRainBadgeTakeThis:
	.string "雨滴徽章能让你使用\n"
	.string "秘传招式攀瀑，\l"
	.string "爬上水流成的墙。\p"
	.string "还有，为了让你不忘\n"
	.string "我们这一战，收下这个……$"

SootopolisCity_Gym_1F_Text_ExplainWaterPulse:
	.string "我给你的那个学习器\n"
	.string "里是魔法闪耀。\p"
	.string "使用时，有时会降低\n"
	.string "目标的特攻。\p"
	.string "… … … … … …$"

SootopolisCity_Gym_1F_Text_RegisteredJuan:
	.string "已把馆主阿丹\n"
	.string "登记进宝可梦导航。$"

SootopolisCity_Gym_1F_Text_JuanPostBattle:
	.string "集齐丰缘所有道馆\n"
	.string "徽章的训练家，\l"
	.string "该前往最终的目的地。\p"
	.string "宝可梦联盟。\p"
	.string "往丰缘最东边，\n"
	.string "到彩幽岛去。\p"
	.string "在那里，你会找到\n"
	.string "宝可梦联盟。$"

SootopolisCity_Gym_1F_Text_GoGetFortreeBadge:
	.string "丰缘只剩一枚徽章\n"
	.string "没拿到了。\p"
	.string "想挑战宝可梦联盟，\n"
	.string "你得去茵郁的道馆\l"
	.string "拿到最后一枚徽章。$"

SootopolisCity_Gym_1F_Text_GymStatue:
	.string "琉璃市宝可梦道馆$"

SootopolisCity_Gym_1F_Text_GymStatueCertified:
	.string "琉璃市宝可梦道馆\p"
	.string "阿丹认定的训练家：\n"
	.string "{PLAYER}$"

SootopolisCity_Gym_1F_Text_JuanPreRematch:
	.string "阿丹：啊，这座道馆又\n"
	.string "恢复了往日的宁静……\p"
	.string "可我们年轻的台风又\n"
	.string "回来考验我们了！\p"
	.string "好啊，我的朋友，\n"
	.string "当然！\p"
	.string "只要你愿意，我很乐意\n"
	.string "和你跳舞，多少次都行！$"

SootopolisCity_Gym_1F_Text_JuanRematchDefeat:
	.string "啊哈哈哈，你是胜者！\n"
	.string "你又打败了我！$"

SootopolisCity_Gym_1F_Text_JuanPostRematch:
	.string "阿丹：要是我叫你做我的\n"
	.string "徒弟，你一定会拒绝。\p"
	.string "我想把我的外套\n"
	.string "送给你。\p"
	.string "可你也会拒绝。\n"
	.string "我想一定是这样。\p"
	.string "我的朋友，这正是\n"
	.string "高贵的一种证明！$"

SootopolisCity_Gym_1F_Text_JuanRematchNeedTwoMons:
	.string "阿丹：啊，这座道馆又\n"
	.string "恢复了往日的宁静……\p"
	.string "可我们年轻的台风又\n"
	.string "回来考验我们了！\p"
	.string "好啊，我的朋友，\n"
	.string "当然！我很乐意\l"
	.string "和你跳舞……\p"
	.string "啊，不，不不。\n"
	.string "你身上只有一只宝可梦。\p"
	.string "希望你能带两只，\n"
	.string "最好是更多，再来。$"

SootopolisCity_Gym_Text_Diancie:
	.string "蒂安希：呜咿咿咿咿！$"
`
