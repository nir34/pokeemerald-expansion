MossdeepCity_Gym_EventScript_Alakazam::
	lock
	faceplayer
	waitse
	playmoncry SPECIES_ALAKAZAM, CRY_MODE_NORMAL
	msgbox MossdeepCity_Gym_Text_Alakazam, MSGBOX_DEFAULT
	waitmoncry
	release
	end

