	release
	end

MossdeepCity_Gym_Text_GymGuideAdvice:
	.string "哟，冠军候补{PLAYER}，\n"
	.string "近况如何？\p"
	.string "这里的馆主使用\n"
	.string "超能力属性宝可梦。\p"
	.string "你要是用格斗或毒属性\n"
	.string "宝可梦去挑战，\l"
	.string "会被打出可怕的伤害！\p"
	.string "而且他们还会用出色的\n"
	.string "组合招式攻过来。\p"
	.string "想赢的话，你得让他们\n"
	.string "看到你和宝可梦多默契。\l"
	.string "去吧！$"

MossdeepCity_Gym_Text_GymGuidePostVictory:
	.string "哇，你真厉害！\n"
	.string "是个了不起的训练家！$"

MossdeepCity_Gym_Text_PrestonIntro:
	.string "对战胜负取决于你\n"
	.string "精神的强度！精神弱\l"
	.string "的人永远赢不了！$"

MossdeepCity_Gym_Text_PrestonDefeat:
	.string "我输了！\n"
	.string "我得重新磨练精神！$"

MossdeepCity_Gym_Text_PrestonPostBattle:
	.string "犹豫的人会输。\n"
	.string "这是我的忠告。$"

MossdeepCity_Gym_Text_VirgilIntro:
	.string "让我看看你的才能！$"

MossdeepCity_Gym_Text_VirgilDefeat:
	.string "你有惊人的才能！$"

MossdeepCity_Gym_Text_VirgilPostBattle:
	.string "世上如果说有神童，\n"
	.string "那一定就是我们的馆主！\p"
	.string "不过，你可能比他们\n"
	.string "更有才能……$"

MossdeepCity_Gym_Text_BlakeIntro:
	.string "呵呵呵呵……看我念力\n"
	.string "把精灵球浮起来！\p"
	.string "呜哦哦哦哦哦！\n"
	.string "… … … … … …\p"
	.string "有时候，我会\n"
	.string "不太同步……$"

MossdeepCity_Gym_Text_BlakeDefeat:
	.string "我的宝可梦对战技术\n"
	.string "也不同步！$"

MossdeepCity_Gym_Text_BlakePostBattle:
	.string "精灵球太重了，念力\n"
	.string "举不起来。不过这团\l"
	.string "灰尘……\p"
	.string "呼哦哦哦哦哦！\n"
	.string "… … … …\p"
	.string "不，我没作弊！\n"
	.string "我没吹它！真的！$"

MossdeepCity_Gym_Text_HannahIntro:
	.string "你输给我的时候，别\n"
	.string "太自责。\p"
	.string "不是因为你弱——\n"
	.string "只是我太强了！$"

MossdeepCity_Gym_Text_HannahDefeat:
	.string "你实在太强了！$"

MossdeepCity_Gym_Text_HannahPostBattle:
	.string "我不会因为输了就\n"
	.string "沮丧。我只是需要\l"
	.string "更拼命地训练。\p"
	.string "积极思考——\n"
	.string "这是我的强项！$"

MossdeepCity_Gym_Text_SamanthaIntro:
	.string "我看到了……\n"
	.string "我看到你的未来……\p"
	.string "你要是能赢我，我就\n"
	.string "告诉你你的未来！$"

MossdeepCity_Gym_Text_SamanthaDefeat:
	.string "我认输！$"

MossdeepCity_Gym_Text_SamanthaPostBattle:
	.string "你将和我们的馆主\n"
	.string "打一场极其激烈的对战……\p"
	.string "结果……\n"
	.string "我不会告诉你的！$"

MossdeepCity_Gym_Text_MauraIntro:
	.string "你走过的路……\n"
	.string "你经历的事……\p"
	.string "用你学到的一切\n"
	.string "来对付我吧！$"

MossdeepCity_Gym_Text_MauraDefeat:
	.string "你走过了伟大之路！$"

MossdeepCity_Gym_Text_MauraPostBattle:
	.string "勤勉的人前方有光明的\n"
	.string "未来。\p"
	.string "偷懒的人，终点只有\n"
	.string "绝望。\p"
	.string "种什么因，得什么果……$"

MossdeepCity_Gym_Text_SylviaIntro:
	.string "就算赌上性命，我也要\n"
	.string "赢下这场对战！$"

MossdeepCity_Gym_Text_SylviaDefeat:
	.string "你做的事……\n"
	.string "让我毛骨悚然……$"

MossdeepCity_Gym_Text_SylviaPostBattle:
	.string "你竟敢赢我……\p"
	.string "你要是遇上什么可怕\n"
	.string "的事，可不怪我……$"

MossdeepCity_Gym_Text_NateIntro:
	.string "呵呵呵。\p"
	.string "得让你看看超能力属性\n"
	.string "有多难缠。$"

MossdeepCity_Gym_Text_NateDefeat:
	.string "哦！哎呀呀！\n"
	.string "你的战斗方式太棒了！$"

MossdeepCity_Gym_Text_NatePostBattle:
	.string "我……我不会因为输\n"
	.string "得多惨就……就慌的。$"

MossdeepCity_Gym_Text_KathleenIntro:
	.string "让我给你看一段\n"
	.string "绝顶糟糕、可怕的时光！$"

MossdeepCity_Gym_Text_KathleenDefeat:
	.string "不——要啊！$"

MossdeepCity_Gym_Text_KathleenPostBattle:
	.string "你的活力会传染！\n"
	.string "快离我远点！$"

MossdeepCity_Gym_Text_CliffordIntro:
	.string "我可能过了巅峰期，\n"
	.string "不过劝你别小看我。$"

MossdeepCity_Gym_Text_CliffordDefeat:
	.string "啊，你身上满溢着\n"
	.string "青春的力量！$"

MossdeepCity_Gym_Text_CliffordPostBattle:
	.string "看来我敌不过你的\n"
	.string "年轻活力。$"

MossdeepCity_Gym_Text_MaceyIntro:
	.string "你别想走到最后！\n"
	.string "只要我拦得住！$"

MossdeepCity_Gym_Text_MaceyDefeat:
	.string "你怎么能强得这么\n"
	.string "荒唐？$"

MossdeepCity_Gym_Text_MaceyPostBattle:
	.string "哼！你也许很强，可不\n"
	.string "适合超能力属性！\p"
	.string "你的战斗方式\n"
	.string "莫名野蛮！$"

MossdeepCity_Gym_Text_NicholasIntro:
	.string "呜嗷！尝尝我宝可梦\n"
	.string "超强硬战之力！$"

MossdeepCity_Gym_Text_NicholasDefeat:
	.string "哦！\n"
	.string "完蛋了！$"

MossdeepCity_Gym_Text_NicholasPostBattle:
	.string "好！我想我接下来\n"
	.string "要开发一种无敌的\l"
	.string "宝可梦力量。$"

MossdeepCity_Gym_Text_TateAndLizaIntro:
	.string "小枫：嘿嘿嘿……你吃惊吗？\n"
	.string "小南：呵呵呵……你吃惊吗？\p"
	.string "小枫：因为馆主有两个人？\n"
	.string "小南：因为馆主有两个人？\p"
	.string "小枫：我们是双胞胎！\n"
	.string "小南：我们是双胞胎！\p"
	.string "小枫：不用说话，因为……\n"
	.string "小南：我们能各自知道……\p"
	.string "小枫：对方在想什么……\n"
	.string "小南：全在心里！\p"
	.string "小枫：我们这种组合……\n"
	.string "小南：你打得过吗？$"

MossdeepCity_Gym_Text_TateAndLizaDefeat:
	.string "小枫：什么？！\n"
	.string "小枫：我们的组合被打碎了！\p"
	.string "小南：没办法，你赢了……\n"
	.string "小南：那么，作为认可，\l"
	.string "收下这个。$"

MossdeepCity_Gym_Text_TateDefeat:
	.string "小枫：什么？！我们的组合\n"
	.string "被打碎了！$"

MossdeepCity_Gym_Text_LizaDefeat:
	.string "小南：没办法，你赢了！\n"
	.string "那么，作为认可，收下这个。$"

MossdeepCity_Gym_Text_ReceivedMindBadge:
	.string "从小枫和小南那里\n"
	.string "得到了心灵徽章。$"

MossdeepCity_Gym_Text_ExplainMindBadgeTakeThis:
	.string "小南：心灵徽章能让你在\n"
	.string "战斗外使用秘传潜水。\p"
	.string "小枫：你也该收下这个。$"

MossdeepCity_Gym_Text_ExplainCalmMind:
	.string "小枫：那个学习器55里是……\n"
	.string "小南：广域战力！\p"
	.string "小枫：它威力大得多……\n"
	.string "小南：在精神场地上！\p"
	.string "小枫：还有学习器106里是……\n"
	.string "小南：戏法空间！\p"
	.string "小枫：两个都是好学习器……\n"
	.string "小南：给超能宝可梦用！\p"
	.string "… … … … … …$"

MossdeepCity_Gym_Text_RegisteredTateAndLiza:
	.string "已把馆主小枫和小南\n"
	.string "登记进宝可梦导航。$"

MossdeepCity_Gym_Text_TateAndLizaPostBattle:
	.string "小枫：看来你和宝可梦的\n"
	.string "羁绊，比我们双胞胎的\l"
	.string "羁绊还要强得多。\p"
	.string "小南：你会变得更强！\n"
	.string "我们和你打过，所以知道。$"

MossdeepCity_Gym_Text_TateAndLizaNeedTwoMons:
	.string "小枫：嘿嘿嘿……你吃惊吗？\p"
	.string "小南：因为馆主有两个人？\p"
	.string "小枫：哎呀，你只有一只……\n"
	.string "小南：能战斗的宝可梦。\p"
	.string "小枫：这样可没法打！\p"
	.string "小南：想挑战我们，就多\n"
	.string "带几只宝可梦来。$"

MossdeepCity_Gym_Text_GymLeadersPostVictory:
	.string "小枫：看来我们需要……\n"
	.string "小南：再多练习？\l"
	.string "小枫：嗯……我也这么想……$"

MossdeepCity_Gym_Text_GymStatue:
	.string "绿岭市宝可梦道馆$"

MossdeepCity_Gym_Text_GymStatueCertified:
	.string "绿岭市宝可梦道馆\p"
	.string "小南和小枫认定的训练家：\n"
	.string "{PLAYER}$"

MossdeepCity_Gym_Text_TateAndLizaPreRematch:
	.string "小枫：宝可梦……\n"
	.string "小南：宝可梦……\p"
	.string "小枫：改变队伍的搭配……\n"
	.string "小南：战斗风格就会变。\p"
	.string "小枫：可是我……\n"
	.string "小南：可是我……\p"
	.string "小枫：我永远和小南在一起！\n"
	.string "小南：我永远和小枫在一起！\p"
	.string "小枫：我们的组合……\n"
	.string "小南：我们会一遍遍给你看！$"

MossdeepCity_Gym_Text_TateAndLizaRematchDefeat:
	.string "小枫：你和你的宝可梦……\n"
	.string "小南：就像兄弟姐妹一样！$"

MossdeepCity_Gym_Text_TateAndLizaPostRematch:
	.string "小枫：你可以打倒我们，\n"
	.string "但我们永远不会倒下！\p"
	.string "小南：因为我们两个，\n"
	.string "永远互相扶持！$"

MossdeepCity_Gym_Text_TateAndLizaRematchNeedTwoMons:
	.string "小枫：你又回来了……\n"
	.string "小南：你又回来了……\p"
	.string "小枫：来和我们再战。\n"
	.string "小南：来和我们再战。\p"
	.string "小枫：可是……\n"
	.string "小南：为了对战……\p"
	.string "小枫：你只带了一只宝可梦！\n"
	.string "小南：你只带了一只宝可梦！\p"
	.string "小枫：回来时至少得带……\n"
	.string "小南：两只宝可梦。$"

MossdeepCity_Gym_Text_Alakazam:
	.string "胡地：咿咿咿呜！$"

MossdeepCity_Gym_Text_Kangaskhan:
	.string "袋兽：呜呜呜吼！$"
