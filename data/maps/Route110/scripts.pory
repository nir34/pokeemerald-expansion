Route110_EventScript_CyclingChallengeEnd::
	lockall
	applymovement LOCALID_CHALLENGE_BIKER, Common_Movement_WalkInPlaceFasterRight
	waitmovement 0
	call Route110_EventScript_CyclingChallengeResults
	releaseall
	end

Route110_EventScript_CyclingChallengeResults::
	special FinishCyclingRoadChallenge
	msgbox Route110_Text_CyclingChallengeResultSummary, MSGBOX_DEFAULT
	switch VAR_RESULT
	case 10, Route110_EventScript_ChallengeReactionBest
	case 9, Route110_EventScript_ChallengeReactionGood
	case 8, Route110_EventScript_ChallengeReactionGood
	case 7, Route110_EventScript_ChallengeReactionGood
	case 6, Route110_EventScript_ChallengeReactionOk
	case 5, Route110_EventScript_ChallengeReactionOk
	case 4, Route110_EventScript_ChallengeReactionOk
	case 3, Route110_EventScript_ChallengeReactionBad
	case 2, Route110_EventScript_ChallengeReactionBad
	case 1, Route110_EventScript_ChallengeReactionBad
	case 0, Route110_EventScript_ChallengeReactionWorst
	end

Route110_EventScript_ChallengeReactionBest::
	msgbox Route110_Text_ChallengeReactionBest, MSGBOX_DEFAULT
	goto Route110_EventScript_EndChallenge
	end

Route110_EventScript_ChallengeReactionGood::
	msgbox Route110_Text_ChallengeReactionGood, MSGBOX_DEFAULT
	goto Route110_EventScript_EndChallenge
	end

Route110_EventScript_ChallengeReactionOk::
	msgbox Route110_Text_ChallengeReactionOk, MSGBOX_DEFAULT
	goto Route110_EventScript_EndChallenge
	end

Route110_EventScript_ChallengeReactionBad::
	msgbox Route110_Text_ChallengeReactionBad, MSGBOX_DEFAULT
	goto Route110_EventScript_EndChallenge
	end

Route110_EventScript_ChallengeReactionWorst::
	msgbox Route110_Text_ChallengeReactionWorst, MSGBOX_DEFAULT
	goto Route110_EventScript_EndChallenge
	end

Route110_EventScript_EndChallenge::
	setvar VAR_CYCLING_CHALLENGE_STATE, 3
	savebgm MUS_DUMMY
	fadedefaultbgm
	return

Route110_EventScript_RivalTrigger1::
	setvar VAR_0x8008, 1
	goto Route110_EventScript_RivalScene
	end

Route110_EventScript_RivalTrigger2::
	setvar VAR_0x8008, 2
	goto Route110_EventScript_RivalScene
	end

Route110_EventScript_RivalTrigger3::
	setvar VAR_0x8008, 3
	goto Route110_EventScript_RivalScene
	end

Route110_EventScript_RivalScene::
	lockall
	checkplayergender
	call_if_eq VAR_RESULT, MALE, Route110_EventScript_PlayMayMusic
	call_if_eq VAR_RESULT, FEMALE, Route110_EventScript_PlayBrendanMusic
	applymovement LOCALID_RIVAL, Common_Movement_WalkInPlaceFasterDown
	waitmovement 0
	applymovement LOCALID_RIVAL, Common_Movement_ExclamationMark
	waitmovement 0
	applymovement LOCALID_RIVAL, Common_Movement_Delay48
	waitmovement 0
	delay 30
	call_if_eq VAR_0x8008, 1, Route110_EventScript_RivalApproachPlayer1
	call_if_eq VAR_0x8008, 2, Route110_EventScript_RivalApproachPlayer2
	call_if_eq VAR_0x8008, 3, Route110_EventScript_RivalApproachPlayer3
	checkplayergender
	goto_if_eq VAR_RESULT, MALE, Route110_EventScript_MayBattle
	goto_if_eq VAR_RESULT, FEMALE, Route110_EventScript_BrendanBattle
	releaseall
	end

Route110_EventScript_PlayMayMusic::
	playbgm MUS_ENCOUNTER_MAY, TRUE
	return

Route110_EventScript_PlayBrendanMusic::
	playbgm MUS_ENCOUNTER_BRENDAN, TRUE
	return

Route110_EventScript_MayBattle::
	msgbox Route110_Text_MayLetsBattle, MSGBOX_DEFAULT
	switch VAR_STARTER_MON
	case 0, Route110_EventScript_MayBattleTreecko
	case 1, Route110_EventScript_MayBattleTorchic
	case 2, Route110_EventScript_MayBattleMudkip
	end

Route110_EventScript_MayBattleTreecko::
	trainerbattle_no_intro TRAINER_MAY_ROUTE_110_TREECKO, Route110_Text_MayDefeated
	goto Route110_EventScript_MayDefeated
	end

Route110_EventScript_MayBattleTorchic::
	trainerbattle_no_intro TRAINER_MAY_ROUTE_110_TORCHIC, Route110_Text_MayDefeated
	goto Route110_EventScript_MayDefeated
	end

Route110_EventScript_MayBattleMudkip::
	trainerbattle_no_intro TRAINER_MAY_ROUTE_110_MUDKIP, Route110_Text_MayDefeated
	goto Route110_EventScript_MayDefeated
	end

Route110_EventScript_MayDefeated::
	msgbox Route110_Text_MayTakeThis, MSGBOX_DEFAULT
	call Route110_EventScript_GiveFly
	msgbox Route110_Text_RivalThatsNotAll, MSGBOX_DEFAULT
	call Route110_EventScript_GiveRestOfItems
	msgbox Route110_Text_RivalExplainRestOfItems, MSGBOX_DEFAULT
	goto Route110_EventScript_RivalExit
	end

Route110_EventScript_BrendanBattle::
	msgbox Route110_Text_BrendanLetsBattle, MSGBOX_DEFAULT
	switch VAR_STARTER_MON
	case 0, Route110_EventScript_BrendanBattleTreecko
	case 1, Route110_EventScript_BrendanBattleTorchic
	case 2, Route110_EventScript_BrendanBattleMudkip
	end

Route110_EventScript_BrendanBattleTreecko::
	trainerbattle_no_intro TRAINER_BRENDAN_ROUTE_110_TREECKO, Route110_Text_BrendanDefeated
	goto Route110_EventScript_BrendanDefeated
	end

Route110_EventScript_BrendanBattleTorchic::
	trainerbattle_no_intro TRAINER_BRENDAN_ROUTE_110_TORCHIC, Route110_Text_BrendanDefeated
	goto Route110_EventScript_BrendanDefeated
	end

Route110_EventScript_BrendanBattleMudkip::
	trainerbattle_no_intro TRAINER_BRENDAN_ROUTE_110_MUDKIP, Route110_Text_BrendanDefeated
	goto Route110_EventScript_BrendanDefeated
	end

Route110_EventScript_BrendanDefeated::
	msgbox Route110_Text_BrendanTakeThis, MSGBOX_DEFAULT
	call Route110_EventScript_GiveFly
	msgbox Route110_Text_RivalThatsNotAll, MSGBOX_DEFAULT
	call Route110_EventScript_GiveRestOfItems
	msgbox Route110_Text_RivalExplainRestOfItems, MSGBOX_DEFAULT
	goto Route110_EventScript_RivalExit
	end

Route110_EventScript_GiveFly::
	giveitem ITEM_HM_FLY
	msgbox Route110_Text_RivalExplainFlyHM, MSGBOX_DEFAULT
	return

Route110_EventScript_GiveRestOfItems::
	giveitemfast ITEM_DOWSING_MACHINE
	giveitemfast ITEM_TM_FIRE_PUNCH
	giveitemfast ITEM_TM_ICE_PUNCH
	giveitemfast ITEM_TM_THUNDER_PUNCH
	giveitemfast ITEM_TM_FIRE_FANG
	giveitemfast ITEM_TM_ICE_FANG
	giveitemfast ITEM_TM_THUNDER_FANG
	giveitemfast ITEM_TM_PSYCHIC_FANGS
	giveitemfast ITEM_TM_POISON_FANG
	giveitemfast ITEM_GREAT_BALL, 99
	giveitemfast ITEM_ULTRA_BALL, 99
	giveitemfast ITEM_DIVE_BALL, 99
	giveitemfast ITEM_DUSK_BALL, 99
	giveitemfast ITEM_SHINY_STONE, 10
	giveitemfast ITEM_ICE_STONE, 10
	giveitemfast ITEM_BLACK_SLUDGE, 10
	giveitemfast ITEM_TOXIC_ORB, 10
	giveitemfast ITEM_FLAME_ORB, 10
	giveitemfast ITEM_SMOKE_BALL, 10
	giveitemfast ITEM_THICK_CLUB, 10
	giveitemfast ITEM_WEAKNESS_POLICY, 10
	giveitemfast ITEM_GRASSY_SEED, 10
	giveitemfast ITEM_ELECTRIC_SEED, 10
	giveitemfast ITEM_PSYCHIC_SEED, 10
	giveitemfast ITEM_MISTY_SEED, 10
	giveitemfast ITEM_TERRAIN_EXTENDER, 10
	giveitemfast ITEM_SHED_SHELL, 10
	giveitemfast ITEM_LIGHT_CLAY, 10
	playfanfare MUS_OBTAIN_ITEM
	msgbox LittlerootTown_ProfessorBirchsLab_Text_ReceivedSeveralItems, MSGBOX_DEFAULT
	waitfanfare
	setflag FLAG_RIVAL_110
	return

Route110_EventScript_RivalExit::
	closemessage
	call_if_eq VAR_0x8008, 1, Route110_EventScript_MoveRival1
	call_if_eq VAR_0x8008, 2, Route110_EventScript_MoveRival2
	call_if_eq VAR_0x8008, 3, Route110_EventScript_MoveRival3
	setobjectmovementtype LOCALID_RIVAL, MOVEMENT_TYPE_FACE_RIGHT
	setobjectmovementtype LOCALID_RIVAL_ON_BIKE, MOVEMENT_TYPE_FACE_RIGHT
	removeobject LOCALID_RIVAL
	addobject LOCALID_RIVAL_ON_BIKE
	delay 45
	call_if_eq VAR_0x8008, 1, Route110_EventScript_RivalExit1
	call_if_eq VAR_0x8008, 2, Route110_EventScript_RivalExit2
	call_if_eq VAR_0x8008, 3, Route110_EventScript_RivalExit3
	removeobject LOCALID_RIVAL_ON_BIKE
	setvar VAR_ROUTE110_STATE, 1
	delay 30
	playfanfare MUS_LEVEL_UP
	specialvar VAR_0x8006, GetLevelCapForText
	buffernumberstring STR_VAR_3, VAR_0x8006
	msgbox LevelCapIncreasedTo, MSGBOX_DEFAULT
	waitfanfare
	closemessage
	delay 30
	savebgm MUS_DUMMY
	fadedefaultbgm
	releaseall
	end

Route110_EventScript_RivalApproachPlayer1::
	applymovement LOCALID_RIVAL, Route110_Movement_RivalApproachPlayer1
	waitmovement 0
	return

Route110_EventScript_RivalApproachPlayer2::
	applymovement LOCALID_RIVAL, Route110_Movement_RivalApproachPlayer2
	waitmovement 0
	return

Route110_EventScript_RivalApproachPlayer3::
	applymovement LOCALID_RIVAL, Route110_Movement_RivalApproachPlayer3
	waitmovement 0
	return

Route110_EventScript_RivalExit1::
	applymovement LOCALID_RIVAL_ON_BIKE, Route110_Movement_RivalExit1
	waitmovement 0
	return

Route110_EventScript_RivalExit2::
	applymovement LOCALID_RIVAL_ON_BIKE, Route110_Movement_RivalExit2
	waitmovement 0
	return

Route110_EventScript_RivalExit3::
	applymovement LOCALID_RIVAL_ON_BIKE, Route110_Movement_RivalExit3
	waitmovement 0
	return

Route110_EventScript_MoveRival1::
	setobjectxyperm LOCALID_RIVAL_ON_BIKE, 33, 55
	return

Route110_EventScript_MoveRival2::
	setobjectxyperm LOCALID_RIVAL_ON_BIKE, 34, 55
	return

Route110_EventScript_MoveRival3::
	setobjectxyperm LOCALID_RIVAL_ON_BIKE, 35, 55
	return

Route110_Movement_RivalApproachPlayer1:
	walk_down
	walk_left
	walk_in_place_faster_down
	step_end

Route110_Movement_RivalApproachPlayer2:
	walk_down
	step_end

Route110_Movement_RivalApproachPlayer3:
	walk_down
	walk_right
	walk_in_place_faster_down
	step_end

Route110_Movement_RivalExit1:
	walk_fast_up
	walk_fast_up
	walk_fast_up
	walk_fast_up
	walk_fast_up
	walk_fast_up
	walk_fast_up
	step_end

Route110_Movement_RivalExit2:
	walk_fast_up
	walk_fast_up
	walk_fast_up
	walk_fast_up
	walk_fast_up
	walk_fast_up
	walk_fast_up
	walk_fast_down
	step_end

Route110_Movement_RivalExit3:
	walk_fast_up
	walk_fast_up
	walk_fast_up
	walk_fast_up
	walk_fast_up
	walk_fast_up
	walk_fast_up
	step_end

Route110_EventScript_BirchScene1::
	lockall
	setvar VAR_0x8008, 1
	goto Route110_EventScript_BirchScene

Route110_EventScript_BirchScene2::
	lockall
	setvar VAR_0x8008, 2
	goto Route110_EventScript_BirchScene

Route110_EventScript_BirchScene3::
	lockall
	setvar VAR_0x8008, 3
	goto Route110_EventScript_BirchScene

Route110_EventScript_BirchScene4::
	lockall
	setvar VAR_0x8008, 4
	goto Route110_EventScript_BirchScene

Route110_EventScript_BirchScene::
	addobject LOCALID_BIRCH
	applymovement LOCALID_BIRCH, Route110_Movement_BirchEntrance
	waitmovement 0
	playse SE_PIN
	applymovement LOCALID_BIRCH, Common_Movement_ExclamationMark
	waitmovement 0
	applymovement LOCALID_BIRCH, Common_Movement_Delay48
	waitmovement 0
	call_if_eq VAR_0x8008, 1, Route110_EventScript_BirchApproachPlayer1
	call_if_eq VAR_0x8008, 2, Route110_EventScript_BirchApproachPlayer2
	call_if_eq VAR_0x8008, 3, Route110_EventScript_BirchApproachPlayer3
	call_if_eq VAR_0x8008, 4, Route110_EventScript_BirchApproachPlayer4
	msgbox Route110_Text_ImagineSeeingYouHere, MSGBOX_DEFAULT
	closemessage
	delay 20
	applymovement LOCALID_BIRCH, Common_Movement_WalkInPlaceFasterLeft
	waitmovement 0
	delay 10
	applymovement LOCALID_BIRCH, Common_Movement_WalkInPlaceFasterRight
	waitmovement 0
	delay 20
	applymovement LOCALID_BIRCH, Common_Movement_WalkInPlaceFasterDown
	waitmovement 0
	delay 30
	msgbox Route110_Text_HeardYouInstallMatchCall, MSGBOX_DEFAULT
	closemessage
	delay 30
	playfanfare MUS_REGISTER_MATCH_CALL
	msgbox Route110_Text_RegisteredBirchInPokenav, MSGBOX_DEFAULT
	waitfanfare
	closemessage
	delay 30
	setflag FLAG_ENABLE_PROF_BIRCH_MATCH_CALL
	msgbox Route110_Text_KeepAnEyeOutForRival, MSGBOX_DEFAULT
	closemessage
	call_if_eq VAR_0x8008, 1, Route110_EventScript_BirchExit1
	call_if_eq VAR_0x8008, 2, Route110_EventScript_BirchExit2
	call_if_eq VAR_0x8008, 3, Route110_EventScript_BirchExit3
	call_if_eq VAR_0x8008, 4, Route110_EventScript_BirchExit4
	removeobject LOCALID_BIRCH
	setvar VAR_REGISTER_BIRCH_STATE, 2
	releaseall
	end

Route110_EventScript_BirchApproachPlayer1::
	applymovement LOCALID_BIRCH, Route110_Movement_BirchApproachPlayer1
	waitmovement 0
	return

Route110_EventScript_BirchApproachPlayer2::
	applymovement LOCALID_BIRCH, Route110_Movement_BirchApproachPlayer2
	waitmovement 0
	return

Route110_EventScript_BirchApproachPlayer3::
	applymovement LOCALID_BIRCH, Route110_Movement_BirchApproachPlayer3
	waitmovement 0
	return

Route110_EventScript_BirchApproachPlayer4::
	applymovement LOCALID_BIRCH, Route110_Movement_BirchApproachPlayer4
	waitmovement 0
	return

Route110_EventScript_BirchExit1::
	applymovement LOCALID_BIRCH, Route110_Movement_BirchExit1
	waitmovement 0
	return

Route110_EventScript_BirchExit2::
	applymovement LOCALID_BIRCH, Route110_Movement_BirchExit2
	waitmovement 0
	return

Route110_EventScript_BirchExit3::
	applymovement LOCALID_BIRCH, Route110_Movement_BirchExit3
	waitmovement 0
	return

Route110_EventScript_BirchExit4::
	applymovement LOCALID_BIRCH, Route110_Movement_BirchExit4
	waitmovement 0
	return

Route110_Movement_BirchEntrance:
	walk_down
	walk_down
	walk_down
	step_end

Route110_Movement_BirchApproachPlayer1:
	walk_down
	walk_left
	walk_left
	walk_down
	step_end

Route110_Movement_BirchApproachPlayer2:
	walk_down
	walk_left
	walk_down
	step_end

Route110_Movement_BirchApproachPlayer3:
	walk_down
	walk_down
	step_end

Route110_Movement_BirchApproachPlayer4:
	walk_down
	walk_right
	walk_down
	step_end

Route110_Movement_BirchExit1:
	walk_up
	walk_up
	walk_right
	walk_up
	walk_up
	walk_up
	step_end

Route110_Movement_BirchExit2:
	walk_up
	walk_up
	walk_up
	walk_up
	walk_up
	step_end

Route110_Movement_BirchExit3:
	walk_up
	walk_up
	walk_up
	walk_up
	walk_up
	step_end

Route110_Movement_BirchExit4:
	walk_up
	walk_up
	walk_up
	walk_up
	walk_up
	step_end

Route110_EventScript_Wally::
	lockall
	msgbox Route110_Text_WallyRoute110Thinking, MSGBOX_DEFAULT
	closemessage
	playbgm MUS_ENCOUNTER_BRENDAN, TRUE
	applymovement LOCALID_WALLY, Common_Movement_FacePlayer
	waitmovement 0
	applymovement LOCALID_WALLY, Common_Movement_ExclamationMark
	waitmovement 0
	applymovement LOCALID_WALLY, Common_Movement_Delay48
	waitmovement 0
	msgbox Route110_Text_WallyLetsBattle, MSGBOX_DEFAULT
	trainerbattle_no_intro TRAINER_WALLY_ROUTE_110, Route110_Text_WallyDefeated
	goto Route110_EventScript_AfterWallyBattle
	end

Route110_EventScript_AfterWallyBattle::
	msgbox Route110_Text_WallyTimeToHeadBack, MSGBOX_DEFAULT
	goto Route110_EventScript_WallyExit
	end

Route110_EventScript_WallyExit::
	closemessage
	switch VAR_FACING
	case DIR_NORTH, Route110_EventScript_WallyExitFacingNorth
	case DIR_WEST, Route110_EventScript_WallyExitFacingEastOrWest
	case DIR_EAST, Route110_EventScript_WallyExitFacingEastOrWest
	case DIR_SOUTH, Route110_EventScript_WallyExitFacingNorth
	end

Route110_EventScript_WallyExitFacingNorth::
	applymovement LOCALID_WALLY, Route110_Movement_WallyExitFacingNorth
	waitmovement 0
	goto Route110_EventScript_WallyEnd
	end

Route110_EventScript_WallyExitFacingEastOrWest::
	applymovement LOCALID_WALLY, Route110_Movement_WallyExitFacingEastWest
	waitmovement 0
	goto Route110_EventScript_WallyEnd
	end

Route110_EventScript_WallyEnd::
	removeobject LOCALID_WALLY
	savebgm MUS_DUMMY
	fadedefaultbgm
	releaseall
	end

Route110_Movement_WallyExitFacingNorth:
	walk_right
	walk_down
	walk_down
	walk_down
	walk_right
	walk_right
	walk_right
	walk_right
	walk_right
	walk_right
	walk_right
	walk_right
	walk_right
	walk_right
	step_end

Route110_Movement_WallyExitFacingEastWest:
	walk_down
	walk_down
	walk_down
	walk_right
	walk_right
	walk_right
	walk_right
	walk_right
	walk_right
	walk_right
	walk_right
	walk_right
	walk_right
	walk_right
	step_end

Route110_Text_WallyRoute110Thinking:
	.string "小胜：嗯……千里先生让我\n"
	.string "在这里对战变强，\l"
	.string "可是我能行吗？$"

Route110_Text_WallyLetsBattle:
	.string "啊！\p"
	.string "真是的，别这样\n"
	.string "突然靠近我啊，{PLAYER}。\p"
	.string "自从在紫堇市对战过，\n"
	.string "我已经强了很多！\p"
	.string "千里先生，也就是\n"
	.string "你爸爸，还给了我\l"
	.string "一个超级环！\p"
	.string "沙奈朵和我一直在\n"
	.string "拼命努力……\p"
	.string "我在这里犹豫了很久，\n"
	.string "要不要进那间机关屋，\l"
	.string "可还是有点不敢。\p"
	.string "我有个主意，我们就在\n"
	.string "这里对战，赢的人\l"
	.string "先进机关屋！\p"
	.string "好，我来了！$"

Route110_Text_WallyDefeated:
	.string "看来我还是不够强……$"

Route110_Text_WallyTimeToHeadBack:
	.string "好棒的对战，{PLAYER}。\n"
	.string "虽然我又输给了你，\l"
	.string "但我觉得自己在变强。\p"
	.string "你赢了，就先进机关屋吧，\n"
	.string "我去别的地方训练，\l"
	.string "之后再回来。\p"
	.string "留神了，{PLAYER}，我会\n"
	.string "继续训练，总有一天\l"
	.string "会追上你的！$"

Route110_Text_WeCantTalkAboutAquaActivities:
	.string "水舰队的行动……\n"
	.string "这个还不能跟你说。$"

Route110_Text_KickUpARuckus:
	.string "我要赶紧去凯那市\n"
	.string "闹个痛快！$"

Route110_Text_MyFirstJobInAqua:
	.string "这是我加入水舰队后的\n"
	.string "第一份工作。有点怕。$"

Route110_Text_AquaActionsBringSmiles:
	.string "水舰队的行动应该让\n"
	.string "大家都露出笑容！$"

Route110_Text_MayLetsBattle:
	.string "小遥：嗨，{PLAYER}，\n"
	.string "好久不见！\p"
	.string "我在寻找别的宝可梦时，\n"
	.string "自己的宝可梦也变强了。\p"
	.string "那么……\n"
	.string "要不要对战一场？$"

Route110_Text_MayDefeated:
	.string "哎呀！\n"
	.string "你比我想的厉害多了！$"

Route110_Text_MayTakeThis:
	.string "小遥：{PLAYER}，你也在\n"
	.string "拼命训练吧？\p"
	.string "我觉得该给你奖励！\n"
	.string "这些是给你的！\p"
	.string "有些东西能让你的\n"
	.string "旅途更方便。$"

Route110_Text_RivalExplainFlyHM:
	.string "如你所见，{COLOR GREEN}{SHADOW LIGHT_GREEN}\n"
	.string "我刚给了你\l"
	.string "秘传学习器02飞翔。\p"
	.string "现在队伍菜单里，\n"
	.string "能学会飞翔的宝可梦\l"
	.string "都可以学它了，{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}而且\l"
	.string "使用它的徽章要求也解除了！\n"
	.string "不信你就试试！$"

Route110_Text_RivalThatsNotAll::
	.string "我要给你的\n"
	.string "不只这些。\p"
	.string "来，这些也拿着。$"

Route110_Text_RivalExplainRestOfItems::
	.string "我刚给你这些东西：\n"
	.string "探宝器，还有\l"
	.string "火焰拳、冰冻拳、雷电拳、\l"
	.string "火焰牙、冰冻牙、雷电牙、\l"
	.string "精神之牙和毒牙的学习器，\l"
	.string "几种新的精灵球、光之石、\l"
	.string "冰之石、黑色污泥、\l"
	.string "火焰宝珠、剧毒宝珠、\l"
	.string "烟雾球、粗骨头、弱点保险、\l"
	.string "场地延长器、脱壳、\l"
	.string "光之黏土、场地种子。\p"
	.string "呼，我想就是这些了，\n"
	.string "你也许想翻翻背包\l"
	.string "看看现在有什么！\p"
	.string "我该走了，{PLAYER}，\n"
	.string "继续加油！$"


Route110_Text_BrendanLetsBattle:
	.string "佑树：嘿，{PLAYER}。\n"
	.string "原来你在这儿。\l"
	.string "最近怎么样？\p"
	.string "有在培养宝可梦吗？\n"
	.string "我来检查一下。$"

Route110_Text_BrendanDefeated:
	.string "嗯……\n"
	.string "你还挺厉害的。$"

Route110_Text_BrendanTakeThis:
	.string "佑树：{PLAYER}，你不知\n"
	.string "不觉就变强了……\p"
	.string "不错！\n"
	.string "来，这些拿着，\p"
	.string "有些东西能让你的\n"
	.string "旅途更方便。$"

Route110_Text_RideBikeAtFullSpeed:
	.string "在自行车道上全速\n"
	.string "骑车该多爽啊！$"

Route110_Text_HairStreamsBehindMe:
	.string "我这一头乌黑的长发\n"
	.string "在身后飘起来，怎么样？\p"
	.string "我可是为了这个才\n"
	.string "把头发留长的。$"

Route110_Text_YouGotBikeFromRydel:
	.string "哦，嘿，那辆自行车是\n"
	.string "从莱德尔那儿拿的吧！\p"
	.string "哦，太明显了。\n"
	.string "车身上写着呢……\p"
	.string "莱德尔、莱德尔、莱德尔、\n"
	.string "莱德尔、莱德尔、莱德尔、\p"
	.string "莱德尔、莱德尔、莱德尔、\n"
	.string "莱德尔、莱德尔、莱德尔、\p"
	.string "莱德尔、莱德尔、莱德尔、\n"
	.string "莱德尔、莱德尔、莱德尔……\p"
	.string "到处都是这个名字。\p"
	.string "你该骑着它到处跑——\n"
	.string "那是很好的广告！$"

Route110_Text_TwoRoads:
	.string "两条路，一条在上，\n"
	.string "一条在下……\p"
	.string "一条给人，一条给宝可梦。\n"
	.string "也许这样才公平吧。$"

Route110_Text_WalkOnTheLowRoad:
	.string "我没有自行车，\n"
	.string "就在下面的路慢慢走吧。$"

Route110_Text_BikeTechniques:
	.string "学会技巧，骑车会\n"
	.string "更有趣。\p"
	.string "有些地方只有用上\n"
	.string "骑车技巧才能到。$"

Route110_Text_WhichShouldIChoose:
	.string "我该选哪边？\p"
	.string "沿自行车道直奔紫堇市，\n"
	.string "还是走下面的路\l"
	.string "去找宝可梦？$"

Route110_Text_CyclingChallengeResultSummary:
	.string "碰撞次数：\n"
	.string "……{STR_VAR_1}！\p"
	.string "总用时：\n"
	.string "……{STR_VAR_2}！$"

Route110_Text_ChallengeReactionBest:
	.string "太棒了！真是精彩的\n"
	.string "表现！\p"
	.string "你对骑车的热爱发自\n"
	.string "内心。\l"
	.string "你震撼了我的灵魂！$"

Route110_Text_ChallengeReactionGood:
	.string "你的技术很了不起。\p"
	.string "我建议你在避免碰撞的\n"
	.string "同时再加快一点。$"

Route110_Text_ChallengeReactionOk:
	.string "我看你还算\n"
	.string "有待进步。\p"
	.string "不过，希望你\n"
	.string "别忘了骑车的乐趣。$"

Route110_Text_ChallengeReactionBad:
	.string "天哪……你的骑车技术\n"
	.string "近乎可怕。\p"
	.string "你绝对还需要\n"
	.string "多多练习。$"

Route110_Text_ChallengeReactionWorst:
	.string "……我惊呆了……\p"
	.string "你也许不适合做这种\n"
	.string "不幸的骑车运动。\p"
	.string "你该认真考虑把那辆\n"
	.string "自行车还给莱德尔。$"

Route110_Text_RatedForNumberOfCollisions:
	.string "这里是自行车道。\p"
	.string "如果骑高速自行车从紫堇市\n"
	.string "到凯那市，\l"
	.string "就会按碰撞次数\l"
	.string "和总用时来评分。$"

Route110_Text_AlwaysAimHigher:
	.string "不管结果如何，我都\n"
	.string "期待你再次挑战。\l"
	.string "永远要瞄准更高的目标！$"

Route110_Text_AcroBikesDoNotQualify:
	.string "在这条自行车道上，\n"
	.string "骑高速自行车的人\l"
	.string "会按碰撞次数和\l"
	.string "总用时评分。\p"
	.string "技巧自行车不参加评分。\n"
	.string "它转向太容易，不公平。$"

Route110_Text_SlateportCitySign:
	.string "110号道路\n"
	.string "{DOWN_ARROW} 凯那市$"

Route110_Text_CyclingRoadSign:
	.string "海边自行车道$"

Route110_Text_AquaWasHere:
	.string "“水舰队到此一游！”\p"
	.string "有人把这句话涂在\n"
	.string "牌子上，可后来又有人\l"
	.string "把它盖住了。\p"
	.string "现在上面写的是\n"
	.string "“熔岩队最强！”$"

Route110_Text_Route103Sign:
	.string "110号道路\n"
	.string "{LEFT_ARROW} 103号道路$"

Route110_Text_SeasideParkingSign:
	.string "海边停车场$"

Route110_Text_MauvilleCitySign:
	.string "110号道路\n"
	.string "{UP_ARROW} 紫堇市$"

Route110_Text_TrainerTipsPrlzSleep:
	.string "训练家入门\p"
	.string "战斗中选招式时按“R”键，\n"
	.string "就能查看它的信息。$"

Route110_Text_TrainerTipsRegisterItems:
	.string "训练家入门\p"
	.string "宝可梦图鉴里有宝可梦的\n"
	.string "可学招式和\l"
	.string "进化方式的信息。$"

Route110_Text_TrickHouseSign:
	.string "“向右三步，向上两步\n"
	.string "就到神奇的机关屋。”$"

Route110_Text_BestRecord:
	.string "到目前为止的最佳记录……\p"
	.string "碰撞次数：{STR_VAR_1}\p"
	.string "所用时间：{STR_VAR_2}$"

Route110_Text_ThereIsNoRecord:
	.string "到目前为止的最佳记录……\p"
	.string "好像还没人挑战过。\n"
	.string "没有记录……$"

Route110_Text_ImagineSeeingYouHere:
	.string "小田卷博士：哦，{PLAYER}！\n"
	.string "没想到在这儿遇见你！\p"
	.string "我家的{RIVAL}在哪儿呢？$"

Route110_Text_HeardYouInstallMatchCall:
	.string "哦，原来如此！\n"
	.string "你们俩分头行动啊。\l"
	.string "那也好。\p"
	.string "对了，我听说你的导航\n"
	.string "装了宝可梦对话系统。\p"
	.string "那么，我也把你登录到\n"
	.string "我的导航里吧。\p"
	.string "这样就算分开，我也能\n"
	.string "随时评价你的图鉴。\p"
	.string "… … … … … …$"

Route110_Text_RegisteredBirchInPokenav:
	.string "在宝可梦导航里登录了\n"
	.string "小田卷博士。$"

Route110_Text_KeepAnEyeOutForRival:
	.string "小田卷博士：{PLAYER}……\p"
	.string "请帮我留意我家的{RIVAL}。\n"
	.string "… … … … … …\p"
	.string "好了，我该走了。\n"
	.string "再见，{PLAYER}！$"

`

script Route110_Trigger_BlockTrickHouse{
	lockall
	msgbox(TrickHouseMessage)
	waitmessage
	applymovement(OBJ_EVENT_ID_PLAYER, StopPlayer)
	waitmovement(0)
	releaseall
	end
}

text TrickHouseMessage {
	"「机关施工中，\n"
	"之后再来」——戏法大师"

}
