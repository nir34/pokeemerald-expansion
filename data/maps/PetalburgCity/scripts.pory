PetalburgCity_EventScript_GymBoy::
	msgbox PetalburgCity_Text_AreYouRookieTrainer, MSGBOX_NPC
	end

PetalburgCity_EventScript_OldRodFisherman::
	lock
	faceplayer
	goto_if_set FLAG_RECEIVED_OLD_ROD, PetalburgCity_EventScript_HowsFishing
	msgbox PetalburgCity_Text_GettingItchToFish, MSGBOX_YESNO
	goto_if_eq VAR_RESULT, YES, PetalburgCity_EventScript_GiveOldRod
	goto_if_eq VAR_RESULT, NO, PetalburgCity_EventScript_NotGettingItchToFish
	end

PetalburgCity_EventScript_GiveOldRod::
	msgbox PetalburgCity_Text_GiveYouOneOfMyRods, MSGBOX_DEFAULT
	giveitem ITEM_OLD_ROD
	goto_if_eq VAR_RESULT, FALSE, Common_EventScript_ShowBagIsFull
	setflag FLAG_RECEIVED_OLD_ROD
	msgbox PetalburgCity_Text_ThrowInFishingAdvice, MSGBOX_DEFAULT
	release
	end

PetalburgCity_EventScript_NotGettingItchToFish::
	msgbox PetalburgCity_Text_ThatsTooBadThen, MSGBOX_DEFAULT
	release
	end

PetalburgCity_EventScript_HowsFishing::
	message PetalburgCity_Text_HowsYourFishing
	waitmessage
	multichoice 20, 8, MULTI_HOWS_FISHING, TRUE
	goto_if_eq VAR_RESULT, 0, PetalburgCity_EventScript_FishingExcellent
	goto_if_eq VAR_RESULT, 1, PetalburgCity_EventScript_FishingNotSoGood
	end

PetalburgCity_EventScript_FishingExcellent::
	msgbox PetalburgCity_Text_GreatHaulInSomeBigOnes, MSGBOX_DEFAULT
	release
	end

PetalburgCity_EventScript_FishingNotSoGood::
	msgbox PetalburgCity_Text_FishingAdvice, MSGBOX_DEFAULT
	release
	end

PetalburgCity_Text_WhereIsWally:
	.string "我们家小胜去哪了？\p"
	.string "我们很快就要出发\n"
	.string "去绿荫镇了……$"

PetalburgCity_Text_AreYouRookieTrainer:
	.string "嗨呀！你该不会是……\n"
	.string "个新手训练家吧？\p"
	.string "你知道宝可梦训练家\n"
	.string "到新城镇会先做什么吗？\p"
	.string "他们会先看看这个镇上\n"
	.string "有什么样的道馆。$"

PetalburgCity_Text_ThisIsPetalburgGym:
	.string "看吧？这就是橙华市的道馆。$"

PetalburgCity_Text_ThisIsGymSign:
	.string "这是道馆的招牌。\n"
	.string "找道馆的时候就找它。$"

PetalburgCity_Text_WaterReflection:
	.string "水面映出了我的脸。\p"
	.string "那是一张充满希望的\n"
	.string "闪亮笑容……\p"
	.string "也可能是与恐惧搏斗、\n"
	.string "满是阴沉的沉默表情……\p"
	.string "你的脸上映出了什么？$"

PetalburgCity_Text_FullPartyExplanation:
	.string "假设你有六只宝可梦。\n"
	.string "如果又抓到一只……\p"
	.string "它就会被自动传到\n"
	.string "电脑里的盒子中。$"

PetalburgCity_Text_GymSign:
	.string "橙华市宝可梦道馆\n"
	.string "馆主：千里\l"
	.string "“追求力量的男人！”$"

PetalburgCity_Text_CitySign:
	.string "橙华市\n"
	.string "“人与自然交融的地方。”$"

PetalburgCity_Text_WallyHouseSign:
	.string "小胜的家$"

PetalburgCity_Text_AreYouATrainer:
	.string "打扰一下！\p"
	.string "让我猜猜，看你的穿着，\n"
	.string "你是宝可梦训练家吧？$"

PetalburgCity_Text_WellMaybeNot:
	.string "………………\p"
	.string "嗯，也许不是。\n"
	.string "你的衣服不太脏，\l"
	.string "也许你是新手训练家？$"

PetalburgCity_Text_ImLookingForTalentedTrainers:
	.string "我还看不出你的深浅，\n"
	.string "但我有种奇怪的感觉，\l"
	.string "也许有一天你会成为\l"
	.string "我一直在找的那种训练家……\p"
	.string "我本来打算把这些送给\n"
	.string "下一个遇到的强训练家，\l"
	.string "但我觉得你能用得更好。\p"
	.string "来，希望这些能帮你\n"
	.string "更上一层楼。$"

PetalburgCity_Text_ExplainExpShare:
	.string "学习装置能让没有\n"
	.string "参加对战的宝可梦\l"
	.string "也获得经验值。\p"
	.string "你可以用六角宝珠在\n"
	.string "对战前给宝可梦\l"
	.string "加上异常状态。\p"
	.string "为什么要那么做？\n"
	.string "我想你会自己弄明白的。\p"
	.string "占用你太多时间了，\n"
	.string "祝你好运。$"


PetalburgCity_Text_GettingItchToFish:
	.string "这里是很有名的钓点。\n"
	.string "你是不是也想钓了？$"

PetalburgCity_Text_GiveYouOneOfMyRods:
	.string "我听到你的话了，\n"
	.string "我喜欢你这话！\p"
	.string "我送你一根鱼竿。$"

PetalburgCity_Text_ThrowInFishingAdvice:
	.string "另外附赠，我还给你\n"
	.string "讲点钓鱼的窍门！\p"
	.string "首先要面向水面，\n"
	.string "然后使用鱼竿。\p"
	.string "集中精神……\n"
	.string "有东西上钩就拉竿。\p"
	.string "有时一下子就能钓上来，\n"
	.string "但钓大鱼时，\l"
	.string "要把握好拉竿的时机\l"
	.string "才能把它拉上来。$"

PetalburgCity_Text_ThatsTooBadThen:
	.string "哦，是这样吗？\n"
	.string "那太可惜了。$"

PetalburgCity_Text_HowsYourFishing:
	.string "哟！\n"
	.string "钓得怎么样？$"

PetalburgCity_Text_GreatHaulInSomeBigOnes:
	.string "是吗！太好了！\n"
	.string "多钓些大家伙！$"

PetalburgCity_Text_FishingAdvice:
	.string "哦，嘿，别灰心！\n"
	.string "我给你讲讲钓鱼的窍门。\p"
	.string "首先要面向水面，\n"
	.string "然后使用鱼竿。\p"
	.string "集中精神……\n"
	.string "有东西上钩就拉竿。\p"
	.string "有时一下子就能钓上来，\n"
	.string "但钓大鱼时，\l"
	.string "要把握好拉竿的时机\l"
	.string "才能把它拉上来。$"
`
