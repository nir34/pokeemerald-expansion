Route104_Text_BrineyLivesInSeasideCottage:
	.string "那座海边的小屋\n"
	.string "就是布林尼先生的家。\p"
	.string "他从前是个了不起的船员，\n"
	.string "再大的风浪也不怕。$"

Route104_Text_WhatsItLikeAtBottomOfSea:
	.string "大海啊……\p"
	.string "真想看看海底\n"
	.string "是什么样子呢？$"

Route104_Text_ThrowBallAtWeakenedPokemon:
	.string "如果想扔精灵球，\n"
	.string "先把野生宝可梦削弱。\p"
	.string "如果它中毒、灼伤或睡着了，\n"
	.string "就更容易抓到。$"

Route104_Text_OnlyThrowBallAtWildPokemon:
	.string "要是抢别人的宝可梦，\n"
	.string "那就是小偷了。\p"
	.string "精灵球只能对着\n"
	.string "野生宝可梦扔。$"

Route104_Text_ImNotATrainer:
	.string "哦，不，我不是训练家。\p"
	.string "不过没错，训练家对上眼神，\n"
	.string "就是挑战的暗号。\p"
	.string "不想对战的话，\n"
	.string "就别走进他们的视线。$"

Route104_Text_LikeFillingMouthWithSeedsTakeThis:
	.string "我的宝可梦喜欢用这招\n"
	.string "吃种子和树果。\p"
	.string "这个给你，你试试看！$"

Route104_Text_TMsAreOneTimeUse:
	.string "而且你猜怎么着！\n"
	.string "现在学习器\l"
	.string "想用几次就用几次！很棒吧？$"

Route104_Text_DontNeedThisTakeIt:
	.string "这家花店最近\n"
	.string "开始卖树苗了。\p"
	.string "我高兴得买过了头。\p"
	.string "这瓶白色香草我不用了。\n"
	.string "请你收下好吗？$"

Route104_Text_FlowerShopSellingSaplings:
	.string "这家花店最近\n"
	.string "开始卖树苗了。\p"
	.string "我高兴得买过了头。\n"
	.string "该摆在哪里好呢？$"

Route104_Text_MrBrineysCottage:
	.string "布林尼先生的小屋$"

Route104_Text_RouteSignPetalburg:
	.string "104号道路\n"
	.string "{RIGHT_ARROW} 橙华市$"

Route104_Text_RouteSignRustboro:
	.string "104号道路\n"
	.string "{UP_ARROW} 卡那兹市$"

Route104_Text_PrettyPetalFlowShop:
	.string "美丽花店$"

Route104_Text_TrainerTipsDoubleBattles:
	.string "训练家入门\p"
	.string "在队伍菜单里选中宝可梦，\n"
	.string "按“Select”键或“R”键，\l"
	.string "就能更方便地调整顺序。$"

Route104_Text_MayWeShouldRegister:
	.string "小遥：哦，你好，{PLAYER}！\p"
	.string "得文公司给你的宝可梦导航\n"
	.string "升级了宝可梦对话系统吧？\p"
	.string "我们互相登录一下，\n"
	.string "这样随时都能联系。$"

Route104_Text_RegisteredMay:
	.string "{PLAYER}在宝可梦导航里\n"
	.string "登录了小遥。$"

Route104_Text_MayHowsYourPokedex:
	.string "小遥：对了，{PLAYER}，\n"
	.string "你的图鉴进展怎么样？$"

Route104_Text_MayMinesDecentLetsBattle:
	.string "我的看起来还不错。\n"
	.string "那么……\l"
	.string "要不要来对战一场？$"

Route104_Text_MayHaventRaisedPokemon:
	.string "小遥：哦，怎么了？\p"
	.string "你还没怎么抓过\n"
	.string "或培养过宝可梦吗？\p"
	.string "这样可不像个训练家哦！$"

Route104_Text_MayLetsBattle:
	.string "小遥：怎么样？\n"
	.string "要不要在这里对战一场？$"

Route104_Text_MayIntro:
	.string "小遥：你才刚当上训练家，\n"
	.string "{PLAYER}。我可不会输！$"

Route104_Text_MayDefeat:
	.string "哎呀！\n"
	.string "你比我想的厉害多了！$"

Route104_Text_MayPostBattle:
	.string "小遥：看得出你照顾宝可梦\n"
	.string "已经很有心得了。\p"
	.string "不过，不只是让它们对战，\n"
	.string "你也该学学布林尼先生。\p"
	.string "和宝可梦成为朋友\n"
	.string "也很重要哦。$"

Route104_Text_BrendanWeShouldRegister:
	.string "佑树：哦，嘿，{PLAYER}！\p"
	.string "不错嘛，你让得文公司\n"
	.string "给导航装了宝可梦对话系统！\p"
	.string "我们在彼此的导航里\n"
	.string "互相登录一下吧，\l"
	.string "这样就能保持联系了。$"

Route104_Text_RegisteredBrendan:
	.string "{PLAYER}在宝可梦导航里\n"
	.string "登录了佑树。$"

Route104_Text_BrendanHowsYourPokedex:
	.string "佑树：{PLAYER}，\n"
	.string "图鉴怎么样了？\l"
	.string "填上新的页数了吗？$"

Route104_Text_BrendanDoingGreatLetsBattle:
	.string "我嘛，进展很不错！\p"
	.string "想不想用对战检验一下\n"
	.string "我的实力？$"

Route104_Text_BrendanNoConfidence:
	.string "佑树：怎么了？\n"
	.string "对自己的宝可梦没信心吗？$"

Route104_Text_BrendanLetsBattle:
	.string "佑树：怎么了？\n"
	.string "要和我对战一场吗？$"

Route104_Text_BrendanIntro:
	.string "佑树：我知道你才刚当上\n"
	.string "训练家，但我不会放水！$"

Route104_Text_BrendanDefeat:
	.string "嗯……\n"
	.string "你还挺厉害的。$"

Route104_Text_BrendanPostBattle:
	.string "佑树：你操控宝可梦\n"
	.string "已经相当熟练了。\p"
	.string "不过，你知道，不能光是\n"
	.string "让宝可梦去对战。\p"
	.string "像布林尼先生那样，\n"
	.string "和宝可梦成为朋友也很重要。$"

Route104_Text_TakeHexOrb:
	.string "看来你漏掉了这个，\n"
	.string "给你吧。$"
`

script Route104_EventScript_DawnTrigger1{
	setvar(VAR_0x8008, 1)
	goto(Route104_EventScript_DawnScene)
	end
}
	

script Route104_EventScript_DawnTrigger2{
	setvar(VAR_0x8008, 2)
	goto(Route104_EventScript_DawnScene)
	end
}


script Route104_EventScript_DawnScene{
	lockall
	call(Route104_EventScript_PlayDawnMusic)
	applymovement(LOCALID_DAWN, Common_Movement_WalkInPlaceFasterDown)
	waitmovement(0)
	applymovement(LOCALID_DAWN, Common_Movement_ExclamationMark)
	waitmovement(0)
	applymovement(LOCALID_DAWN, Common_Movement_Delay48)
	waitmovement(0)
	delay(30)
	call_if_eq(VAR_0x8008, 1, Route104_EventScript_DawnApproachPlayer1)
	call_if_eq(VAR_0x8008, 2, Route104_EventScript_DawnApproachPlayer2)
	goto(Route104_EventScript_DawnRivalBattle)
	releaseall
	end
}

script Route104_EventScript_DawnRivalBattle{
	msgbox(Dawn_Greeting)
	trainerbattle_no_intro(TRAINER_DAWN_ROUTE_104, Dawn_Defeated)
	goto(Route104_EventScript_DawnDefeated)
	end
}

script Route104_EventScript_DawnDefeated{
	msgbox(Dawn_TakeThis)
	giveitemfast(ITEM_ASPEAR_BERRY, 10)
	giveitemfast(ITEM_PERSIM_BERRY, 10)
	giveitemfast(ITEM_PECHA_BERRY, 10)
	giveitemfast(ITEM_RAWST_BERRY, 10)
	giveitemfast(ITEM_CHERI_BERRY, 10)
	giveitemfast(ITEM_CHESTO_BERRY, 10)
	giveitemfast(ITEM_CHOPLE_BERRY, 10)
	giveitemfast(ITEM_COLBUR_BERRY, 10)
	giveitemfast(ITEM_WACAN_BERRY, 10)
	giveitemfast(ITEM_CHARTI_BERRY, 10)
	giveitemfast(ITEM_CHILAN_BERRY, 10)
	giveitemfast(ITEM_HABAN_BERRY, 10)
	giveitemfast(ITEM_ROSELI_BERRY, 10)
	giveitemfast(ITEM_SHUCA_BERRY, 10)
	giveitemfast(ITEM_BABIRI_BERRY, 10)
	giveitemfast(ITEM_KASIB_BERRY, 10)
	giveitemfast(ITEM_COBA_BERRY, 10)
	giveitemfast(ITEM_KEBIA_BERRY, 10)
	giveitemfast(ITEM_OCCA_BERRY, 10)
	giveitemfast(ITEM_PASSHO_BERRY, 10)
	giveitemfast(ITEM_PAYAPA_BERRY, 10)
	giveitemfast(ITEM_RINDO_BERRY, 10)
	giveitemfast(ITEM_YACHE_BERRY, 10)
	giveitemfast(ITEM_TANGA_BERRY, 10)
	giveitemfast(ITEM_HARBOR_MAIL)
	giveitemfast(ITEM_WISE_GLASSES)
	playfanfare(MUS_OBTAIN_ITEM)
	msgbox(LittlerootTown_ProfessorBirchsLab_Text_ReceivedSeveralItems, MSGBOX_DEFAULT)
	waitfanfare
	msgbox(DawnGoodbye)
	goto(Route104_EventScript_DawnExit)
	end
}
	


script Route104_EventScript_DawnApproachPlayer1{
	applymovement(LOCALID_DAWN, Route104_Movement_DawnApproachPlayer1)
	waitmovement(0)
	return
}
	
	
script Route104_Movement_DawnApproachPlayer1{
	walk_down
	walk_left
	walk_in_place_faster_down
	step_end
}

script Route104_EventScript_DawnApproachPlayer2{
	applymovement(LOCALID_DAWN, Route104_Movement_DawnApproachPlayer2)
	waitmovement(0)
	return
}

script Route104_Movement_DawnApproachPlayer2{
	walk_down
	step_end
}

script Route104_EventScript_DawnExit{
	closemessage
	delay(45)
	call_if_eq(VAR_0x8008, 1, ApplyMovementDawn)
	call_if_eq(VAR_0x8008, 2, ApplyMovementDawn)
	removeobject(LOCALID_DAWN)
	setflag(FLAG_DAWN_104)
	savebgm(MUS_DUMMY)
	fadedefaultbgm
	releaseall
	end
}

script ApplyMovementDawn{
	applymovement(LOCALID_DAWN, Route104_EventScript_DawnExit1)
	waitmovement(0)
	return
}

script Route104_EventScript_DawnExit1{
	walk_up
	walk_up
	walk_up
	walk_up
	walk_up
	walk_up
	walk_up
	step_end
}

script Route104_EventScript_PlayDawnMusic{
	playbgm(MUS_DP_DAWN, TRUE)
	return
}

text Dawn_Greeting{
	"嘿！你该不会\n"
	"就是{PLAYER}吧？\p"
	"真是你？太好了！我叫小光，\n"
	"{RIVAL}的朋友。\p"
	"他刚从这里经过，\n"
	"让我留意一位\l"
	"叫{PLAYER}的训练家。\p"
	"{RIVAL}好像觉得你很有\n"
	"潜力，说我在丰缘地区\l"
	"旅行时该多留意\l"
	"你。\p"
	"不过我想亲自判断，\n"
	"所以来打一场吧！"
}

text Dawn_Defeated{
	"看来{RIVAL}说得没错！"
}


text Dawn_TakeThis{
	"打得真好！{PLAYER}，\n"
	"我一定会再来找你，\l"
	"检验我的实力！\p"
	"对了，我包里有几件多余的\n"
	"道具占地方，\l"
	"给你吧，希望有用。"
}

text DawnGoodbye{
	"我给了你一些能减轻效果绝佳\n"
	"招式伤害的树果，\l"
	"还有一副能提高宝可梦特攻的\l"
	"好用的博识眼镜。\l"
	"记得看看！\p"
	"好，我走了。很高兴见到你，\n"
	"{PLAYER}，我想我们\l"
	"很快会再见！"
}
	