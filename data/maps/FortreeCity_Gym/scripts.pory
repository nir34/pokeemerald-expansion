raw `
FortreeCity_Gym_MapScripts::
	map_script MAP_SCRIPT_ON_TRANSITION, FortreeCity_Gym_OnTransition
	map_script MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE, FortreeCity_Gym_OnWarp
	.byte 0

FortreeCity_Gym_OnTransition:
	special RotatingGate_InitPuzzle
	setflag FLAG_TEMP_HIDE_FOLLOWER @ Hide follower bc of rotating gates
	end

FortreeCity_Gym_OnWarp:
	map_script_2 VAR_TEMP_0, VAR_TEMP_0, FortreeCity_Gym_EventScript_InitRotatingGates
	.2byte 0

@ NOTE: This rotating gate puzzle makes use of VAR_TEMP_0 - VAR_TEMP_3
FortreeCity_Gym_EventScript_InitRotatingGates::
	special RotatingGate_InitPuzzleAndGraphics
	end

FortreeCity_Gym_EventScript_Winona::
	trainerbattle_single TRAINER_WINONA_1, FortreeCity_Gym_Text_WinonaIntro, FortreeCity_Gym_Text_WinonaDefeat, FortreeCity_Gym_EventScript_WinonaDefeated, NO_MUSIC
	specialvar VAR_RESULT, ShouldTryRematchBattle
	goto_if_eq VAR_RESULT, TRUE, FortreeCity_Gym_EventScript_WinonaRematch
	goto_if_unset FLAG_RECEIVED_TM_BRAVE_BIRD, FortreeCity_Gym_EventScript_GiveAerialAce2
	msgbox FortreeCity_Gym_Text_WinonaPostBattle, MSGBOX_DEFAULT
	release
	end

FortreeCity_Gym_EventScript_WinonaDefeated::
	message FortreeCity_Gym_Text_ReceivedFeatherBadge
	waitmessage
	call Common_EventScript_PlayGymBadgeFanfare
	msgbox FortreeCity_Gym_Text_ExplainFeatherBadgeTakeThis, MSGBOX_DEFAULT
	setflag FLAG_DEFEATED_FORTREE_GYM
	setflag FLAG_BADGE06_GET
	setflag FLAG_HIDE_MAUVILLE_GYM_WATTSON
	clearflag FLAG_HIDE_MAUVILLE_CITY_WATTSON
	setvar VAR_0x8008, 6
	call Common_EventScript_SetGymTrainers
	call FortreeCity_Gym_EventScript_GiveAerialAce
	closemessage
	delay 30
	playfanfare MUS_REGISTER_MATCH_CALL
	msgbox FortreeCity_Gym_Text_RegisteredWinona, MSGBOX_DEFAULT
	waitfanfare
	closemessage
	delay 30
	setvar VAR_0x8004, 1  @ vertical pan
	setvar VAR_0x8005, 1  @ horizontal pan
	setvar VAR_0x8006, 8  @ num shakes
	setvar VAR_0x8007, 5  @ shake delay
	special ShakeCamera
	waitstate
	msgbox FortreeCity_Gym_Text_WhatOnEarth, MSGBOX_DEFAULT
	closemessage
	setflag FLAG_ENABLE_WINONA_MATCH_CALL
	setvar VAR_SCOTT_FORTREE_CALL_STEP_COUNTER, 0
	setflag FLAG_SCOTT_CALL_FORTREE_GYM
	delay 30
	playfanfare MUS_LEVEL_UP
	specialvar VAR_0x8006, GetLevelCapForText
	buffernumberstring STR_VAR_3, VAR_0x8006
	msgbox LevelCapIncreasedTo, MSGBOX_DEFAULT
	waitfanfare
	closemessage
	delay 30
	release
	end

FortreeCity_Gym_EventScript_GiveAerialAce2::
	giveitem ITEM_TM_BRAVE_BIRD
	giveitem ITEM_TM_ACROBATICS
	giveitem ITEM_TM_HURRICANE
	giveitem ITEM_TM_TAILWIND
	giveitem ITEM_ALTARIANITE
	goto_if_eq VAR_RESULT, FALSE, Common_EventScript_ShowBagIsFull
	msgbox FortreeCity_Gym_Text_ExplainAerialAce, MSGBOX_DEFAULT
	setflag FLAG_RECEIVED_TM_BRAVE_BIRD
	release
	end

FortreeCity_Gym_EventScript_GiveAerialAce::
	giveitem ITEM_TM_BRAVE_BIRD
	giveitem ITEM_TM_ACROBATICS
	giveitem ITEM_TM_HURRICANE
	giveitem ITEM_TM_TAILWIND
	giveitem ITEM_ALTARIANITE
	goto_if_eq VAR_RESULT, FALSE, Common_EventScript_BagIsFull
	msgbox FortreeCity_Gym_Text_ExplainAerialAce, MSGBOX_DEFAULT
	setflag FLAG_RECEIVED_TM_BRAVE_BIRD
	return

FortreeCity_Gym_EventScript_WinonaRematch::
	trainerbattle_rematch_double TRAINER_WINONA_1, FortreeCity_Gym_Text_WinonaPreRematch, FortreeCity_Gym_Text_WinonaRematchDefeat, FortreeCity_Gym_Text_WinonaRematchNeedTwoMons
	msgbox FortreeCity_Gym_Text_WinonaPostRematch, MSGBOX_AUTOCLOSE
	end

FortreeCity_Gym_EventScript_Jared::
	trainerbattle_single TRAINER_JARED, FortreeCity_Gym_Text_JaredIntro, FortreeCity_Gym_Text_JaredDefeat
	msgbox FortreeCity_Gym_Text_JaredPostBattle, MSGBOX_AUTOCLOSE
	end

FortreeCity_Gym_EventScript_Edwardo::
	trainerbattle_single TRAINER_EDWARDO, FortreeCity_Gym_Text_EdwardoIntro, FortreeCity_Gym_Text_EdwardoDefeat
	msgbox FortreeCity_Gym_Text_EdwardoPostBattle, MSGBOX_AUTOCLOSE
	end

FortreeCity_Gym_EventScript_Flint::
	trainerbattle_single TRAINER_FLINT, FortreeCity_Gym_Text_FlintIntro, FortreeCity_Gym_Text_FlintDefeat
	msgbox FortreeCity_Gym_Text_FlintPostBattle, MSGBOX_AUTOCLOSE
	end

FortreeCity_Gym_EventScript_Ashley::
	trainerbattle_single TRAINER_ASHLEY, FortreeCity_Gym_Text_AshleyIntro, FortreeCity_Gym_Text_AshleyDefeat
	msgbox FortreeCity_Gym_Text_AshleyPostBattle, MSGBOX_AUTOCLOSE
	end

FortreeCity_Gym_EventScript_Humberto::
	trainerbattle_single TRAINER_HUMBERTO, FortreeCity_Gym_Text_HumbertoIntro, FortreeCity_Gym_Text_HumbertoDefeat
	msgbox FortreeCity_Gym_Text_HumbertoPostBattle, MSGBOX_AUTOCLOSE
	end

FortreeCity_Gym_EventScript_Darius::
	trainerbattle_single TRAINER_DARIUS, FortreeCity_Gym_Text_DariusIntro, FortreeCity_Gym_Text_DariusDefeat
	msgbox FortreeCity_Gym_Text_DariusPostBattle, MSGBOX_AUTOCLOSE
	end

FortreeCity_Gym_EventScript_GymGuide::
	lock
	faceplayer
	goto_if_set FLAG_DEFEATED_FORTREE_GYM, FortreeCity_Gym_EventScript_GymGuidePostVictory
	msgbox FortreeCity_Gym_Text_GymGuideAdvice, MSGBOX_DEFAULT
	release
	end

FortreeCity_Gym_EventScript_GymGuidePostVictory::
	msgbox FortreeCity_Gym_Text_GymGuidePostVictory, MSGBOX_DEFAULT
	release
	end

FortreeCity_Gym_EventScript_LeftGymStatue::
	lockall
	goto_if_set FLAG_BADGE06_GET, FortreeCity_Gym_EventScript_GymStatueCertified
	goto FortreeCity_Gym_EventScript_GymStatue
	end

FortreeCity_Gym_EventScript_RightGymStatue::
	lockall
	goto_if_set FLAG_BADGE06_GET, FortreeCity_Gym_EventScript_GymStatueCertified
	goto FortreeCity_Gym_EventScript_GymStatue
	end

FortreeCity_Gym_EventScript_GymStatueCertified::
	msgbox FortreeCity_Gym_Text_GymStatueCertified, MSGBOX_DEFAULT
	releaseall
	end

FortreeCity_Gym_EventScript_GymStatue::
	msgbox FortreeCity_Gym_Text_GymStatue, MSGBOX_DEFAULT
	releaseall
	end

FortreeCity_Gym_EventScript_Altaria::
	lock
	faceplayer
	waitse
	playmoncry SPECIES_ALTARIA, CRY_MODE_NORMAL
	msgbox FortreeCity_Gym_Text_Altaria, MSGBOX_DEFAULT
	waitmoncry
	release
	end

FortreeCity_Gym_Text_GymGuideAdvice:
	.string "哟，冠军候补{PLAYER}，\n"
	.string "近况如何？\p"
	.string "茵郁道馆的馆主娜琪是\n"
	.string "飞行属性宝可梦的高手。\p"
	.string "她就在道馆最里面，\n"
	.string "旋转门的后面。\p"
	.string "她在等着想要展翅\n"
	.string "高飞的新挑战者！\p"
	.string "好，去吧！$"

FortreeCity_Gym_Text_GymGuidePostVictory:
	.string "你做到了！\n"
	.string "你成功起飞了！$"

FortreeCity_Gym_Text_JaredIntro:
	.string "好好看看鸟宝可梦\n"
	.string "优雅的战斗方式吧！$"

FortreeCity_Gym_Text_JaredDefeat:
	.string "你……\n"
	.string "你很强……$"

FortreeCity_Gym_Text_JaredPostBattle:
	.string "训练家必须机灵，才能\n"
	.string "应对突发的变故。\p"
	.string "你有这份头脑走到\n"
	.string "馆主面前吗？$"

FortreeCity_Gym_Text_EdwardoIntro:
	.string "热爱鸟宝可梦的人都\n"
	.string "以加入这个道馆为荣。\p"
	.string "身为茵郁道馆的一员，\n"
	.string "我可不能输！$"

FortreeCity_Gym_Text_EdwardoDefeat:
	.string "这份重担\n"
	.string "我实在扛不住……$"

FortreeCity_Gym_Text_EdwardoPostBattle:
	.string "世界很大，厉害的\n"
	.string "训练家数不清。\p"
	.string "我要继续训练，\n"
	.string "让自己更强。$"

FortreeCity_Gym_Text_FlintIntro:
	.string "不用我们的馆主娜琪\n"
	.string "出手对付你！\p"
	.string "我完全足够\n"
	.string "当你的对手！$"

FortreeCity_Gym_Text_FlintDefeat:
	.string "娜琪，我……\n"
	.string "我输了！$"

FortreeCity_Gym_Text_FlintPostBattle:
	.string "娜琪又可爱又强。\n"
	.string "她是完美的馆主！\p"
	.string "脸红……$"

FortreeCity_Gym_Text_AshleyIntro:
	.string "娜琪亲手教过我！\n"
	.string "你不会轻易赢我的！$"

FortreeCity_Gym_Text_AshleyDefeat:
	.string "我被打败了……$"

FortreeCity_Gym_Text_AshleyPostBattle:
	.string "多亏了娜琪，茵郁的\n"
	.string "人们才能安心生活。$"

FortreeCity_Gym_Text_HumbertoIntro:
	.string "娜琪战斗时，脸上会\n"
	.string "闪着美丽的认真……\p"
	.string "我才不让你看到\n"
	.string "那么美的样子！$"

FortreeCity_Gym_Text_HumbertoDefeat:
	.string "呜！\n"
	.string "我拦不住你。$"

FortreeCity_Gym_Text_HumbertoPostBattle:
	.string "你最好小心点！\n"
	.string "别盯着娜琪看走神，\l"
	.string "否则会栽个大跟头！$"

FortreeCity_Gym_Text_DariusIntro:
	.string "你最好知道，飞行属性\n"
	.string "宝可梦有各种各样的。\p"
	.string "你知道的吧？$"

FortreeCity_Gym_Text_DariusDefeat:
	.string "看来你挺懂行！$"

FortreeCity_Gym_Text_DariusPostBattle:
	.string "行吧，你确实赢了我。\n"
	.string "不过你最好小心点！\l"
	.string "我们的馆主娜琪的\l"
	.string "宝可梦可不好惹。$"

FortreeCity_Gym_Text_WinonaIntro:
	.string "我是娜琪。我是茵郁\n"
	.string "宝可梦道馆的馆主。\p"
	.string "我已与鸟宝可梦\n"
	.string "合而为一，翱翔天际……\p"
	.string "可是，我被岩石、冰、\n"
	.string "电属性的招式打倒过\l"
	.string "太多次了。\p"
	.string "我只好把自己优雅的\n"
	.string "战法调整得\l"
	.string "更加优美！\p"
	.string "请欣赏我和宝可梦的\n"
	.string "优美舞步！$"

FortreeCity_Gym_Text_WinonaDefeat:
	.string "我还从未见过比\n"
	.string "我更优雅地指挥\l"
	.string "宝可梦的训练家……\p"
	.string "为了认可你的实力，\n"
	.string "我把这枚徽章送给你。$"

FortreeCity_Gym_Text_ReceivedFeatherBadge:
	.string "从娜琪那里\n"
	.string "得到了羽翼徽章。$"

FortreeCity_Gym_Text_ExplainFeatherBadgeTakeThis:
	.string "还有这些……\n"
	.string "这是送你的礼物。$"

FortreeCity_Gym_Text_ExplainAerialAce:
	.string "这些是我所知最强的\n"
	.string "飞行属性招式之一，\l"
	.string "还有我最喜欢的超级石。\p"
	.string "请善用它们，\n"
	.string "威力非常惊人。\p"
	.string "… … … … … …$"

FortreeCity_Gym_Text_RegisteredWinona:
	.string "已把馆主娜琪\n"
	.string "登记进宝可梦导航。$"

FortreeCity_Gym_Text_WhatOnEarth:
	.string "刚、刚才那是什么？\p"
	.string "… … … … … …\p"
	.string "{PLAYER}，回去的时候\n"
	.string "要小心点。\p"
	.string "我不确定那场地震是\n"
	.string "怎么回事，不过\l"
	.string "也许有人会打电话\l"
	.string "告诉你发生了什么。$"

FortreeCity_Gym_Text_WinonaPostBattle:
	.string "虽然我输给了你，\n"
	.string "我还是会忠于我的宝可梦。$"

FortreeCity_Gym_Text_GymStatue:
	.string "茵郁市宝可梦道馆$"

FortreeCity_Gym_Text_GymStatueCertified:
	.string "茵郁市宝可梦道馆\p"
	.string "娜琪认定的训练家：\n"
	.string "{PLAYER}$"

FortreeCity_Gym_Text_WinonaPreRematch:
	.string "娜琪：我们人类永远\n"
	.string "逃不过地面的引力。\p"
	.string "但只要追求卓越，\n"
	.string "我们就有力量高飞！\p"
	.string "你已登顶，成为\n"
	.string "现任冠军。\p"
	.string "请让我看看你\n"
	.string "完全展开的实力！$"

FortreeCity_Gym_Text_WinonaRematchDefeat:
	.string "我又一次没能达到\n"
	.string "你的高度……$"

FortreeCity_Gym_Text_WinonaPostRematch:
	.string "娜琪：虽然我输了，\n"
	.string "我心中的翅膀不会折断。\p"
	.string "我还能一次次\n"
	.string "重新起飞。\p"
	.string "我确信！$"

FortreeCity_Gym_Text_WinonaRematchNeedTwoMons:
	.string "娜琪：我们人类永远\n"
	.string "逃不过地面的引力。\p"
	.string "但只要追求卓越，\n"
	.string "我们就有力量高飞！\p"
	.string "你已登顶，成为\n"
	.string "现任冠军。\p"
	.string "请让我看看你\n"
	.string "完全展开的实力！\p"
	.string "哦，不对……你身上\n"
	.string "只有一只宝可梦？\p"
	.string "请至少带两只\n"
	.string "宝可梦再来。$"

FortreeCity_Gym_Text_Altaria:
	.string "七夕青鸟：咿咿咿呀！$"
`
